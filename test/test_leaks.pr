import common

def #test test_leaks {
    let file: Str = common::tmpf + "/empty.pr"
    let fh = open(file, "w")
    fprint(fh, """cstd::printf("Hello World!\\n".value)\n""")
    fh.close()

    assert system("valgrind --leak-check=full --error-exitcode=1 " + query_compiler() + " " + file + " --no-incremental") == 0
}
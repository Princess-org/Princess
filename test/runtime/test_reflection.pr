import reflection

type Struct4 = struct { a: int; b: float }
type Interface = interface {
    def function(a: int) -> int
}

def function(s: &Struct4, a: int) -> int {
    return s.a + a
}

type &Struct4 implements &Interface

def test_reflection {
    let T = int32

    assert T.type == reflection::WordT
    let WT = T !reflection::WordT
    assert WT.name == "int32"
    assert WT.signed == true
    assert WT.size == 4
    assert WT.align == 4

    let S = Struct4
    assert S.type == reflection::StructT
    let SS = S !reflection::StructT
    assert SS.members.size == 2
    assert SS.members(0).tpe == int
    assert SS.members(0).name == "a"
    assert SS.members(1).tpe == float
    assert SS.members(1).name == "b"

    let I = Interface
    assert I.type == reflection::InterfaceT
    let II = I !reflection::InterfaceT
    assert II.functions.size == 1
    let smember = II.functions(0)
    assert smember.name == "function"
    assert smember.arguments.size == 1
    assert smember.arguments(0) == int
    assert smember.returns.size == 1
    assert smember.returns(0) == int

    assert reflection::implements(type &Struct4, type &Interface)
}
test_reflection
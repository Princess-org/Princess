type Serialize = struct {
    module: weak &toolchain::Module
    types: &Map(&typechecking::Type, int64)
    dependencies: &Set(scope::Ident)
}

const MAGIC = "PRNCSVI"

let TYPE_MOD: byte = -1
let TYPE_REF: byte = -2
let VARARGS: byte = -3
let NO_TYPE: byte = -4

let K_TYPE: byte = 0
let K_NAME: byte = 1
let K_GENERIC: byte = 2
let K_NONE: byte = 3


type TypeHash = struct {
    is_alias: bool
    hash: int64
}

type Serialize = struct {
    module: weak &toolchain::Module
    dependencies: &Map(Str, scope::Ident)
    types: &Map(typechecking::TypeId, TypeHash)
}

const MAGIC = "PRNCSVI"

let TYPE_MOD: byte = -1
let TYPE_REF: byte = -2
let VARARGS: byte = -3
let NO_TYPE: byte = -4

let K_TYPE: byte = 0
let K_NAME: byte = 1
let K_GENERIC: byte = 2
let K_NONE: byte = 3

// We write hashes so that the type ids are consistent across compilations and across modules.
// This is needed for incremental compilation to work correctly.
def write_type(fp: File, tpe: typechecking::TypeId, state: &Serialize, is_alias: bool = false) {
    if state.types.contains(tpe) {
        let t = state.types(tpe)
        fp.write(*t.hash)
        return
    }

    let res = tpe.resolve()
    if not res {
        let zero: uint64 = 0
        fp.write(*zero)
        return
    }
    let hash = tpe.stable_hash()
    fp.write(*hash)

    state.types(tpe) = [ is_alias = is_alias, hash = hash ] !TypeHash
}

def serialize_type(fp: File, tpe: &typechecking::Type, state: &Serialize, is_alias: bool = false) {
    if not tpe {
        fp.write(*NO_TYPE)
        return
    } else if is_alias {
        fp.write(*TYPE_REF)
        fp.write(*tpe.stable_hash())
        return
    }

    typechecking::get_builtin_destructor(tpe)
    typechecking::get_builtin_constructor(tpe)

    let kind = tpe.kind !byte
    fp.write(*kind)
    fp.write_str(tpe.name)
    fp.write_str(tpe.type_name)
    fp.write_str(tpe.defmodule.module !String if tpe.defmodule else null)
    fp.write(*tpe._hash)

    var has_builtin_destructor = tpe.meta.has_builtin_destructor == typechecking::Ternary::TRUE
    var has_constructor = tpe.meta.has_constructor == typechecking::Ternary::TRUE
    fp.write(*has_builtin_destructor)
    fp.write(*has_constructor)

    let has_tc_tpe = tpe.tc_tpe !bool
    fp.write(*has_tc_tpe)
    if has_tc_tpe {
        write_type(fp, tpe.tc_tpe, state)
    }

    if tpe.tc_args {
        fp.write(*tpe.tc_args.length)
        for var i in 0..tpe.tc_args.length {
            write_type(fp, tpe.tc_args(i), state)
        }
    } else {
        let empty: int64 = -1
        fp.write(*empty)
    }

    fp.write(*tpe.size)
    fp.write(*tpe.align)

    if tpe.kind == typechecking::TypeKind::WORD {
        fp.write(*tpe.unsig)
    } else if tpe.kind == typechecking::TypeKind::FLOAT or
        tpe.kind == typechecking::TypeKind::OPAQUE {
        // Snip
    } else if tpe.kind == typechecking::TypeKind::STATIC_ARRAY {
        let len = tpe.length
        fp.write(*len)
        write_type(fp, tpe.tpe, state)
    } else if typechecking::is_box(tpe) or tpe.kind == typechecking::TypeKind::TYPE {
        if tpe.kind != typechecking::TypeKind::TYPE {
            let kw = tpe.kw !byte
            fp.write(*kw)
        }
        write_type(fp, tpe._tpe, state)
    } else if typechecking::is_struct(tpe) {
        let sz = tpe.fields.length()
        fp.write(*tpe.is_literal)
        fp.write(*sz)
        for var i in 0..sz {
            let field = tpe.fields(i)
            write_type(fp, field.tpe, state)
            fp.write(*field.properties.is_bitfield)
            fp.write(*field.properties.bit_size)
            fp.write_str(field.name)
        }
    } else if tpe.kind == typechecking::TypeKind::FUNCTION or
        tpe.kind == typechecking::TypeKind::CLOSURE {
        fp.write(*tpe.parameter_t.length)
        for var i in 0..tpe.parameter_t.length {
            let np = tpe.parameter_t(i)
            write_type(fp, np.tpe, state)
            fp.write_str(np.name)
            fp.write(*np.varargs)
        }
        fp.write(*tpe.return_t.length)
        for var i in 0..tpe.return_t.length {
            write_type(fp, tpe.return_t(i), state)
        }
    } else if tpe.kind == typechecking::TypeKind::INTERFACE {
        fp.write(*tpe.members.length)
        for var i in 0..tpe.members.length {
            let member = tpe.members(i)
            fp.write_str(member.name)
            fp.write(*member.parameter_t.length)
            for var i in 0..member.parameter_t.length {
                let np = member.parameter_t(i)
                write_type(fp, np.tpe, state)
                fp.write_str(np.name)
            }
            fp.write(*member.return_t.length)
            for var i in 0..member.return_t.length {
                write_type(fp, member.return_t(i), state)
            }
        }
    } else if tpe.kind == typechecking::TypeKind::ENUM {
        write_type(fp, tpe.tpe, state)

        let scpe = tpe.scope
        let ekeys = scpe.fields.keys()
        let sz = ekeys.size
        fp.write(*sz)
        for var i in 0..sz {
            let key = ekeys(i)
            let value = scpe.fields(key)
            assert value.modifier == parser::VarDecl::CONST
            fp.write_str(value.name)
            fp.write(*value.value.i)
        }
    } else if tpe.kind == typechecking::TypeKind::TYPE_CONSTRUCTOR {
        fp.write(*tpe.parameter_t.length)
        for var i in 0..tpe.parameter_t.length {
            let np = tpe.parameter_t(i)
            fp.write_str(np.name)
        }
        let loc = tpe.tc_node.loc
        fp.write(*loc.line)
        fp.write(*loc.column)
        fp.write(*loc.end_line)
        fp.write(*loc.end_column)
    } else if tpe.kind == typechecking::TypeKind::CHAR or
        tpe.kind == typechecking::TypeKind::BOOL {
        // SNIP
    } else if tpe.kind == typechecking::TypeKind::TUPLE or
        tpe.kind == typechecking::TypeKind::TUNION {
        fp.write(*tpe.return_t.length)
        for var e in tpe.return_t {
            write_type(fp, e, state)
        }
    } else {
        error(tpe.kind, "\n")
        assert
    }
}

def serialize_function(fp: File, value: &scope::Value, state: &Serialize) {
    let fdef = value.fdef
    let hash = value.ident._hash
    let contents_hash = value.ident._contents_hash
    let share = value.share !byte
    fp.write(*hash)
    fp.write(*contents_hash)
    fp.write(*share)
    fp.write(*value.extern)
    fp.write(*value.imported)
    fp.write(*value.polymorph)
    fp.write(*value.impl)
    fp.write(*value.is_dyn_dispatch)
    // TODO Get Function object with dllexport and dllimport
    fp.write_str(value.name)

    typechecking::resolve_fdef(*fdef)
    fp.write_str(fdef.name)

    if not value.is_generated and not value.polymorph {
        add_dependencies(value.dependencies, state)
    }

    fp.write(*fdef.parameter_t.length)
    for var i in 0..fdef.parameter_t.length {
        let np = fdef.parameter_t(i)
        var kw = np.kw !byte
        fp.write_str(np.name)
        fp.write(*kw)
        fp.write(*np.varargs)
        serialize_typeref(fp, np.tpe, state)
        let has_value = np.value !bool
        fp.write(*has_value)
        if has_value {
            serialize_value(fp, np.value, state)
        }
    }
    fp.write(*fdef.return_t.length)
    for var i in 0..fdef.return_t.length {
        let tpe = fdef.return_t(i)
        serialize_typeref(fp, tpe, state)
    }

    // TODO This is because is_polymorph (incorrectly) returns true for TYPE_DEF
    // This is needed in some other places, hence the workaround
    let polymorph = typechecking::is_polymorph(fdef) and value.node
    fp.write(*polymorph)
    if polymorph {
        /*let type_defs = value.local_type_defs.type_defs
        let sz = type_defs.size
        fp.write(*sz)
        for var name in @type_defs.keys() {
            let id = type_defs(name)
            fp.write_str(name)
            fp.write(*id)
        }*/

        let loc = value.node.loc
        fp.write(*loc.line)
        fp.write(*loc.column)
        fp.write(*loc.end_line)
        fp.write(*loc.end_column)
    }

    // Function code
    let function = value.function
    var block: &compiler::Block
    if function { block = function.block }

    let pos = fp.tell()
    let sze: size_t = 0
    fp.write(*sze)
    
    serialize_block(fp, block, state)
    
    let zero: size_t = 0
    if function and function.metadata {
        fp.write(*function.metadata.size)
        for var key in @function.metadata.keys() {
            let value = function.metadata(key)
            fp.write_str(key)
            serialize_value(fp, value, state)
        }
    } else { fp.write(*zero) }

    if function and function.constants {
        fp.write(*function.constants.size)
        for var key in @function.constants.keys() {
            let global = function.constants(key)
            fp.write_str(key)
            write_type(fp, global.tpe, state)
            serialize_value(fp, global.value, state)
        }
    } else { fp.write(*zero) }

    let end_pos = fp.tell()
    fp.seek(pos, std::SEEK_SET)
    let dif = end_pos - pos - (size_of size_t)
    fp.write(*dif)
    fp.seek(end_pos, std::SEEK_SET)
}

def serialize_typeref(fp: File, typeref: &typechecking::TypeRef, state: &Serialize) {
    if not typeref {
        fp.write(*K_NONE)
        return
    }
    var kind = K_GENERIC
    if typeref.tpe {
        kind = K_TYPE
    } else if typeref.name {
        kind = K_NAME
    }
    fp.write(*kind)

    if kind == K_TYPE {
        write_type(fp, typeref.tpe, state)
        return
    } else if kind == K_NAME {
        fp.write_str(typeref.name)
        return
    }

    var generic = typeref.pattern
    fp.write(*generic.kind)
    fp.write(*generic.length)
    fp.write(*generic.kw)
    fp.write_str(generic.name)

    var has_generic = generic.tpe != null
    fp.write(*has_generic)
    if has_generic {
        serialize_typeref(fp, generic.tpe, state)
    }

    let zero: size_t = -1
    if generic.parameter_t {
        fp.write(*generic.parameter_t.length)
        for var g in generic.parameter_t {
            fp.write_str(g.name)
            serialize_typeref(fp, g.tpe, state)
        }
    } else {
        fp.write(*zero)
    }

    if generic.return_t {
        fp.write(*generic.return_t.length)
        for var g in generic.return_t {
            serialize_typeref(fp, g, state)
        }
    } else {
        fp.write(*zero)
    }

    // TODO We currently don't support struct and union patterns
    assert generic.kind != typechecking::TypeKind::STRUCT and
        generic.kind != typechecking::TypeKind::UNION
}

def deserialize_node(deserialize: &Deserialize, loc: parser::SourceLoc) -> &parser::Node {
    let tokens = lexer::lex(deserialize.module.text, loc.line, loc.column, loc.end_line, loc.end_column)
    let parse_state = parser::make_state(deserialize.module.filename, deserialize.module.display_name, deserialize.module.module, deserialize.module.lines, tokens)
    let node = parser::parse_statement(parse_state)
    delete(tokens)

    deserialize.nodes.push(node)
    return node
}

def deserialize_type_node(deserialize: &Deserialize, loc: parser::SourceLoc) -> &parser::Node {
    let tokens = lexer::lex(deserialize.module.text, loc.line, loc.column, loc.end_line, loc.end_column)
    let parse_state = parser::make_state(deserialize.module.filename, deserialize.module.display_name, deserialize.module.module, deserialize.module.lines, tokens)
    let node = parser::parse_type(parse_state)
    delete(tokens)

    deserialize.nodes.push(node)
    return node
}

def read_type(fp: File, lookup: bool = false) -> typechecking::TypeId {
    var id: int64
    fp.read(*id)
    if lookup and id {
        id = deserialized_types(id).id
    }
    return id !typechecking::TypeId
}

def deserialize_type(fp: File, state: &Deserialize) -> &typechecking::Type {
    var kind: byte
    fp.read(*kind)
    if kind == NO_TYPE { return null }
    else if kind == TYPE_REF {
        var _hash: int64
        fp.read(*_hash)
        // We abuse UNSET as a type reference, these get looked up later
        return [ kind = typechecking::TypeKind::UNSET, _hash = _hash ] !&typechecking::Type
    }

    var tpekind = kind !typechecking::TypeKind
    var name = fp.read_str()
    var type_name = fp.read_str()
    var defmodule_str = fp.read_str()
    var _hash: int64
    fp.read(*_hash)

    //print("Deserializing type ", type_name, " (", _hash, ")\n")

    var has_builtin_destructor: bool
    fp.read(*has_builtin_destructor)
    var has_constructor: bool
    fp.read(*has_constructor)

    var defmodule: &toolchain::Module
    if defmodule_str {
        let path = toolchain::find_module_file(defmodule_str, state.module)
        defmodule = toolchain::create_module_if_absent(path, defmodule_str)
    }

    var tc_tpe: typechecking::TypeId
    var has_tc_tpe: bool
    fp.read(*has_tc_tpe)
    if has_tc_tpe {
        tc_tpe = read_type(fp)
    }

    var sz: int64
    var tc_args: &Vector(typechecking::TypeId)
    fp.read(*sz)
    if sz >= 0 {
        tc_args = vector::make(typechecking::TypeId)
        for var i in 0..sz {
            tc_args.push(read_type(fp))
        }
    }

    var size: uint64
    fp.read(*size)
    var align: uint64
    fp.read(*align)

    var tpe = [
        kind = tpekind,
        id = 0,
        name = name,
        type_name = type_name,
        _hash = _hash,
        defmodule = defmodule,
        size = size,
        align = align,
        tc_args = tc_args,
        tc_tpe = tc_tpe
    ] !typechecking::Type

    switch tpekind !int {
    case typechecking::TypeKind::CHAR, typechecking::TypeKind::FLOAT,
        typechecking::TypeKind::OPAQUE
        // SNIP
    case typechecking::TypeKind::WORD
        fp.read(*tpe.unsig)
    case typechecking::TypeKind::STATIC_ARRAY
        fp.read(*tpe.length)
        tpe._tpe = read_type(fp)
    case typechecking::TypeKind::TYPE,
        typechecking::TypeKind::POINTER,
        typechecking::TypeKind::REFERENCE,
        typechecking::TypeKind::WEAK_REF,
        typechecking::TypeKind::ARRAY,
        typechecking::TypeKind::BYREF

        if tpekind != typechecking::TypeKind::TYPE {
            var kw: byte
            fp.read(*kw)
            tpe.kw = kw !parser::VarDecl
        }

        tpe._tpe = read_type(fp)
    case typechecking::TypeKind::STRUCT,
        typechecking::TypeKind::UNION

        // FIXME const fields

        var is_literal: bool
        fp.read(*is_literal)
        var sz: size_t
        fp.read(*sz)

        let fields = vector::make(typechecking::StructMember)
        for var i in 0..sz {
            var np = [] !typechecking::StructMember
            np.tpe = read_type(fp)
            fp.read(*np.properties.is_bitfield)
            fp.read(*np.properties.bit_size)
            np.name = fp.read_str()
            fields.push(np)
        }
        tpe.fields = fields
        tpe.size = size
        tpe.align = align
        tpe.is_literal = is_literal
    case typechecking::TypeKind::FUNCTION,
        typechecking::TypeKind::CLOSURE

        var fun: &typechecking::Type
        let parameter_t = vector::make(typechecking::NamedParameter)
        var size: size_t
        fp.read(*size)
        for var i in 0..size {
            var np: typechecking::NamedParameter
            np.tpe = read_type(fp)
            np.name = fp.read_str()
            fp.read(*np.varargs)
            parameter_t.push(np)
            if fun {
                fun.parameter_t.push(np)
            }
        }

        let return_t = vector::make(typechecking::TypeId)
        fp.read(*size)
        for var i in 0..size {
            let ret_tpe = read_type(fp)
            return_t.push(ret_tpe)
            if fun {
                fun.return_t.push(ret_tpe)
            }
        }
        tpe.parameter_t = parameter_t
        tpe.return_t = return_t
    case typechecking::TypeKind::INTERFACE
        let members = vector::make(typechecking::StructuralTypeMember)
        var size: size_t
        fp.read(*size)
        for var i in 0..size {
            var member: typechecking::StructuralTypeMember
            member.name = fp.read_str()

            var size: size_t
            member.parameter_t = vector::make(typechecking::NamedParameter)
            fp.read(*size)
            for var i in 0..size {
                var np: typechecking::NamedParameter
                let ftpe = read_type(fp)
                np.tpe = ftpe
                np.name = fp.read_str()
                member.parameter_t.push(np)
            }
            member.return_t = vector::make(typechecking::TypeId)
            fp.read(*size)
            for var i in 0..size {
                member.return_t.push(read_type(fp))
            }
            members.push(member)
        }
        tpe.members = members
    case typechecking::TypeKind::ENUM
        tpe._tpe = read_type(fp)

        assert defmodule and defmodule.deserialize

        let scpe = scope::enter_scope(defmodule.scope)
        defmodule.deserialize.scopes.push(scpe)
        var size: size_t
        fp.read(*size)
        for var i in 0..size {
            let name = parser::make_identifier(fp.read_str())
            var value: int64
            fp.read(*value)
            let v = scope::create_variable(scpe,
                name, parser::ShareMarker::EXPORT, parser::VarDecl::CONST, typechecking::make_type_ref(tpe._tpe),
                [ kind = compiler::ValueKind::INT, tpe = tpe._tpe, i = value ] !compiler::Value
            )
            v.identifier = name
        }
        tpe.scope = scpe
    case typechecking::TypeKind::TYPE_CONSTRUCTOR
        tpe.parameter_t = vector::make(typechecking::NamedParameter)

        var size: size_t
        fp.read(*size)
        for var i in 0..size {
            let name = fp.read_str()
            var np: typechecking::NamedParameter
            np.name = name
            tpe.parameter_t.push(np)
        }

        var loc: parser::SourceLoc
        fp.read(*loc.line)
        fp.read(*loc.column)
        fp.read(*loc.end_line)
        fp.read(*loc.end_column)
        if defmodule.deserialize {
            let node = deserialize_type_node(defmodule.deserialize, loc)
            tpe.tc_node = node
        }
    case typechecking::TypeKind::BOOL
        // SNIP
    case typechecking::TypeKind::TUPLE, typechecking::TypeKind::TUNION
        tpe.return_t = vector::make(typechecking::TypeId)
        var size: uint64
        fp.read(*size)
        for var i in 0..size {
            tpe.return_t.push(read_type(fp))
        }
    case
        error(tpe.kind, "\n")
        assert
    }

    tpe.has_builtin_destructor_cached = has_builtin_destructor
    tpe.has_constructor_cached = has_constructor

    return tpe
}

def deserialize_typeref(fp: File) -> &typechecking::TypeRef {
    var kind: byte
    fp.read(*kind)
    if kind == K_TYPE {
        let tpe = read_type(fp)
        return typechecking::make_type_ref(tpe)
    } else if kind == K_NAME {
        var name = fp.read_str()
        return typechecking::make_type_ref(name)
    } else if kind == K_NONE {
        return null
    }

    let pattern = [] !&typechecking::Pattern
    fp.read(*pattern.kind)
    fp.read(*pattern.length)
    fp.read(*pattern.kw)
    pattern.name = fp.read_str()

    var has_pattern: bool
    fp.read(*has_pattern)
    if has_pattern {
        pattern.tpe = deserialize_typeref(fp)
    }

    var len: size_t
    fp.read(*len)
    if len !int64 >= 0 {
        pattern.parameter_t = vector::make(type typechecking::NamedParameterPre)
        for var i in 0..len {
            let name = fp.read_str()
            pattern.parameter_t.push([ name = name, tpe = deserialize_typeref(fp)] !typechecking::NamedParameterPre)
        }
    }

    fp.read(*len)
    if len !int64 >= 0 {
        pattern.return_t = vector::make(type &typechecking::TypeRef)
        for var i in 0..len {
            pattern.return_t.push(deserialize_typeref(fp))
        }
    }

    // TODO We currently don't support struct and union patterns
    assert pattern.kind != typechecking::TypeKind::UNION and
        pattern.kind != typechecking::TypeKind::STRUCT

    return typechecking::make_type_ref(pattern)
}

def deserialize_function(deserialize: &Deserialize, fp: File, poly_instance: bool = false, context: &toolchain::Module = null) {
    var hash: uint64
    var contents_hash: uint64
    var share: bool
    var extern: bool
    var imported: bool
    var impl: bool
    var polymorph: bool
    var is_dyn_dispatch: bool
    var name: Str
    var type_name: Str

    fp.read(*hash)
    fp.read(*contents_hash)
    fp.read(*share)
    fp.read(*extern)
    fp.read(*imported)
    fp.read(*polymorph)
    fp.read(*impl)
    fp.read(*is_dyn_dispatch)
    name = fp.read_str()
    type_name = fp.read_str()

    var size: size_t
    fp.read(*size)

    let parameter_t = vector::make(typechecking::NamedParameterPre)
    for var i in 0..size {
        var name = fp.read_str()
        let name_node = parser::make_identifier(name)
        deserialize.nodes.push(name_node) // keep a strong reference

        var kw: byte
        fp.read(*kw)
        var varargs: bool
        fp.read(*varargs)

        var tpe = deserialize_typeref(fp)
        var has_value: bool
        fp.read(*has_value)

        var value: &compiler::Value
        if has_value {
            value = deserialize_value(deserialize, fp)
        }
        parameter_t.push([ 
            name = name, tpe = tpe, 
            varargs = varargs, 
            kw = kw !parser::VarDecl,
            node = name_node,
            value = value 
        ] !typechecking::NamedParameterPre)
    }

    let return_t = vector::make(&typechecking::TypeRef)
    fp.read(*size)
    for var i in 0..size {
        let tpe = deserialize_typeref(fp)
        return_t.push(tpe)
    }

    var node: &parser::Node
    let fdef = typechecking::function_def(
        name, parameter_t, return_t, deserialize.module,
        type_name = to_string(type_name)
    )

    var is_polymorph: bool
    fp.read(*is_polymorph)
    if is_polymorph {
        var loc: parser::SourceLoc
        fp.read(*loc.line)
        fp.read(*loc.column)
        fp.read(*loc.end_line)
        fp.read(*loc.end_column)
        if not deserialize.module.is_dirty {
            node = deserialize_node(deserialize, loc)
            deserialize.nodes.push(node)
            var inner_scope = scope::enter_function_scope(deserialize.module.scope)
            node.scope = deserialize.module.scope
            node.inner_scope = inner_scope

            node.value.def_.function = [
                module = deserialize.module,
                name = to_string(type_name),
                unmangled = name,
                fdef = fdef,
                scope = deserialize.module.scope,
                inner_scope = inner_scope
            ] !&compiler::Function
        }
    }

    var sz: size_t
    fp.read(*sz)
    var data = allocate_ref(uint8, sz)
    fp.read(@data)

    deserialize.functions.push([
        name = name,
        hash = hash,
        contents_hash = contents_hash,
        share = share !parser::ShareMarker,
        node = node,
        fdef = fdef,
        imported = imported,
        polymorph = polymorph,
        poly_instance = poly_instance,
        context = context,
        impl = impl,
        is_dyn_dispatch = is_dyn_dispatch,
        block_data = data
    ] !FunctionEntry)

    debug::trace("    Function " + type_name + " (" + hash + ") with " + sz + " bytes of code")
}

def serialize_variable(fp: File, value: &scope::Value, state: &Serialize) {
    let hash = value.ident._hash
    let share = value.share !byte
    let modifier = value.modifier !byte
    let is_constant = value.modifier == typechecking::VarDecl::CONST

    fp.write(*hash)
    fp.write(*share)
    fp.write(*modifier)
    fp.write(*value.extern)
    fp.write(*value.dllimport)
    fp.write(*value.dllexport)
    fp.write_str(value.name)

    if value.dependencies {
        add_dependencies(value.dependencies, state)
    }
    
    serialize_typeref(fp, value.tpe, state)
    fp.write(*is_constant)
    if is_constant {
        serialize_value(fp, value.value, state)
    }
}

def deserialize_variable(deserialize: &Deserialize, fp: File) {
    var hash: uint64
    var share: byte
    var modifier: byte
    var extern: bool
    var dllimport: bool
    var dllexport: bool

    fp.read(*hash)
    fp.read(*share)
    fp.read(*modifier)
    fp.read(*extern)
    fp.read(*dllimport)
    fp.read(*dllexport)
    let name = fp.read_str()

    let tpe = deserialize_typeref(fp)
    var is_constant: bool
    fp.read(*is_constant)
    var value: &compiler::Value
    if is_constant {
        value = deserialize_value(deserialize, fp)
    }

    debug::trace("    Variable " + name + " (" + hash + ")")
    deserialize.variables.push([
        name = name,
        hash = hash,
        share = share !parser::ShareMarker,
        modifier = modifier !parser::VarDecl,
        extern = extern,
        dllimport = dllimport,
        dllexport = dllexport,
        tpe = tpe,
        value = value
    ] !VariableEntry)
}

let NO_VALUE: byte = -1

def serialize_value(fp: File, value: &compiler::Value, state: &Serialize) {
    if not value {
        fp.write(*NO_VALUE)
        return
    }
    let kind = value.kind !byte
    fp.write(*kind)
    if value.kind == compiler::ValueKind::NULL {
        return
    }
    if value.kind == compiler::ValueKind::TYPE {
        write_type(fp, value.value_tpe, state)
        return
    }

    fp.write(*value.metadata)
    fp.write(*value.distinct)
    fp.write_str(value.name)
    fp.write(*value.i)
    fp.write(*value.f)
    fp.write_str(value.s)
    write_type(fp, value.value_tpe, state)
    if value.values {
        let sz = value.values.size
        fp.write(*sz)
        for var i in 0..sz {
            serialize_value(fp, value.values(i), state)
        }
    } else {
        let zero: uint64 = 0
        fp.write(*zero)
    }
    write_type(fp, value.tpe, state)

    if value.kind == compiler::ValueKind::DEBUG_INFO {
        fp.write(*value.debug_values.size)
        for var param in @value.debug_values {
            fp.write_str(param.name)
            var kind = param.value.kind !byte
            fp.write(*kind)
            fp.write_str(param.value.name)
            fp.write_str(param.value.s)
            fp.write(*param.value.i)
        }
    }
}

def deserialize_value(deserialize: &Deserialize, fp: File, lookup: bool = false) -> &compiler::Value {
    var kind: byte
    fp.read(*kind)
    if kind == NO_VALUE {
        return null
    }
    if kind == compiler::ValueKind::NULL {
        return compiler::NO_VALUE
    }

    let value = [] !&compiler::Value
    value.kind = kind !compiler::ValueKind
    if value.kind == compiler::ValueKind::TYPE {
        value.value_tpe = read_type(fp, lookup)
        return value
    }

    fp.read(*value.metadata)
    fp.read(*value.distinct)
    value.name = fp.read_str()
    fp.read(*value.i)
    fp.read(*value.f)
    value.s = fp.read_str().to_array()
    value.value_tpe = read_type(fp, lookup)
    var sz: uint64
    fp.read(*sz)
    value.values = allocate_ref(compiler::Value, sz)
    for var i in 0..sz {
        value.values(i) = @deserialize_value(deserialize, fp, lookup)
    }
    value.tpe = read_type(fp, lookup)

    if value.kind == compiler::ValueKind::DEBUG_INFO {
        var sz: uint64
        fp.read(*sz)
        value.debug_values = allocate_ref(compiler::DebugParam, sz)
        for var i in 0..sz {
            var param: compiler::DebugParam
            param.name = fp.read_str()

            var kind: byte
            fp.read(*kind)
            param.value.kind = kind !compiler::DebugValueKind
            param.value.name = fp.read_str()
            param.value.s = fp.read_str()
            fp.read(*param.value.i)

            value.debug_values(i) = param
        }
    }

    if value.kind == compiler::ValueKind::GLOBAL and value.tpe {
        let name = value.name
        if not name.starts_with("__f::") and 
            not has_variable(deserialize, name) and 
            not deserialize.module.result.globals.contains(name) {

            let global = [
                name = name,
                tpe = value.tpe,
                external = true
            ] !&compiler::Global

            deserialize.module.result.globals(name) = global
            deserialize.module.imported.add(name)
        }
    }

    return value
}

def resolve_value(value: *compiler::Value) {
    if value.value_tpe {
        value.value_tpe = deserialized_types(value.value_tpe).id
    }
    if value.tpe {
        value.tpe = deserialized_types(value.tpe).id
    }
    if value.values {
        for var i in 0..value.values.size {
            resolve_value(*value.values(i))
        }
    }
}

def serialize_label(fp: File, label_: compiler::Label) {
    fp.write_str(label_.name)
}

def deserialize_label(fp: File) -> compiler::Label {
    let name = fp.read_str()
    return [ name = name ] !compiler::Label
}

def serialize_insn(fp: File, insn: &compiler::Insn, state: &Serialize) {
    let kind = insn.kind !byte
    fp.write(*kind)
    // Optional debug info
    serialize_value(fp, insn.debug, state)

    switch insn.kind {
        case compiler::InsnKind::ADD..=compiler::InsnKind::XOR
            serialize_value(fp, insn.value.arith.ret, state)
            serialize_value(fp, insn.value.arith.left, state)
            serialize_value(fp, insn.value.arith.right, state)
        case compiler::InsnKind::FCMP
            let op = insn.value.fcmp.op !byte
            fp.write(*op)
            serialize_value(fp, insn.value.fcmp.ret, state)
            serialize_value(fp, insn.value.fcmp.left, state)
            serialize_value(fp, insn.value.fcmp.right, state)
        case compiler::InsnKind::ICMP
            let op = insn.value.icmp.op !byte
            fp.write(*op)
            serialize_value(fp, insn.value.icmp.ret, state)
            serialize_value(fp, insn.value.icmp.left, state)
            serialize_value(fp, insn.value.icmp.right, state)
        case compiler::InsnKind::FNEG
            serialize_value(fp, insn.value.fneg.ret, state)
            serialize_value(fp, insn.value.fneg.value, state)
        case compiler::InsnKind::RET
            serialize_value(fp, insn.value.ret.value, state)
        case compiler::InsnKind::LOAD
            serialize_value(fp, insn.value.load.value, state)
            serialize_value(fp, insn.value.load.loc, state)
        case compiler::InsnKind::STORE
            serialize_value(fp, insn.value.store.value, state)
            serialize_value(fp, insn.value.store.loc, state)
        case compiler::InsnKind::ALLOCA
            serialize_value(fp, insn.value.alloca.ret, state)
        case compiler::InsnKind::INSERTVALUE
            serialize_value(fp, insn.value.insert_value.ret, state)
            serialize_value(fp, insn.value.insert_value.value, state)
            serialize_value(fp, insn.value.insert_value.element, state)
            fp.write(*insn.value.insert_value.index.size)
            for var i in @insn.value.insert_value.index {
                fp.write(*i)
            }
        case compiler::InsnKind::EXTRACTVALUE
            serialize_value(fp, insn.value.extract_value.ret, state)
            serialize_value(fp, insn.value.extract_value.value, state)
            fp.write(*insn.value.extract_value.index.size)
            for var i in @insn.value.extract_value.index {
                fp.write(*i)
            }
        case compiler::InsnKind::GETELEMENTPTR
            serialize_value(fp, insn.value.gep.ret, state)
            write_type(fp, insn.value.gep.tpe, state)
            serialize_value(fp, insn.value.gep.value, state)
            fp.write(*insn.value.gep.index.size)
            for var v in @insn.value.gep.index {
                serialize_value(fp, v, state)
            }
        case compiler::InsnKind::TRUNC..=compiler::InsnKind::BITCAST
            serialize_value(fp, insn.value.convert.ret, state)
            serialize_value(fp, insn.value.convert.value, state)
        case compiler::InsnKind::SWITCH
            serialize_value(fp, insn.value.switch_.value, state)
            serialize_label(fp, insn.value.switch_.otherwise)
            fp.write(*insn.value.switch_.switch_values.length)
            for var sv in insn.value.switch_.switch_values {
                serialize_value(fp, sv.value, state)
                serialize_label(fp, sv.label_)
            }
        case compiler::InsnKind::CALL
            serialize_value(fp, insn.value.call.name, state)
            serialize_value(fp, insn.value.call.ret, state)
            fp.write(*insn.value.call.args.size)
            for var v in @insn.value.call.args {
                serialize_value(fp, v, state)
            }
            let zero: size_t = 0
            if insn.value.call.proto {
                fp.write(*insn.value.call.proto.size)
                for var np in @insn.value.call.proto {
                    fp.write_str(np.name)
                    write_type(fp, np.tpe, state)
                    fp.write(*np.varargs)
                }
            } else {
                fp.write(*zero)
            }
        case compiler::InsnKind::BR_UNC
            serialize_label(fp, insn.value.br_unc.label_)
        case compiler::InsnKind::BR
            serialize_value(fp, insn.value.br.cond, state)
            serialize_label(fp, insn.value.br.if_true)
            serialize_label(fp, insn.value.br.if_false)
        case compiler::InsnKind::UNREACHABLE
            // SNIP
        case
            error(insn.kind, "\n")
            assert
    }
}

def deserialize_insn(deserialize: &Deserialize, fp: File) -> &compiler::Insn {
    var kind: byte
    fp.read(*kind)

    var insn = [] !&compiler::Insn
    insn.kind = kind !compiler::InsnKind
    insn.debug = deserialize_value(deserialize, fp, true)

    switch insn.kind {
        case compiler::InsnKind::ADD..=compiler::InsnKind::XOR
            insn.value.arith.ret = @deserialize_value(deserialize, fp, true)
            insn.value.arith.left = @deserialize_value(deserialize, fp, true)
            insn.value.arith.right = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::FCMP
            var op: byte
            fp.read(*op)
            insn.value.fcmp.op = op !compiler::CompareFloat
            insn.value.fcmp.ret = @deserialize_value(deserialize, fp, true)
            insn.value.fcmp.left = @deserialize_value(deserialize, fp, true)
            insn.value.fcmp.right = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::ICMP
            var op: byte
            fp.read(*op)
            insn.value.icmp.op = op !compiler::CompareInt
            insn.value.icmp.ret = @deserialize_value(deserialize, fp, true)
            insn.value.icmp.left = @deserialize_value(deserialize, fp, true)
            insn.value.icmp.right = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::FNEG
            insn.value.fneg.ret = @deserialize_value(deserialize, fp, true)
            insn.value.fneg.value = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::RET
            insn.value.ret.value = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::LOAD
            insn.value.load.value = @deserialize_value(deserialize, fp, true)
            insn.value.load.loc = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::STORE
            insn.value.store.value = @deserialize_value(deserialize, fp, true)
            insn.value.store.loc = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::ALLOCA
            insn.value.alloca.ret = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::INSERTVALUE
            insn.value.insert_value.ret = @deserialize_value(deserialize, fp, true)
            insn.value.insert_value.value = @deserialize_value(deserialize, fp, true)
            insn.value.insert_value.element = @deserialize_value(deserialize, fp, true)
            var idx_sz: size_t
            fp.read(*idx_sz)
            insn.value.insert_value.index = allocate_ref(int, idx_sz)
            for var i in 0..idx_sz {
                var idx: int
                fp.read(*idx)
                insn.value.insert_value.index(i) = idx
            }
        case compiler::InsnKind::EXTRACTVALUE
            insn.value.extract_value.ret = @deserialize_value(deserialize, fp, true)
            insn.value.extract_value.value = @deserialize_value(deserialize, fp, true)
            var idx_sz: size_t
            fp.read(*idx_sz)
            insn.value.extract_value.index = allocate_ref(int, idx_sz)
            for var i in 0..idx_sz {
                var idx: int
                fp.read(*idx)
                insn.value.extract_value.index(i) = idx
            }
        case compiler::InsnKind::GETELEMENTPTR
            insn.value.gep.ret = @deserialize_value(deserialize, fp, true)
            insn.value.gep.tpe = read_type(fp, lookup = true)
            insn.value.gep.value = @deserialize_value(deserialize, fp, true)
            var idx_sz: size_t
            fp.read(*idx_sz)
            insn.value.gep.index = allocate_ref(compiler::Value, idx_sz)
            for var i in 0..idx_sz {
                insn.value.gep.index(i) = @deserialize_value(deserialize, fp, true)
            }
        case compiler::InsnKind::TRUNC..=compiler::InsnKind::BITCAST
            insn.value.convert.ret = @deserialize_value(deserialize, fp, true)
            insn.value.convert.value = @deserialize_value(deserialize, fp, true)
        case compiler::InsnKind::SWITCH
            insn.value.switch_.value = @deserialize_value(deserialize, fp, true)
            insn.value.switch_.otherwise = deserialize_label(fp)
            var sz: size_t
            fp.read(*sz)
            insn.value.switch_.switch_values = vector::make(compiler::SwitchValue)
            for var i in 0..sz {
                var sv: compiler::SwitchValue
                sv.value = @deserialize_value(deserialize, fp, true)
                sv.label_ = deserialize_label(fp)
                insn.value.switch_.switch_values.push(sv)
            }
        case compiler::InsnKind::CALL
            let name = @deserialize_value(deserialize, fp, true)
            insn.value.call.name = name
            insn.value.call.ret = @deserialize_value(deserialize, fp, true)
            var args_sz: size_t
            fp.read(*args_sz)
            insn.value.call.args = allocate_ref(compiler::Value, args_sz)
            for var i in 0..args_sz {
                insn.value.call.args(i) = @deserialize_value(deserialize, fp, true)
            }
            var proto_sz: size_t
            fp.read(*proto_sz)
            if proto_sz > 0 {
                insn.value.call.proto = allocate_ref(typechecking::NamedParameter, proto_sz)
                for var i in 0..proto_sz {
                    var pname = fp.read_str()
                    var ptpe = read_type(fp, lookup = true)
                    var pvarargs: bool
                    fp.read(*pvarargs)
                    insn.value.call.proto(i) = [
                        name = pname, tpe = ptpe, varargs = pvarargs 
                    ] !typechecking::NamedParameter
                }
            }

            // Define the function if it doesn't exist yet
            if name.kind == compiler::ValueKind::GLOBAL {
                let fname = name.name
                if not deserialize.module.result.functions.contains(fname) and
                    not deserialize.has_function(fname) {
                    
                    var args = vector::make(typechecking::NamedParameter)
                    if insn.value.call.proto {
                        // Prototype gets precedence over the function arguments
                        for var np in @insn.value.call.proto {
                            args.push(np)
                        }
                    } else {
                        for var arg in @insn.value.call.args {
                            args.push([ tpe = arg.tpe ] !typechecking::NamedParameter)
                        }
                    }
                    
                    let function = [
                        forward_declare = true,
                        name = fname,
                        args = args,
                        ret = insn.value.call.ret.tpe
                    ] !&compiler::Function

                    deserialize.module.result.functions(fname) = function
                    deserialize.module.imported.add(fname)
                }
            }

        case compiler::InsnKind::BR_UNC
            insn.value.br_unc.label_ = deserialize_label(fp)
        case compiler::InsnKind::BR
            insn.value.br.cond = @deserialize_value(deserialize, fp, true)
            insn.value.br.if_true = deserialize_label(fp)
            insn.value.br.if_false = deserialize_label(fp)
        case compiler::InsnKind::UNREACHABLE
            // nothing to read
        case
            error(insn.kind, "\n")
            assert
    }
    return insn
}

def serialize_block(fp: File, block: &compiler::Block, state: &Serialize) {
    let zero: byte = 0
    let one: byte = 1
    
    // Is the block empty or not?
    if not block { 
        fp.write(*zero)
        return
    }
    fp.write(*one)
    fp.write_str(block.label_)

    // Number of instructions
    let sz = block.insn.length
    fp.write(*sz)
    for var insn in block.insn {
        serialize_insn(fp, insn, state)
    }

    serialize_block(fp, block.next, state)
}

def deserialize_block(fp: File, deserialize: &Deserialize) -> &compiler::Block {
    var first: &compiler::Block
    var last: &compiler::Block
    var has_next: byte

    loop {
        fp.read(*has_next)
        if not has_next { return first }

        let block = [] !&compiler::Block
        block.label_ = fp.read_str()

        var sz: size_t
        fp.read(*sz)
        block.insn = vector::make(type &compiler::Insn)
        for var i in 0..sz {
            let insn = deserialize_insn(deserialize, fp)
            block.insn.push(insn)
        }

        if not first {
            first = block
        } else {
            last.next = block
        }
        last = block
    }
    
    return first
}

def add_dependencies(dependencies: &Set(scope::Ident), state: &Serialize) {
    if not dependencies { return }
    for var dep in @dependencies.keys() {
        var prev = state.dependencies.get(dep.signature)
        if prev.exists {
            if prev.get()._contents_hash != 0 { continue }
        }
        state.dependencies(dep.signature) = dep
    }
}

export def serialize(module: &toolchain::Module) {
    if not module.is_dirty and not toolchain::no_incremental { return }

    let cache_file = toolchain::outfolder + "/" + module.file + ".prc"

    let fp = open(cache_file, "wb")
    defer close(fp)
    fp.write(MAGIC)
    fp.write_str(module.filename)

    let state = [
        types = map::make(typechecking::TypeId, TypeHash),
        module = module,
        dependencies = map::make(Str, scope::Ident)
    ] !&Serialize

    if module.deserialize and not toolchain::no_incremental and not module.is_dirty {
        for var dep in @module.deserialize.dependencies {
            var prev = state.dependencies.get(dep.signature)
            if prev.exists {
                if prev.get()._contents_hash != 0 { continue }
            }
            state.dependencies(dep.signature) = dep
        }
    }

    let zero: uint64 = 0

    // Write imports
    let imports = module.scope.imports
    if imports {
        fp.write(*imports.length)
        for var i in 0..imports.length {
            let imp = imports(i)
            fp.write_str(parser::identifier_to_str(imp.alias))
            fp.write_str(imp.module.module)
            fp.write_str(imp.module.filename)
        }
    } else {
        fp.write(*zero)
    }

    let re_exports = module.scope.re_exports
    if re_exports {
        fp.write(*re_exports.length)
        for var i in 0..re_exports.length {
            let re_export = re_exports(i)
            fp.write_str(re_export.module.module)
            fp.write_str(parser::identifier_to_str(re_export.pattern, types = false) !String if re_export.pattern else null)
            if re_export.pattern and re_export.pattern.value.identifier.types {
                let types = re_export.pattern.value.identifier.types
                fp.write(*types.length)
                for var j in 0..types.length {
                    let tpe = types(j).tpe
                    write_type(fp, tpe, state)
                }
            } else {
                fp.write(*zero)
            }
        }
    } else {
        fp.write(*zero)
    }

    // Write functions
    let functions = scope::all_functions(module.scope)
    let exported_functions = vector::make(type &scope::Value)
    for var value in functions {
        if not value.is_generated or value.is_dyn_dispatch {
            exported_functions.push(value)
        }
    }
    for var value in module.closures {
        exported_functions.push(value)
    }

    fp.write(*exported_functions.length) // Number of functions
    for var i in 0..exported_functions.length {
        let value = exported_functions(i)
        serialize_function(fp, value, state)
    }

    // Write polymorphic instances
    if module.scope.polymorphics {
        fp.write(*module.scope.polymorphics.size)
        for var filename in @module.scope.polymorphics.keys() {
            let context = toolchain::find_module_by_path(filename)
            fp.write_str(context.module)
            fp.write_str(filename)

            let polymorhs = vector::make(type &scope::Value)
            let scpe = module.scope.polymorphics(filename)
            for var instance in scope::all_functions(scpe) {
                polymorhs.push(instance)
            }

            fp.write(*polymorhs.length)
            for var i in 0..polymorhs.length {
                let value = polymorhs(i)
                serialize_function(fp, value, state)
            }
        }
    } else {
        fp.write(*zero)
    }

    let variables = vector::make(type &scope::Value)
    let types = vector::make(type &scope::Value)
    let keys = module.scope.fields.keys()
    for var i in 0..keys.size {
        let key = keys(i)
        let value = module.scope.fields(key)
        if value.is_internal { continue }

        add_dependencies(value.dependencies, state)
        if value.modifier == parser::VarDecl::TYPE {
            types.push(value)
        } else {
            if value.modifier == parser::VarDecl::CONST {
                if value.kind != scope::ValueKind::FUNCTION and value.kind != scope::ValueKind::NAMESPACE {
                    variables.push(value)
                }
            } else if value.kind != scope::ValueKind::TYPE {
                variables.push(value)
            }
        }
    }

    fp.write(*variables.length)
    for var i in 0..variables.length {
        serialize_variable(fp, variables(i), state)
    }

    fp.write(*types.length)
    for var i in 0..types.length {
        let value = types(i)
        fp.write_str(value.name)
        let share: byte = value.share !byte
        fp.write(*share)
        fp.write(*value.ident._hash)
        write_type(fp, value.tpe.tpe, state, value.is_alias)
    }

    // Add dependencies from main function
    let main_fun = scope::get(module.scope, parser::make_identifier("__main__"))
    if main_fun {
        add_dependencies(main_fun.dependencies, state)
    }

    // Filter out local stuff
    let dependencies = set::make(scope::Ident)
    for var key in @state.dependencies.keys() {
        let ident = state.dependencies(key)
        let value = scope::find(ident)
        if ident.module != module and (not value or not value.is_generated) {
            dependencies.add(ident)
        }
    }

    let keys3 = dependencies.keys()
    fp.write(*dependencies.size)
    for var i in 0..keys3.size {
        let ident = keys3(i)
        fp.write(*ident._hash)
        fp.write(*ident._contents_hash)
        fp.write_str(ident.name)
        fp.write_str(ident.signature)
        fp.write_str(ident.module.module !String if ident.module else null)
    }

    // Add types with generated copy constructor and destructor
    fp.write(*module.used_destructors.size)
    for var tpe in @module.used_destructors.keys() {
        let hash = tpe.stable_hash()
        fp.write(*hash)
        state.types(tpe) = [ hash = hash ] !TypeHash
    }
    fp.write(*module.used_copy_constructors.size)
    for var tpe in @module.used_copy_constructors.keys() {
        let hash = tpe.stable_hash()
        fp.write(*hash)
        state.types(tpe) = [ hash = hash ] !TypeHash
    }

    // Serialize types for this module
    // We need to create a temporary file for this because
    // we do not know how many types we will write until we have written them all,
    // and we need to write the size first for the deserializer
    let tmp = cstd::tmpfile()
    if tmp == null {
        abort("Failed to create temporary file for serialization\n")
    }

    var written: size_t = 0
    var new_types = state.types
    var all_types = set::make(uint64)
    while new_types.size > 0 {
        var old_types = state.types
        state.types = map::make(typechecking::TypeId, TypeHash)
        for var tpe in @old_types.keys() {
            if all_types.contains(tpe.stable_hash()) or 
                tpe.kind == typechecking::TypeKind::STUB { continue }

            all_types.add(tpe.stable_hash())
            let thash = old_types(tpe)
            tmp.write(*thash.hash)
            serialize_type(tmp, tpe, state, is_alias = false) // TODO alias
            written += 1
        }
        new_types = state.types
    }

    fp.write(*written)
    cstd::rewind(tmp)
    let types_data = std::read_all(tmp)
    std::close(tmp)
    
    var data: [char]
    data.value = strings::get_internal_buffer(*types_data)
    data.size = types_data.length()
    fp.write(data)
}

type FunctionEntry = struct {
    name: Str
    hash: uint64
    contents_hash: uint64
    share: parser::ShareMarker
    node: &parser::Node
    fdef: typechecking::FunctionDef
    imported: bool
    polymorph: bool
    poly_instance: bool
    impl: bool
    context: &toolchain::Module
    is_dyn_dispatch: bool
    block_data: &[uint8]
    block: &compiler::Block
    metadata: &SMap(&compiler::Value)
    constants: &SMap(&compiler::Global)
}

type VariableEntry = struct {
    name: Str
    hash: uint64
    share: parser::ShareMarker
    modifier: parser::VarDecl
    extern: bool
    dllimport: bool
    dllexport: bool
    tpe: &typechecking::TypeRef
    value: &compiler::Value
}

type TypeEntry = struct {
    name: Str
    share: parser::ShareMarker
    hash: uint64
    tpe: typechecking::TypeId
}

export type Deserialize = struct {
    module: weak &toolchain::Module
    nodes: &Vector(&parser::Node) // Strong references to nodes
    scopes: &Vector(&scope::Scope) // Strong references to enum scopes
    dependencies: &[scope::Ident]
    functions: &Vector(FunctionEntry) // Things get written before the type information so we must delay processing
    variables: &Vector(VariableEntry)
    rtypes: &Vector(TypeEntry)
    used_destructors: &Set(uint64)
    used_copy_constructors: &Set(uint64)
}

def has_function(deserialize: &Deserialize, name: Str) -> bool {
    for var f in deserialize.functions { 
        if f.name == name { return true }
    }
    return false
}

def has_variable(deserialize: &Deserialize, name: Str) -> bool {
    for var v in deserialize.variables { 
        if v.name == name { return true }
    }
    return false
}

// This is a mapping from the hash to the actual type which has been deserialized.
// We need this because we need to register types under a real type id later, this
// is used for deduplication
var deserialized_types: &Map(int64, &typechecking::Type)
deserialized_types = map::make(int64, type &typechecking::Type)

export def resolver_pass(module: &toolchain::Module) {
    if toolchain::no_incremental { return }
    if module.stage !int >= toolchain::Stage::READ_CACHE { return }
    module.stage = toolchain::Stage::READ_CACHE

    let cache_file = toolchain::outfolder + "/" + module.file + ".prc"

    if not util::exists(toolchain::outfolder + "/" + module.file + ".o") {
        toolchain::set_dirty(module)
    }

    let deserialize = [
        module = module,
        nodes = vector::make(type &parser::Node),
        scopes = vector::make(type &scope::Scope),
        functions = vector::make(FunctionEntry),
        variables = vector::make(VariableEntry),
        rtypes = vector::make(TypeEntry),
        used_destructors = set::make(uint64),
        used_copy_constructors = set::make(uint64)
    ] !&Deserialize

    module.deserialize = deserialize

    let fp = open(cache_file, "rb")
    if not fp { toolchain::set_dirty(module); return }
    defer close(fp)

    let source_fp = open(module.filename, "rb")
    defer close(source_fp)

    if modified_time(source_fp) > modified_time(fp) {
        toolchain::set_dirty(module)
    }

    var magic: [8; char] // TODO use MAGIC.size here 
    cstd::fread(magic.value, (size_of char), magic.size, fp) 

    if magic != MAGIC { toolchain::set_dirty(module); return }
    let filename = fp.read_str()
    if filename != module.filename { toolchain::set_dirty(module); return }

    debug::trace("Loading cache for module " + module.module + " (" + module.filename + ")")

    var size: size_t
    fp.read(*size)
    debug::trace("Loading " + size + " imports")
    for var i in 0..size {
        let ident = parser::identifier_from_str(fp.read_str())
        let modulename = fp.read_str()
        let filename = fp.read_str()

        debug::trace("    Import: " + modulename)
        let imprt = toolchain::create_module_if_absent(filename, modulename)
        resolver_pass(imprt)
        scope::insert_module(module.scope, ident, imprt)
    }

    fp.read(*size)
    debug::trace("Loading " + size + " re-exports")
    for var i in 0..size {
        let mod = toolchain::find_module(fp.read_str())
        let name = fp.read_str()
        let ident = parser::make_identifier(name) if name else null
        var types_size: uint64
        fp.read(*types_size)
        if types_size > 0 {
            ident.value.identifier.types = vector::make(typechecking::NamedParameter)
        }
        for var j in 0..types_size {
            let tpe = read_type(fp)
            ident.value.identifier.types.push([
                tpe = tpe
            ] !typechecking::NamedParameter)
        }
        scope::insert_re_export(module.scope, ident, mod)
    }

    fp.read(*size)
    debug::trace("Loading " + size + " functions")
    for var i in 0..size {
        deserialize_function(deserialize, fp)
    }

    fp.read(*size)
    for var i in 0..size {
        let module_name = fp.read_str()
        let path = fp.read_str()
        let context = toolchain::create_module_if_absent(path, module_name)

        var size_2: size_t
        fp.read(*size_2)
        debug::trace("Loading " + size_2 + " polymorphic instances")
        for var i in 0..size_2 {
            deserialize_function(deserialize, fp, poly_instance = true, context = context)
        }
    }

    fp.read(*size)
    debug::trace("Loading " + size + " variables")
    for var i in 0..size {
        deserialize_variable(deserialize, fp)
    }

    fp.read(*size)
    for var i in 0..size {
        let name = fp.read_str()
        var share: byte
        fp.read(*share)
        var hash: uint64
        fp.read(*hash)
        let tpe = read_type(fp)

        deserialize.rtypes.push([
            name = name,
            share = share !parser::ShareMarker,
            hash = hash,
            tpe = tpe
        ] !TypeEntry)
    }

    fp.read(*size)
    deserialize.dependencies = allocate_ref(scope::Ident, size)
    for var i in 0..size {
        var hash: uint64
        fp.read(*hash)
        var content_hash: uint64
        fp.read(*content_hash)
        let name = fp.read_str()
        let signature = fp.read_str()
        let module_name = fp.read_str()
        let path = toolchain::find_module_file(module_name, module)
        let dep_module = toolchain::create_module_if_absent(path, module_name)
        resolver_pass(dep_module)
        deserialize.dependencies(i) = scope::make_ident(name, dep_module, hash, content_hash, signature)
    }

    fp.read(*size)
    for var i in 0..size {
        var hash: uint64
        fp.read(*hash)
        deserialize.used_destructors.add(hash)
    }
    fp.read(*size)
    for var i in 0..size {
        var hash: uint64
        fp.read(*hash)
        deserialize.used_copy_constructors.add(hash)
    }

    // Deserialize types
    fp.read(*size)
    for var i in 0..size {
        var hash: int64
        fp.read(*hash)
        let tpe = deserialize_type(fp, deserialize)
        //print("Deserialized type ", hash, "\n")
        deserialized_types(hash) = tpe
    }
}

// This is where we actually define functions, variables and types for a deserialized module.
// It needs to happen later because the types need to be registered before we can define functions
// and variables that depend on them.
export def define_members(module: &toolchain::Module) {
    let deserialize = module.deserialize

    for var i in 0..deserialize.rtypes.length {
        let entry = deserialize.rtypes(i)
        let name_node = parser::make_identifier(entry.name)
        name_node.loc.module = module.module
        let val = scope::create_type(
            deserialize.module.scope, name_node, entry.share,
            typechecking::make_type_ref(entry.tpe), scope::Phase::CACHED, null
        )
        val.is_cached = true
        val.ident = scope::make_ident(entry.name, module, entry.hash)
        val.identifier = name_node

        debug::trace("Defined type ", entry.name, ": ", debug::type_to_str(entry.tpe))
    }

    for var i in 0..deserialize.functions.length {
        let entry = deserialize.functions(i)
        let name_node = parser::make_identifier(entry.name)
        name_node.loc.module = module.module

        let fdef = entry.fdef
        let is_polymorph = typechecking::is_polymorph(fdef)

        var value: &scope::Value
        if entry.poly_instance {
            value = scope::create_polymorph(
                module.scope, entry.context.scope, name_node, fdef, scope::Phase::CACHED, null, entry.impl
            )
        } else {
            value = scope::create_function_without_checking(
                module.scope, name_node, entry.share, fdef, entry.impl, scope::Phase::CACHED
            )
        }

        // Codegen only considers the function if its "imported" TODO naming bad
        module.imported.add(fdef.name)

        value.is_cached = true
        value.is_dyn_dispatch = entry.is_dyn_dispatch
        value.is_generated = entry.is_dyn_dispatch
        value.phase = scope::Phase::CACHED
        value.node = entry.node

        value.imported = entry.imported
        value.ident = scope::make_ident(entry.name, module, entry.hash, entry.contents_hash, fdef.name)
        value.identifier = name_node
        value.polymorph = entry.polymorph

        value.function = [
            module = deserialize.module,
            name = value._assembly_name,
            unmangled = value.name,
            fdef = fdef,
            value = value,
            scope = deserialize.module.scope,
            block = entry.block,
            is_compiled = not is_polymorph, // Prevent double typechecking/compilation of deserialized functions
            is_typechecked = not is_polymorph,
            meta_hash = hash(fdef.name),
            metadata = entry.metadata,
            constants = entry.constants
        ] !&compiler::Function

        if value.is_dyn_dispatch {
            module.dyn_dispatch.push(fdef)
        }

        debug::trace("Defined function " + entry.name + " (" + entry.hash + ")")
        //typechecking::print_fdef(entry.fdef)
    }

    for var i in 0..deserialize.variables.length {
        let entry = deserialize.variables(i)
        let id = parser::make_identifier(entry.name)
        id.loc.module = module.module
        let val = scope::create_variable(
            module.scope, id, entry.share,
            entry.modifier, entry.tpe,
            entry.extern, entry.dllimport, entry.dllexport, entry.value,
            scope::Phase::CACHED, null, null
        )
        val.ident._hash = entry.hash
        val.identifier = id
        val.is_cached = true
    }
}

def resolve_typeref(tr: &typechecking::TypeRef) {
    if tr == null { return}
    if typechecking::is_type(tr) {
        let dtpe = deserialized_types(tr.tpe)
        let new_id = dtpe.id
        assert new_id != 0
        tr.tpe = new_id
        return
    } else if tr.name {
        return
    }
    let pattern = tr.pattern
    assert pattern
    
    if pattern.tpe {
        resolve_typeref(pattern.tpe)
    }
    if pattern.parameter_t {
        for var i in 0..pattern.parameter_t.length() {
            resolve_typeref(pattern.parameter_t(i).tpe)
        }
    }
    if pattern.return_t {
        for var i in 0..pattern.return_t.length() {
            resolve_typeref(pattern.return_t(i))
        }
    }
    // TODO We currently don't support struct and union patterns
    assert pattern.kind != typechecking::TypeKind::UNION and
        pattern.kind != typechecking::TypeKind::STRUCT
}

export def resolve_types_and_members {

    let types = map::make(int64, type &typechecking::Type)
    for var hash in @deserialized_types.keys() {
        let tpe = deserialized_types(hash)
        types(hash) = tpe
    }

    let structs = vector::make(&typechecking::Type)

    while types.size > 0 {
        for var hash in @types.keys() {
            var tpe = types(hash)

            let _hash = tpe._hash
            var tc_tpe: typechecking::TypeId
            var tc_args: &Vector(typechecking::TypeId)
            let has_builtin_destructor_cached = tpe.has_builtin_destructor_cached
            let has_constructor_cached = tpe.has_constructor_cached

            let name = tpe.name
            let type_name = tpe.type_name
            let defmodule = tpe.defmodule

            if tpe.tc_tpe != 0 {
                //print("Before: ", tpe.tc_tpe, "\n")
                let wrapped = deserialized_types(tpe.tc_tpe)
                if wrapped.id == 0 { continue }
                tc_tpe = wrapped.id

                tc_args = vector::make(typechecking::TypeId)
                var cnt = false
                for var i in 0..tpe.tc_args.length() {
                    let arg = deserialized_types(tpe.tc_args(i))
                    if arg.id == 0 { cnt = true; break }
                    tc_args.push(arg.id)
                }
                if cnt { continue }
            }

            switch tpe.kind !int {
            case typechecking::TypeKind::OPAQUE
                tpe.id = typechecking::next_type_id()
                typechecking::register(tpe.id, tpe)
            case typechecking::TypeKind::CHAR
                tpe = builtins::char_
            case typechecking::TypeKind::FLOAT
                if tpe.size == 4 {
                    tpe = builtins::float32_
                } else if tpe.size == 8 {
                    tpe = builtins::float64_
                } else if tpe.size == 16 {
                    tpe = builtins::float80_
                }
            case typechecking::TypeKind::WORD
                if builtins::get_int_of_size(tpe.size, tpe.unsig) {
                    tpe = builtins::get_int_of_size(tpe.size, tpe.unsig)
                } else {
                    tpe = typechecking::_word(tpe.unsig, tpe.size, tpe.align)
                }
            case typechecking::TypeKind::STATIC_ARRAY
                let wrapped = deserialized_types(tpe._tpe)
                if wrapped.id == 0 { continue }
                tpe = typechecking::static_array(wrapped.id, tpe.length, tpe.kw)
            case typechecking::TypeKind::TYPE,
                typechecking::TypeKind::POINTER,
                typechecking::TypeKind::REFERENCE,
                typechecking::TypeKind::WEAK_REF,
                typechecking::TypeKind::ARRAY,
                typechecking::TypeKind::BYREF

                var id: typechecking::TypeId
                if tpe._tpe != 0 {
                    let wrapped = deserialized_types(tpe._tpe)
                    if wrapped.id == 0 { continue }
                    id = wrapped.id
                }

                switch tpe.kind !int {
                case typechecking::TypeKind::TYPE
                    tpe = typechecking::_type(id)
                case typechecking::TypeKind::POINTER
                    tpe = typechecking::pointer(id, tpe.kw)
                case typechecking::TypeKind::REFERENCE
                    tpe = typechecking::reference(id, tpe.kw)
                case typechecking::TypeKind::WEAK_REF
                    tpe = typechecking::weak_reference(id, tpe.kw)
                case typechecking::TypeKind::ARRAY
                    tpe = typechecking::array(id, tpe.kw)
                case typechecking::TypeKind::BYREF
                    tpe = typechecking::byref(id)
                }
            case typechecking::TypeKind::STRUCT,
                typechecking::TypeKind::UNION
                let id = typechecking::next_type_id()
                tpe.id = id
                typechecking::register(tpe.id, tpe)

                structs.push(tpe)
            case typechecking::TypeKind::FUNCTION,
                typechecking::TypeKind::CLOSURE

                var new_params = vector::make(typechecking::NamedParameter)
                var cnt = false
                for var i in 0..tpe.parameter_t.length() {
                    let param = tpe.parameter_t(i)
                    let new = deserialized_types(param.tpe)
                    if new.id == 0 { cnt = true; break }
                    param.tpe = new.id
                    new_params.push(param)
                }
                if cnt { continue }

                var new_returns = vector::make(typechecking::TypeId)
                for var i in 0..tpe.return_t.length() {
                    let ret = tpe.return_t(i)
                    let new = deserialized_types(ret)
                    if new.id == 0 { cnt = true; break }
                    new_returns.push(new.id)
                }
                if cnt { continue }

                if tpe.kind == typechecking::TypeKind::FUNCTION {
                    tpe = typechecking::function(new_params, new_returns)
                } else {
                    tpe = typechecking::closure(new_params, new_returns)
                }

            case typechecking::TypeKind::INTERFACE
                if not tpe.id {
                    tpe.id = typechecking::next_type_id()
                }
                typechecking::register(tpe.id, tpe)

                var new_members = vector::make(typechecking::StructuralTypeMember)

                var cnt = false
                for var i in 0..tpe.members.length() {
                    var member = tpe.members(i)

                    var new_params = vector::make(typechecking::NamedParameter)
                    for var i in 0..member.parameter_t.length() {
                        let param = member.parameter_t(i)
                        let new = deserialized_types(param.tpe)
                        if new.id == 0 { cnt = true; break }
                        param.tpe = new.id
                        new_params.push(param)
                    }
                    if cnt { break }

                    var new_returns = vector::make(typechecking::TypeId)
                    for var i in 0..member.return_t.length() {
                        let ret = member.return_t(i)
                        let new = deserialized_types(ret)
                        if new.id == 0 { cnt = true; break }
                        new_returns.push(new.id)
                    }
                    if cnt { break }
                    
                    member.parameter_t = new_params
                    member.return_t = new_returns
                    new_members.push(member)
                }
                if cnt { continue }

                tpe.members = new_members
            case typechecking::TypeKind::ENUM
                let wrapped = deserialized_types(tpe._tpe)
                if wrapped.id == 0 { continue }

                tpe._tpe = wrapped.id
                tpe.id = typechecking::next_type_id()
                typechecking::register(tpe.id, tpe)
                
                for var key in @tpe.scope.fields.keys() {
                    let field = tpe.scope.fields(key)
                    field.tpe.tpe = wrapped.id
                    field.value.tpe = wrapped.id
                }

            case typechecking::TypeKind::TYPE_CONSTRUCTOR
                tpe.id = typechecking::next_type_id()
                typechecking::register(tpe.id, tpe)
            case typechecking::TypeKind::BOOL
                tpe = builtins::bool_
            case typechecking::TypeKind::TUPLE, typechecking::TypeKind::TUNION
                var cnt = false
                var new_returns = vector::make(typechecking::TypeId)
                for var i in 0..tpe.return_t.length() {
                    let ret = tpe.return_t(i)
                    let new = deserialized_types(ret)
                    if new.id == 0 { cnt = true; break }
                    new_returns.push(new.id)
                }
                if cnt { continue }
                if tpe.kind == typechecking::TypeKind::TUPLE {
                    tpe = typechecking::tuple(new_returns)
                } else {
                    tpe = typechecking::variant(new_returns)
                }
            case
                error(tpe.kind, "\n")
                assert
            }
            
            tpe._hash = _hash
            tpe.tc_tpe = tc_tpe
            tpe.tc_args = tc_args
            tpe.has_builtin_destructor_cached = has_builtin_destructor_cached
            tpe.has_constructor_cached = has_constructor_cached
            tpe.name = name
            tpe.type_name = type_name
            tpe.defmodule = defmodule

            //print("Resolving type ", type_name, " hash: ", tpe._hash, " id: ", tpe.id, " tc_node: ", tpe.tc_node !*, "\n")

            if tpe.tc_tpe {
                //print("After: ", tpe.tc_tpe, "\n")
                typechecking::register_type_instance(tpe)
            }

            deserialized_types(hash) = tpe
            assert tpe.id != 0
            types.remove(hash)
        }
    }

    // Structs get looked up later because they can be recursive, 
    // we need to have all types registered before we can resolve their members
    for var tpe in structs {
        let id = tpe.id
        let tc_tpe = tpe.tc_tpe
        let tc_args = tpe.tc_args
        let _hash = tpe._hash
        let is_literal = tpe.is_literal
        
        let has_builtin_destructor_cached = tpe.has_builtin_destructor_cached
        let has_constructor_cached = tpe.has_constructor_cached

        let name = tpe.name
        let type_name = tpe.type_name
        let defmodule = tpe.defmodule

        var new_members = vector::make(typechecking::StructMember)
        for var i in 0..tpe.fields.length() {
            let member = tpe.fields(i)
            let new = deserialized_types(member.tpe)
            member.tpe = new.id
            new_members.push(member)
        }

        if tpe.kind == typechecking::TypeKind::STRUCT {
            tpe = typechecking::make_struct_type(new_members)
        } else {
            tpe = typechecking::make_union_type(new_members)
        }

        tpe.id = id
        tpe._hash = _hash
        tpe.is_literal = is_literal
        tpe.tc_tpe = tc_tpe
        tpe.tc_args = tc_args
        tpe.has_builtin_destructor_cached = has_builtin_destructor_cached
        tpe.has_constructor_cached = has_constructor_cached
        tpe.name = name
        tpe.type_name = type_name
        tpe.defmodule = defmodule
        
        typechecking::register(id, tpe)
    }

    // Resolve variable types and function types
    for var name in @toolchain::modules.keys() {
        let module = toolchain::modules(name)
        if module.deserialize {
            let deserialize = module.deserialize

            for var hash in @deserialize.used_destructors.keys() {
                let tpe = deserialized_types(hash)
                module.used_destructors.add(tpe.id)
            }
            for var hash in @deserialize.used_copy_constructors.keys() {
                let tpe = deserialized_types(hash)
                module.used_copy_constructors.add(tpe.id)
            }

            for var i in 0..deserialize.rtypes.length {
                let entry = deserialize.rtypes.get(i)
                entry.tpe = deserialized_types(entry.tpe).id
            }
            for var entry in deserialize.variables {
                resolve_typeref(entry.tpe)
                if entry.value { resolve_value(entry.value !*compiler::Value) }
            }
            for var i in 0..deserialize.functions.length {
                let entry = deserialize.functions.get(i)

                let fdef = entry.fdef
                for var i in 0..fdef.parameter_t.length() {
                    var np = fdef.parameter_t(i)
                    resolve_typeref(np.tpe)
                    if np.value { resolve_value(np.value !*compiler::Value) }
                }
                for var i in 0..fdef.return_t.length() {
                    resolve_typeref(fdef.return_t(i))
                }
                entry.fdef = typechecking::function_def(
                    fdef.unmangled, fdef.parameter_t, fdef.return_t, fdef.context
                )
                
                // deserialize block
                if entry.block_data.size > 0 {
                    let bfp = open_memory_as_file(@entry.block_data, "rb")
                    entry.block = deserialize_block(bfp, deserialize)

                    var sz: size_t
                    bfp.read(*sz)
                    entry.metadata = map::make(Str, &compiler::Value)
                    for var i in 0..sz {
                        let key = bfp.read_str()
                        let value = deserialize_value(deserialize, bfp, lookup = true)
                        entry.metadata(key) = value
                    }

                    bfp.read(*sz)
                    entry.constants = map::make(Str, &compiler::Global)
                    for var i in 0..sz {
                        let key = bfp.read_str()
                        let tpe = read_type(bfp, lookup = true)
                        let value = deserialize_value(deserialize, bfp)
                        entry.constants(key) = [
                            name = key,
                            tpe = tpe,
                            value = value,
                            is_function_scoped = true,
                            private = true
                        ] !compiler::Global
                    }

                    close(bfp)
                }
            }
        }
    }

    for var name in @toolchain::modules.keys() {
        let module = toolchain::modules(name)
        if module.deserialize {
            define_members(module)
        }
    }
}

export def check_dependencies {

    for var name in @toolchain::modules.keys() {
        let module = toolchain::modules(name)
        if not module.deserialize { continue }
        let deserialize = module.deserialize
        if not deserialize.dependencies { continue }
        
        // Check if any of the dependencies are out of date
        for var i in 0..deserialize.dependencies.size {
            let dep = deserialize.dependencies(i)
            let value = scope::find(dep)
            /*print("Checking dependency ", dep.name, " (", dep._hash, " & ", dep._contents_hash, ")\n")
            print("\tFound value: ", "yes" if value else "no", "\n")
            if value {
                print("\tValue hash: ", value.ident._hash, "\n")
                print("\tContents hash: ", value.ident._contents_hash, "\n")
            }*/
            // contents_hash gets set to a nonzero value when the value depends on the actual structure of the value,
            // for example if it is used in consteval or if the function is polymorphic
            if not value or value.ident._hash != dep._hash or (
                dep._contents_hash != 0 and value.ident._contents_hash != dep._contents_hash) {
                debug::trace("Dependency ", dep.name, " out of date, marking ", module.module, " as dirty")
                toolchain::set_dirty(module)
                break
            }
        }
    }
}

export def generate_ctor_and_dtor() {
    if toolchain::no_incremental {
        return
    }

    debug::trace("Generating type metadata...")
    
    let res = vector::make(compiler::TypeEntry)

    def create_type(tpe: &typechecking::Type) {
        if not tpe { return }
        //print("create_type: ", tpe.id, ": ", tpe.type_name, "\n")

        if tpe.kind == typechecking::TypeKind::TYPE_CONSTRUCTOR { return }

        // TODO These functions are weird, we want to generate both
        if tpe.has_builtin_destructor_cached {
            tpe.meta.has_destructor = typechecking::Ternary::TRUE
            typechecking::get_builtin_destructor(tpe)
        }
        if tpe.has_constructor_cached {
            typechecking::get_builtin_constructor(tpe)
        }

        let value = compiler::create_type(tpe, null, res)
    }

    for var tpe in typechecking::iterate_types() {
        create_type(tpe)
    }

    compiler::resolve_types(res)
}
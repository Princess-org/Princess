export def append_module(name: Str, module: Str) -> Str {
    var res: StringBuffer = ""
    if module {
        res += module + "::"
    }
    res += name
    return res
}

def make_function_type() -> &Type {
    let tpe = [ kind = TypeKind::FUNCTION ] !&Type
    tpe.size = size_of type def [] -> []
    tpe.align = align_of type def [] -> []
    return tpe
}


export type Primitive = struct {
    size: size_t
    align: size_t
    signed: bool
}
export def hash(this: Primitive) -> uint64 {
    return combine_hashes(this.size, this.signed !size_t, this.align)
}
export def == (this: Primitive, other: Primitive) -> bool {
    return this.size == other.size and 
        this.signed == other.signed and
        this.align == other.align
}
export def != (this: Primitive, other: Primitive) -> bool {
    return not (this == other)
}

export def _word(signed: bool, size: size_t, align: size_t) -> TypeId {
    let primitive = [ size = size, align = align, signed = signed ] !Primitive
    if type_registry_word.contains(primitive) {
        return type_registry_word(primitive).id
    }
    let tpe = [ kind = TypeKind::WORD ] !&Type
    tpe.id = next_type_id()
    tpe.size = size
    tpe.align = align
    tpe.unsig = not signed
    type_registry_word(primitive) = tpe
    register(tpe.id, tpe)

    return tpe.id
}

export type FunctionDef = struct {
    name: Str
    unmangled: Str
    context: weak &toolchain::Module
    parameter_t: &Vector(NamedParameterPre)
    return_t: &Vector(&TypeRef)
}
export def print_fdef(fdef: FunctionDef) {
    print(fdef.name + "(")
    for var i in 0..fdef.parameter_t.length() {
        let p = fdef.parameter_t(i)
        print(p.name + ": ", generic_to_string(p.tpe))
        if i < fdef.parameter_t.length() - 1 {
            print(", ")
        }
    }
    print(" -> ")
    for var i in 0..fdef.return_t.length() {
        let r = fdef.return_t(i)
        print(generic_to_string(r))
        if i < fdef.return_t.length() - 1 {
            print(", ")
        }
    }
    print(")\n")
}
export def hash(fdef: FunctionDef) -> uint64 {
    var h: uint64
    if fdef.parameter_t {
        for var par in fdef.parameter_t { // TODO hash for vectors
            h = combine_hashes(h, hash(par.tpe))  
        }
    }
    for var r in fdef.return_t {
        h = combine_hashes(h, hash(r))
    }
    return combine_hashes(hash(fdef.name), h)
}
export def == (this: FunctionDef, other: FunctionDef) -> bool {
    if this.name != other.name { return false }
    if this.context != other.context { return false }

    if this.parameter_t and other.parameter_t {
        if this.parameter_t.length != other.parameter_t.length { return false }
        for var i in 0..this.parameter_t.length {
            if this.parameter_t(i) != other.parameter_t(i) { return false }
        }
    }
    if this.return_t.length != other.return_t.length { return false }
    for var i in 0..this.return_t.length {
        if this.return_t(i) != other.return_t(i) { return false }
    }

    return true
}
export def != (this: FunctionDef, other: FunctionDef) -> bool {
    return not (this == other)
}

export def function_def(
    name: Str, 
    parameter_t: &Vector(NamedParameterPre), 
    return_t: &Vector(&TypeRef), 
    module: &toolchain::Module = null,
    extern: bool = false,
    test: bool = false,
    context: &toolchain::Module = null,
    type_name: String = null
) -> FunctionDef {
    var tname: Str

    if extern {
        tname = name
    } else if type_name {
        tname = type_name
    } else {
        let name = append_module(name, module.module) if module else name
        tname = mangle_function_name(name, parameter_t, test, context)
    }
    
    return [
        name = tname,
        unmangled = name,
        context = context if context else module,
        parameter_t = parameter_t,
        return_t = return_t
    ] !FunctionDef
}
export def to_type(fdef: FunctionDef, scpe: &scope::Scope) -> TypeId {
    let generic = [ kind = TypeKind::FUNCTION, parameter_t = fdef.parameter_t, return_t = fdef.return_t ] !&Pattern
    return generic.resolve_generic(scpe)
}
export def to_type(fdef: FunctionDef) -> TypeId {
    assert fdef.context != null
    return to_type(fdef, fdef.context.scope)
}

export type Signature = struct {
    parameter_t: &Vector(NamedParameter)
    return_t: &Vector(TypeId)
}
export def hash(signature: Signature) -> uint64 {
    var hash: uint64
    if signature.parameter_t {
        for var par in signature.parameter_t { // TODO hash for vectors
            hash = combine_hashes(hash, par.tpe !uint64)  
        }
    }
    for var r in signature.return_t {
        hash = combine_hashes(hash, r !uint64)
    }
    return hash
}
export def == (this: Signature, other: Signature) -> bool {
    if this.parameter_t and other.parameter_t {
        if this.parameter_t.length != other.parameter_t.length { return false }
        for var i in 0..this.parameter_t.length {
            if this.parameter_t(i) != other.parameter_t(i) { return false }
        }
    }
    if this.return_t.length != other.return_t.length { return false }
    for var i in 0..this.return_t.length {
        if this.return_t(i) != other.return_t(i) { return false }
    }
    return true
}
export def != (this: Signature, other: Signature) -> bool {
    return not (this == other)
}

def type_instance(node: &parser::Node, tc_tpe: TypeId, tc_args: &Vector(TypeId), cnt_scpe: &scope::Scope) -> TypeId {
    var type_constructor = resolve(tc_tpe)

    if not type_constructor or type_constructor.kind != TypeKind::TYPE_CONSTRUCTOR {
        errors::errorn(node, "Not a type constructor")
        return 0
    }

    let len = vector::length(tc_args)
    if vector::length(type_constructor.parameter_t) != len {
        errors::errorn(node, "Wrong amount of arguments to type constructor, expected ",
            to_string(vector::length(type_constructor.parameter_t) !&size_t),
            " got ",
            to_string(vector::length(tc_args) !&size_t))
        return 0
    }

    var type_name = type_constructor.type_name + '('
    var is_generic = false

    assert type_constructor.defmodule
    var scpe = scope::enter_scope(type_constructor.defmodule.scope)
    let state = make_state(type_constructor.defmodule)
    state.scope = scpe
    
    for var i in 0..len {
        let argtpe = tc_args(i)
        var np = type_constructor.parameter_t.get(i)

        scope::create_type(scpe, parser::make_identifier(np.name), parser::ShareMarker::NONE, make_type_ref(argtpe))
        type_name += debug::type_to_str(argtpe)
        if i < len - 1 {
            type_name += ", "
        }
    }
    type_name += ')'

    let type_tuple = [ ctor = type_constructor.id, types = tc_args ] !TypeTuple
    if type_registry_instance.contains(type_tuple) {
        return type_registry_instance(type_tuple).id
    }

    let id = next_type_id()
    type_registry_instance(type_tuple) = [id = id] !&Type // Prevent infinite recursion

    let tc_node = parser::deep_copy_node(type_constructor.tc_node)
    tc_node.scope = node.scope
    let tpe = type_lookup(tc_node, state).resolve(scpe).resolve()
    assert tpe != null

    // When we create new structs we automatically get a new type so we can mutate it
    if tc_node.kind == parser::NodeKind::STRUCT_T or 
        tc_node.kind == parser::NodeKind::UNION_T or 
        tc_node.kind == parser::NodeKind::STRUCTURAL_T {
            
        tpe.id = id
        tpe.type_name = type_name
        tpe.tc_tpe = type_constructor.id
        tpe.tc_args = tc_args
        tpe.type_name = type_name
        tpe.name = debug::type_to_str(tpe)
        tpe.defmodule = type_constructor.defmodule

        register(tpe.id, tpe)
    }

    type_registry_instance(type_tuple) = tpe
    // Trigger impl instances when creating new type constructors
    scope::trigger_impl(cnt_scpe, tpe)

    return tpe.id
}

def callable_generic(kind: TypeKind, parameter_t: &Vector(NamedParameterPre), return_t: &Vector(&TypeRef), scpe: &scope::Scope) -> &TypeRef {
    if is_polymorph(parameter_t, scpe) {
        return make_type_ref([ kind = kind, parameter_t = parameter_t, return_t = return_t ] !&Pattern)
    }

    var pars = vector::make(NamedParameter)
    for var par in parameter_t {
        pars.push([ name = par.name, tpe = (par.tpe.tpe if par.tpe else 0), value = par.value, kw = par.kw, varargs = par.varargs, node = par.node ] !NamedParameter)
    }

    let rets = vector::make(TypeId)
    for var ret in return_t {
        rets.push(ret.tpe)
    }
    if kind == TypeKind::CLOSURE {
        return make_type_ref(closure(pars, rets))
    } else {
        return make_type_ref(function(pars, rets))
    }
}

export def closure(parameter_t: &Vector(NamedParameterPre), return_t: &Vector(&TypeRef), scpe: &scope::Scope) -> &TypeRef {
    return callable_generic(TypeKind::CLOSURE, parameter_t, return_t, scpe)
}

def closure(parameter_t: &Vector(NamedParameter), return_t: &Vector(TypeId)) -> TypeId {
    let signature = [ parameter_t = parameter_t, return_t = return_t ] !Signature
    if type_registry_closure.contains(signature) {
        return type_registry_closure(signature).id
    }
    
    let parameter_t2 = parameter_t.copy()
    parameter_t2.insert(0, [ name = "__data", tpe = reference(0) ] !NamedParameter)
    let fun = function(parameter_t2, return_t)

    let types = vector::make(StructMember)
    types.push([ tpe = pointer(fun), name = "function" ] !StructMember)
    types.push([ tpe = reference(0), name = "data" ] !StructMember)
    let tpe = make_struct_type(types)
    tpe.id = next_type_id()
    tpe.kind = TypeKind::CLOSURE

    type_registry_closure(signature) = tpe
    register(tpe.id, tpe)
    return tpe.id
}

export def function(parameter_t: &Vector(NamedParameterPre), return_t: &Vector(&TypeRef), scpe: &scope::Scope) -> &TypeRef {
    return callable_generic(TypeKind::FUNCTION, parameter_t, return_t, scpe)
}

export def function(
    parameter_t: &Vector(NamedParameter), 
    return_t: &Vector(TypeId)
) -> TypeId {

    let signature = [ 
        parameter_t = parameter_t, 
        return_t = return_t
    ] !Signature

    if type_registry_function.contains(signature) {
        return type_registry_function(signature).id
    }

    let tpe = make_function_type()
    tpe.id = next_type_id()
    tpe.parameter_t = parameter_t
    tpe.return_t = return_t

    type_registry_function(signature) = tpe
    register(tpe.id, tpe)

    return tpe.id
}


export def tuple(generics: &Vector(&TypeRef)) -> &TypeRef {
    let types = vector::make(TypeId)
    var is_generic = false
    for var generic in generics {
        if is_type(generic) { 
            types.push(generic.tpe)
        } else {
            is_generic = true
            break
        }
    }
    
    if not is_generic {
        return make_type_ref(tuple(types))
    }

    return make_type_ref([ kind = TypeKind::TUPLE, return_t = generics ] !&Pattern)
}

export def tuple(types: &Vector(TypeId)) -> TypeId {
    let signature = [ return_t = types ] !Signature
    if type_registry_tuple.contains(signature) {
        return type_registry_tuple(signature).id
    }

    let fields = vector::make(StructMember)
    for var t in types {
        fields.push([ tpe = t ] !StructMember)
    }
    let struct_type = make_struct_type(fields)

    let tuple = [ kind = TypeKind::TUPLE ] !&Type
    tuple.id = next_type_id()
    tuple.return_t = types
    tuple.size = struct_type.size
    tuple.align = struct_type.align

    type_registry_tuple(signature) = tuple
    register(tuple.id, tuple)

    return tuple.id
}

export def variant(types: &Vector(TypeId)) -> TypeId {
    let signature = [ return_t = types ] !Signature
    if type_registry_variant.contains(signature) {
        return type_registry_variant(signature).id
    }

    let variant = [ kind = TypeKind::TUNION ] !&Type
    variant.id = next_type_id()
    variant.return_t = types
    
    var biggest_type: &Type
    var offset: uint64 = size_of *
    var align: uint64 = align_of *

    for var tpe in types {
        if not biggest_type or tpe.resolve().size > biggest_type.size {
            biggest_type = tpe.resolve()
        }
    }

    variant.size = (ceil(offset / biggest_type.align !double) * biggest_type.align) !int
    variant.align = util::lcm(align !int, biggest_type.align !int)
        
    var fields = vector::make(StructMember)
    for var i in 0..types.length {
        fields.push([ name = "_" + to_string(i), tpe = types(i) ] !StructMember)
    }

    let union_tpe = make_union_type(fields)
    union_tpe.id = next_type_id()
    register_internal(union_tpe.id, union_tpe)
    variant._tpe = union_tpe.id
    
    type_registry_variant(signature) = variant
    register(variant.id, variant)

    return variant.id
}

export def variant(generics: &Vector(&TypeRef)) -> &TypeRef {
    sort_by_typeid(generics)

    let types = vector::make(TypeId)
    var is_generic = false
    for var tpe in types {
        if is_type(tpe) { 
            types.push(tpe.tpe)
        } else {
            is_generic = true
            break
        }
    }

    if not is_generic {
        return make_type_ref(variant(types))
    }

    return make_type_ref([ kind = TypeKind::TUNION, return_t = generics ] !&Pattern)
}

// This is used to lookup box types like pointers and arrays in the type registry
export type Box = struct {
    id: TypeId
    kw: parser::VarDecl
    size: size_t
}
export def hash(this: Box) -> uint64 { return combine_hashes(this.id !uint64, this.kw !uint64, this.size !uint64) }
export def == (this: Box, other: Box) -> bool { return this.id == other.id and this.kw == other.kw and this.size == other.size }
export def != (this: Box, other: Box) -> bool { return not (this == other) }

export def _type(tpe: TypeId) -> TypeId {
    let tid = [ id = tpe ] !Box
    if type_registry_type.contains(tid) {
        return type_registry_type(tid).id
    }
    let tpetpe = [
        kind = TypeKind::TYPE,
        id = next_type_id(),
        _tpe = tpe
    ] !&Type
    type_registry_type(tid) = tpetpe
    register(tpetpe.id, tpetpe)
    return tpetpe.id
}

// TODO Use default arguments for this, right now its bugged (it doesn't define the type)
export def pointer(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let pid = [ id = tpe, kw = kw ] !Box
    if type_registry_pointer.contains(pid) {
        return type_registry_pointer(pid).id
    }
    let ptrtpe = [
        kind = TypeKind::POINTER,
        id = next_type_id(),
        _tpe = tpe,
        kw = kw,
        size = (size_of type *),
        align = (align_of type *)
    ] !&Type
    type_registry_pointer(pid) = ptrtpe
    register(ptrtpe.id, ptrtpe)
    return ptrtpe.id
}

export def pointer(generic: &TypeRef, kw: parser::VarDecl) -> &TypeRef {
    if generic == null { return make_type_ref(pointer(0, kw)) }
    if is_type(generic) { return make_type_ref(pointer(generic.tpe, kw)) }
    return make_type_ref([ kind = TypeKind::POINTER, tpe = generic ] !&Pattern)
}

export def pointer(tpe: TypeId) -> TypeId {
    return pointer(tpe, parser::VarDecl::VAR)
}

export def byref(tpe: TypeId) -> TypeId {
    let pid = [ id = tpe ] !Box
    if type_registry_byref.contains(pid) {
        return type_registry_byref(pid).id
    }
    let reftpe = [
        kind = TypeKind::BYREF,
        id = next_type_id(),
        _tpe = tpe,
        size = (size_of type *),
        align = (align_of type *)
    ] !&Type
    type_registry_byref(pid) = reftpe
    register(reftpe.id, reftpe)
    return reftpe.id
}

export def byref(generic: &TypeRef) -> &TypeRef {
    if generic == null { return make_type_ref(byref(0)) }
    if is_type(generic) { return make_type_ref(byref(generic.tpe)) }
    return make_type_ref([ kind = TypeKind::BYREF, tpe = generic ] !&Pattern)
}
export def reference(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = tpe, kw = kw ] !Box
    if type_registry_reference.contains(rid) {
        return type_registry_reference(rid).id
    }
    let reftpe = [
        kind = TypeKind::REFERENCE,
        id = next_type_id(),
        _tpe = tpe,
        kw = kw,
        size = (size_of type &),
        align = (align_of type &)
    ] !&Type
    type_registry_reference(rid) = reftpe
    register(reftpe.id, reftpe)
    return reftpe.id
}

export def reference(generic: &TypeRef, kw: parser::VarDecl) -> &TypeRef {
    if generic == null { return make_type_ref(reference(0, kw)) }
    if is_type(generic) { return make_type_ref(reference(generic.tpe, kw)) }
    return make_type_ref([ kind = TypeKind::REFERENCE, tpe = generic ] !&Pattern)
}
export def reference(tpe: TypeId) -> TypeId {
    return reference(tpe, parser::VarDecl::VAR)
}

export def weak_reference(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = tpe, kw = kw ] !Box
    if type_registry_weak_reference.contains(rid) {
        return type_registry_weak_reference(rid).id
    }
    let reftpe = [
        kind = TypeKind::WEAK_REF,
        id = next_type_id(),
        _tpe = tpe,
        kw = kw,
        size = (size_of type &),
        align = (align_of type &)
    ] !&Type
    type_registry_weak_reference(rid) = reftpe
    register(reftpe.id, reftpe)
    return reftpe.id
}

export def weak_reference(tpe: TypeId) -> TypeId {
    return weak_reference(tpe, parser::VarDecl::VAR)
}

export def weak_reference(generic: &TypeRef, kw: parser::VarDecl) -> &TypeRef {
    if generic == null { return make_type_ref(weak_reference(0, kw)) }
    if is_type(generic) { return make_type_ref(weak_reference(generic.tpe, kw)) }
    return make_type_ref([ kind = TypeKind::WEAK_REF, tpe = generic ] !&Pattern)
}
export def array(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = tpe, kw = kw ] !Box
    if type_registry_array.contains(rid) {
        return type_registry_array(rid).id
    }
    let arrtpe = [
        kind = TypeKind::ARRAY,
        id = next_type_id(),
        _tpe = tpe,
        kw = kw,
        size = (size_of type [*]),
        align = (align_of type [*])
    ] !&Type
    type_registry_array(rid) = arrtpe
    register(arrtpe.id, arrtpe)
    return arrtpe.id
}

export def array(generic: &TypeRef, kw: parser::VarDecl) -> &TypeRef {
    if is_type(generic) { return make_type_ref(array(generic.tpe, kw)) }
    return make_type_ref([ kind = TypeKind::ARRAY, tpe = generic ] !&Pattern)
}

export def array(tpe: TypeId) -> TypeId {
    return array(tpe, parser::VarDecl::VAR)
}

export def static_array(array_tpe: TypeId, size: size_t, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = array_tpe, kw = kw, size = size ] !Box
    if type_registry_static_array.contains(rid) {
        return type_registry_static_array(rid).id
    }
    let tpe = array_tpe.resolve()
    let arrtpe = [
        kind = TypeKind::STATIC_ARRAY,
        id = next_type_id(),
        _tpe = array_tpe,
        kw = kw,
        length = size,
        size = size * tpe.size,
        align = tpe.align
    ] !&Type
    type_registry_static_array(rid) = arrtpe
    register(arrtpe.id, arrtpe)
    return arrtpe.id
}

export def static_array(generic: &TypeRef, size: size_t, kw: parser::VarDecl) -> &TypeRef {
    if is_type(generic) { return make_type_ref(static_array(generic.tpe, size, kw)) }
    return make_type_ref([ kind = TypeKind::STATIC_ARRAY, length = size, tpe = generic ] !&Pattern)
}

export def static_array(array_tpe: TypeId, size: size_t) -> TypeId {
    return static_array(array_tpe, size, parser::VarDecl::VAR)
}

def make_unique_name(name: Str, state: &State) -> Str {
    let cnt = counter
    counter += 1
    return state.module.module + "::" + name + '.' + cnt
}


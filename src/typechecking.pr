export type TypeKind = enum {
    UNSET
    BOOL
    WORD
    FLOAT
    STRUCT
    UNION
    ARRAY
    STATIC_ARRAY
    POINTER
    REFERENCE
    WEAK_REF
    FUNCTION
    CLOSURE
    ENUM
    CHAR
    INTERFACE
    TUNION
    TUPLE
    TYPE
    OPAQUE
    // This is a type with arguments
    TYPE_CONSTRUCTOR
    // For patterns that are type instances
    TYPE_INSTANCE
    // Type placeholder for types that haven't been compiled yet
    STUB
    // Placeholder for arguments with polymorphic type parameter in function definition
    TYPE_DEF
    // Reference to a type
    TYPE_REF
    BYREF // ref parameter   
    RANGE // TODO Ranges should be a concrete Type defined by the stdlib
    RANGE_INC
    // Used for enums
    // NAMESPACE
    // Auto cast, this type will convert to anything
    // AUTO_CAST // TODO Actually implement this
    NULL
    UNDEF
    // This is used as a function parameter that is generic
    // GENERIC
    // References to structs are using a wk reference, ie. Type::wk instead of Type::_tpe
    // This is because references to structs can cause cycles
    // TODO I think we don't really need this because we can just use wk directly
    BOX
    VOID
    TO_INFER // Placeholder type for inference
}

export type TypeMember = struct {
    tpe: TypeId
    offset: size_t
}

type MemberProperties = struct {
    node: weak &parser::Node

    is_bitfield: bool
    bit_size: size_t
    bit_offset: size_t

    is_embed: bool
    is_const: bool
    value: &compiler::Value
}

export type StructMemberPre = struct {
    name: Str
    tpe: &TypeRef
    properties: MemberProperties
}
export def copy(member: StructMemberPre) -> StructMemberPre {
    member.tpe = (member.tpe.copy() if member.tpe else null)
    return member
}

export type StructMember = struct {
    name: Str
    tpe: TypeId
    // index into the field_types vector
    index: size_t
    properties: MemberProperties
}

export type StructuralTypeMemberPre = struct {
    name: Str
    parameter_t: &Vector(NamedParameterPre)
    return_t: &Vector(&TypeRef)
}

export type StructuralTypeMember = struct {
    name: Str
    parameter_t: &Vector(NamedParameter)
    return_t: &Vector(TypeId)
}

def resolve(member: StructuralTypeMemberPre, scpe: &scope::Scope) -> StructuralTypeMember {
    var params = vector::make(NamedParameter)
    for var param in member.parameter_t {
        let r = resolve(param.tpe, scpe)
        params.push([ 
            name = param.name, 
            tpe = r, 
            value = param.value, 
            kw = param.kw, 
            varargs = param.varargs, 
            node = param.node 
        ] !NamedParameter)
    }
    var return_ids = vector::make(TypeId)
    for var ret in member.return_t {
        let r = resolve(ret, scpe)
        return_ids.push(r)
    }
    return [
        name = member.name,
        parameter_t = params,
        return_t = return_ids
    ] !StructuralTypeMember
}

def make_type_member(name: Str, parameter_t: &Vector(NamedParameterPre), return_t: &Vector(&TypeRef)) -> StructuralTypeMemberPre {
    return [
        name = name,
        parameter_t = parameter_t,
        return_t = return_t 
    ] !StructuralTypeMemberPre
}

export type TypeId = int64
export def hash(id: TypeId) -> uint64 {
    return id !uint64
}
export def tpe(id: TypeId) -> TypeId {
    return resolve(id).tpe
}
export def kind(id: TypeId) -> TypeKind {
    let tpe = resolve(id)
    if not tpe { return TypeKind::NULL }
    return tpe.kind
}
export def type_name(id: TypeId) -> Str {
    return resolve(id).type_name
}
export def name(id: TypeId) -> Str {
    return resolve(id).name
}

export type Type = struct {
    id: TypeId

    kind: TypeKind
    defmodule: weak &toolchain::Module
    // Name of the type as used by the source code
    // Might be the name of a typedef
    name: Str
    // Unique name of the type
    type_name: Str
    // Size in bytes
    size: size_t
    align: size_t
    unsig: bool
    // Static array
    length: size_t
    kw: parser::VarDecl
    // Type both used for array/pointer and enum
    // This is also used for type arguments to specify the actual type
    // And tagged unions carry the underlying union type
    _tpe: TypeId
    packed: bool
    // Fields for struct, array of StructMember
    fields: &Vector(StructMember)
    // Constants
    const_fields: &Vector(StructMember)
    // Vector of TypeMember
    field_types: &Vector(TypeMember)
    // Function and Tuple
    return_t: &Vector(TypeId)
    // Vector of NamedParameter
    parameter_t: &Vector(NamedParameter)
    // Enum scope
    scope: &scope::Scope
    // Structural types
    // These aren't uniqued but always created as is inline
    members: &Vector(StructuralTypeMember)
    // Type constructors save a template of a type
    tc_node: weak &parser::Node
    // Cache of specialized type constructor
    //cache: &Map(TypeRef, &Type)
    // Type constructor instances have a type and arguments
    tc_tpe: TypeId
    // Vector of Type, also used by GENERIC
    tc_args: &Vector(TypeId)
    // True if some parameters weren't set yet
    //tc_incomplete: bool
    // null means any for variant
    //variants: &Set(TypeId)
    // This is set so that we can find dependencies of functions
    // by looking at the values that defined the types
    svalue: weak &scope::Value

    // This is used by deserialization to check if a type is in the
    // type cache, so that structs can keep a wk reference to the type
    //is_in_type_cache: bool
    // Set on type arguments
    //is_type_argument: bool
    
    // Interface implementation
    intf: TypeId
    // This gets set if it might also be a type argument, in that case we also consider the overload with a type
    // As an example, consider [int], this might be an array of types or an array type
    //may_be_type: &Type
    // True if this is an anonymous struct
    is_anon: bool

    // constructor and destructor meta data
    has_constructor: Ternary
    has_user_defined_constructor: Ternary
    constructor: &scope::Value

    has_destructor: Ternary
    has_builtin_destructor: Ternary
    destructor: &scope::Value
    builtin_destructor: &scope::Value

    // Members for structural Types
    //functions: &Vector(TypeEntryMember)
    //cached: &Map(TypeId, CacheEntry)

    implements: &Set(TypeId)
    // Used by typechecking to avoid multiple errors for the same type when it fails to implement an interface
    not_implements: &Set(TypeId)
    implementors: &Map(TypeId, &Vector(&scope::Value))
}

export def tpe(tpe: &Type) -> TypeId {
    if tpe.kind == TypeKind::WEAK_REF {
        return tpe._tpe.tpe
    }
    return tpe._tpe
}

export def has_variant(this: &Type, tpe: &Type) -> bool {
    assert this.kind == TypeKind::TUNION
    for var t in this.return_t {
        if t == tpe.id { return true }
    }
    return false
}

export def hash(tpe: &Type) -> uint64 {
    return tpe.id
}

export type Ternary = enum {
    UNDEFINED
    TRUE
    FALSE
}

export type TypeRef = struct {
    tpe: TypeId
    name: Str
    pattern: &Pattern
}

export def make_type_ref(tpe: TypeId) -> &TypeRef {
    return [ tpe = tpe ] !&TypeRef
}
export def make_type_ref(name: Str) -> &TypeRef {
    return [ name = name ] !&TypeRef
}
export def make_type_ref(pattern: &Pattern) -> &TypeRef {
    return [ pattern = pattern ] !&TypeRef
}

export def copy(tref: &TypeRef) -> &TypeRef {
    if not tref { return null }
    return [ 
        tpe = tref.tpe,
        name = tref.name,
        pattern = tref.pattern.copy() if tref.pattern else null
    ] !&TypeRef
}

export def is_type(typeref: &TypeRef) -> bool {
    return typeref.tpe != 0
}

// This is potentially hazardous because TypeRefs are mutable
export def hash(typeref: &TypeRef) -> uint64 {
    if typeref.tpe != 0 {
        return hash(typeref.tpe)
    } else if typeref.name {
        return hash(typeref.name)
    } else if typeref.pattern {
        return hash(generic_to_string(typeref.pattern))
    }
    assert
}
export def == (this: &TypeRef, other: &TypeRef) -> bool {
    if not this and not other { return true } // TODO Boilerplate
    if not this or not other { return false }
    if this.tpe != 0 and other.tpe != 0 {
        return this.tpe == other.tpe
    } else if this.name and other.name {
        return this.name == other.name
    } else if this.pattern and other.pattern {
        return this.pattern == other.pattern
    }
    return false
}
export def != (this: &TypeRef, other: &TypeRef) -> bool {
    return not (this == other)
}

export def kind(typeref: &TypeRef) -> TypeKind {
    if typeref.tpe {
        return typeref.tpe.resolve().kind
    } else if typeref.name {
        return TypeKind::TYPE_REF
    } else if typeref.pattern {
        return typeref.pattern.kind
    }
}

def resolve_stub_types(tpe: &Type, error_on_fail: bool = true) {
    if not tpe { return }
    if is_box(tpe) {
        resolve_stub_types(tpe.tpe, error_on_fail)
    } else if tpe.kind == TypeKind::STUB {
        assert tpe.defmodule != null
        // Lookup stub types on demand
        let id = scope::get_type_id(tpe.defmodule.scope, parser::identifier_from_str(tpe.type_name), error_on_fail)
        if id == 0 { return }
        assert id == tpe.id
    } else if tpe.kind == TypeKind::TUPLE or tpe.kind == TypeKind::TUNION {
        for var r in tpe.return_t {
            resolve_stub_types(r, error_on_fail)
        }
    }
}

export def resolve(typeref: &TypeRef, scpe: &Scope, error_on_fail: bool = true) -> TypeId {
    if not typeref { return 0 }
    if typeref.tpe {
        let actual = typeref.tpe.resolve()
        resolve_stub_types(actual, error_on_fail)
        return typeref.tpe
    }
    if typeref.name {
        let id = scope::get_type_id(scpe, parser::identifier_from_str(typeref.name), error_on_fail)
        typeref.tpe = id
        return id
    }
    if typeref.pattern {
        let id = resolve_generic(typeref.pattern, scpe, error_on_fail)
        typeref.tpe = id
        return id
    } 
}

def resolve_generic(generic: &Pattern, scpe: &Scope, error_on_fail: bool = true) -> TypeId {
    switch generic.kind {
        case TypeKind::TYPE_DEF
            return 0
        case TypeKind::ARRAY
            let r = resolve(generic.tpe, scpe, error_on_fail)
            if generic.tpe and r == 0 { return 0 }
            return array(r)
        case TypeKind::STATIC_ARRAY
            let r = resolve(generic.tpe, scpe, error_on_fail)
            if generic.tpe and r == 0 { return 0 }
            return static_array(r, generic.length)
        case TypeKind::POINTER
            let r = resolve(generic.tpe, scpe, error_on_fail)
            if generic.tpe and r == 0 { return 0 }
            return pointer(r, generic.kw)
        case TypeKind::REFERENCE
            let r = resolve(generic.tpe, scpe, error_on_fail)
            if generic.tpe and r == 0 { return 0 }
            return reference(r, generic.kw)
        case TypeKind::WEAK_REF
            let r = resolve(generic.tpe, scpe, error_on_fail)
            if generic.tpe and r == 0 { return 0 }
            return weak_reference(r, generic.kw)
        case TypeKind::FUNCTION, TypeKind::CLOSURE
            var params: &Vector(NamedParameter) = vector::make(NamedParameter)
            for var param in generic.parameter_t {
                let r = resolve(param.tpe, scpe, error_on_fail)
                if param.tpe and r == 0 { return 0 }
                vector::push(params, [ 
                    name = param.name, 
                    tpe = r, 
                    value = param.value, 
                    kw = param.kw, 
                    varargs = param.varargs, 
                    node = param.node 
                ] !NamedParameter)
            }
            var return_ids: &Vector(TypeId) = vector::make(TypeId)
            for var ret in generic.return_t {
                let r = resolve(ret, scpe, error_on_fail)
                if ret and r == 0 { return 0 }
                vector::push(return_ids, r)
            }
            if generic.kind == TypeKind::CLOSURE {
                return closure(params, return_ids)
            } else {
                return function(params, return_ids)
            }
        case TypeKind::TUPLE, TypeKind::TUNION, TypeKind::TYPE_INSTANCE
            var param_ids: &Vector(TypeId) = vector::make(TypeId)
            for var tpe in generic.return_t {
                let r = resolve(tpe, scpe, error_on_fail)
                if tpe and r == 0 { return 0 }
                vector::push(param_ids, r)
            }
            if generic.kind == TypeKind::TYPE_INSTANCE {
                let type_constructor = resolve(generic.tpe, scpe, error_on_fail)
                return type_instance(generic.node, type_constructor, param_ids, scpe)
            } else if generic.kind == TypeKind::TUPLE {
                return tuple(param_ids)
            } else {
                return variant(param_ids)
            }
        case TypeKind::UNION, TypeKind::STRUCT
            var fields: &Vector(StructMember) = vector::make(StructMember)
            for var field in generic.fields {
                vector::push(fields, [
                    name = field.name,
                    tpe = resolve(field.tpe, scpe, error_on_fail),
                    properties = field.properties
                ] !StructMember)
            }
            var const_fields: &Vector(StructMember) = vector::make(StructMember)
            for var field in generic.const_fields {
                vector::push(const_fields, [
                    name = field.name,
                    tpe = resolve(field.tpe, scpe, error_on_fail),
                    properties = field.properties
                ] !StructMember)
            }
            var tpe: &Type
            if generic.kind == TypeKind::STRUCT {
                tpe = make_struct_type(fields, const_fields)
            } else {
                tpe = make_union_type(fields, const_fields)
            }
            tpe.id = next_type_id()
            register_internal(tpe.id, tpe)
            return tpe.id
        case TypeKind::INTERFACE
            let members = vector::make(StructuralTypeMember)
            for var member in generic.members {
                members.push(resolve(member, scpe))
            }
            let tpe = [ kind = TypeKind::INTERFACE, members = members ] !&Type
            tpe.id = next_type_id()
            register_internal(tpe.id, tpe)
            return tpe.id
        case; assert
    }
}

export type Pattern = struct {
    kind: TypeKind
    length: size_t
    tpe: &TypeRef
    kw: parser::VarDecl
    // Name for type constructor
    name: Str
    parameter_t: &Vector(NamedParameterPre)
    // Also used for type constructors
    return_t: &Vector(&TypeRef)
    // Structs and unions
    fields: &Vector(StructMemberPre)
    const_fields: &Vector(StructMemberPre)
    // Node for type constructor
    node: weak &parser::Node
    members: &Vector(StructuralTypeMemberPre)
}

export def copy(pattern: &Pattern) -> &Pattern {
    let res = @pattern !&Pattern

    if pattern.parameter_t {
        res.parameter_t = vector::make(NamedParameterPre)
        for var param in pattern.parameter_t {
            vector::push(res.parameter_t, copy(param))
        }
    }
    if pattern.return_t {
        res.return_t = vector::make(&TypeRef)
        for var ret in pattern.return_t {
            vector::push(res.return_t, copy(ret))
        }
    }
    if pattern.fields {
        res.fields = vector::make(StructMemberPre)
        for var field in pattern.fields {
            vector::push(res.fields, copy(field))
        }
    }
    if pattern.const_fields {
        res.const_fields = vector::make(StructMemberPre)
        for var field in pattern.const_fields {
            vector::push(res.const_fields, copy(field))
        }
    }

    if pattern.tpe {
        res.tpe = copy(pattern.tpe)
    }

    return res
}

type EqEnv = struct {
    scope: &scope::Scope
    typedefs_a: &SMap(int)
    typedefs_b: &SMap(int)
    counter: int
}

def make_eq_env(scpe: &scope::Scope) -> &EqEnv {
    return [
        scope = scpe,
        typedefs_a = map::make(int),
        typedefs_b = map::make(int),
        counter = 0
    ] !&EqEnv
}

export def == (this: &Pattern, other: &Pattern) -> bool {
    return equals(this, other)
}

export def equals(this: &Pattern, other: &Pattern, env: &EqEnv = null) -> bool {
    if this.kind != other.kind {
        return false
    }
    switch this.kind {
        case TypeKind::TYPE_DEF
            if env {
                env.typedefs_a(this.name) = env.counter
                env.typedefs_b(other.name) = env.counter
                env.counter += 1
                if this.tpe and other.tpe {
                    return parameter_equals_single(this.tpe, other.tpe, env)
                }
                return this.tpe == other.tpe
            } else if this.tpe and other.tpe {
                return this.tpe == other.tpe
            } else if this.name and other.name {
                return this.name == other.name
            } else {
                return false
            }
        case TypeKind::ARRAY, TypeKind::POINTER, TypeKind::REFERENCE, TypeKind::WEAK_REF
            return this.kw == other.kw and parameter_equals_single(this.tpe, other.tpe, env)
        case TypeKind::STATIC_ARRAY
            return this.length == other.length and this.kw == other.kw and parameter_equals_single(this.tpe, other.tpe, env)
        case TypeKind::FUNCTION, TypeKind::CLOSURE
            if this.parameter_t.length() != other.parameter_t.length() {
                return false
            }
            for var i in 0..this.parameter_t.length() {
                let param_a = this.parameter_t(i)
                let param_b = other.parameter_t(i)
                if param_a.name != param_b.name or not parameter_equals_single(param_a.tpe, param_b.tpe, env) {
                    return false
                }
            }
            if this.return_t.length() != other.return_t.length() {
                return false
            }
            for var i in 0..this.return_t.length() {
                if not parameter_equals_single(this.return_t(i), other.return_t(i), env) {
                    return false
                }
            }
            return true
        case TypeKind::TUPLE, TypeKind::TUNION, TypeKind::TYPE_INSTANCE
            if this.return_t.length() != other.return_t.length() {
                return false
            }
            for var i in 0..this.return_t.length() {
                if not parameter_equals_single(this.return_t(i), other.return_t(i), env) {
                    return false
                }
            }
            return true
        case TypeKind::STRUCT, TypeKind::UNION
            if this.fields.length() != other.fields.length() {
                return false
            }
            for var i in 0..this.fields.length() {
                if this.fields(i).name != other.fields(i).name or not parameter_equals_single(this.fields(i).tpe, other.fields(i).tpe, env) {
                    return false
                }
            }
            return true
        case; assert
    }
}
export def != (this: &Pattern, other: &Pattern) -> bool {
    return not (this == other)
}

export def generic_to_string(typeref: &TypeRef) -> Str {
    if not typeref { return "null" }
    if typeref.tpe {
        return debug::type_to_str(typeref.tpe)
    } else if typeref.name {
        return typeref.name
    } else if typeref.pattern {
        return generic_to_string(typeref.pattern)
    }
}

def generic_to_string(generic: &Pattern) -> Str {
    if generic.kind == TypeKind::TYPE_DEF {
        if generic.tpe {
            return "type-def<" + generic_to_string(generic.tpe) + ">"
        } else if generic.name {
            return "type-def " + generic.name
        } else {
            return "type-def<?>"
        }
    } else if generic.kind == TypeKind::REFERENCE {
        return "&" + generic_to_string(generic.tpe) // FIXME *let kw
    } else if generic.kind == TypeKind::POINTER {
        return "*" + generic_to_string(generic.tpe) // FIXME &let kw
    } else if generic.kind == TypeKind::ARRAY {
        return "[" + generic_to_string(generic.tpe) + "]"
    } else if generic.kind == TypeKind::STATIC_ARRAY {
        return "[" + generic.length + "; " + generic_to_string(generic.tpe) + "]"
    } else if generic.kind == TypeKind::TYPE_INSTANCE {
        var res: StringBuffer = generic_to_string(generic.tpe) + "("
        let len = generic.return_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.return_t(i))
            if i < len - 1 {
                res += ", "
            }
        }
        res += ')'
        return res
    } else if generic.kind == TypeKind::TUPLE {
        var res: StringBuffer = "["
        let len = generic.return_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.return_t(i))
            if i < len - 1 {
                res += ", "
            }
        }
        res += ']'
        return res
    } else if generic.kind == TypeKind::FUNCTION or generic.kind == TypeKind::CLOSURE {
        var res: StringBuffer = "def [" if generic.kind == TypeKind::CLOSURE else "["
        var len = generic.parameter_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.parameter_t(i).tpe)
            if i < len - 1 {
                res += ", "
            }
        }
        res += "] -> ["
        for var i in 0..len {
            res += generic_to_string(generic.return_t(i))
            if i < len - 1 {
                res += ", "
            }
        }
        return res
    } else if generic.kind == TypeKind::TUNION {
        var res: StringBuffer = "("
        let len = generic.return_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.return_t(i))
            if i < len - 1 {
                res += " | "
            }
        }
        res += ")"
        return res
    }
    assert
}

// TODO Offset this by a project id that is unique for a build
export var current_type_id: uint64
export def next_type_id -> TypeId {
    let id = current_type_id
    current_type_id += 1
    return id !TypeId
}

export var type_registry: &map::Map(TypeId, &Type)
// This is used for types that get synthesized during compilation. 
// Without this, new types would fill up the type registry slowly when using incremental compilation
export var type_registry_internal: &Map(TypeId, &Type)
// This is needed to filter out types that aren't used and don't need to be serialized
export var used_types: &Set(TypeId)

export var type_registry_word: &Map(Primitive, &Type)
export var type_registry_closure: &Map(Signature, &Type)
export var type_registry_function: &Map(Signature, &Type)
export var type_registry_tuple: &Map(Signature, &Type)
export var type_registry_variant: &Map(Signature, &Type)
export var type_registry_type: &Map(Box, &Type)
export var type_registry_pointer: &Map(Box, &Type)
export var type_registry_byref: &Map(Box, &Type)
export var type_registry_reference: &Map(Box, &Type)
export var type_registry_weak_reference: &Map(Box, &Type)
export var type_registry_array: &Map(Box, &Type)
export var type_registry_static_array: &Map(Box, &Type)
export var type_registry_instance: &Map(TypeTuple, &Type)

export def load_type_registries {
    current_type_id = 7
    type_registry = map::make(TypeId, type &Type)
    type_registry_internal = map::make(TypeId, type &Type)
    used_types = set::make(TypeId)

    type_registry_word = map::make(Primitive, type &Type)
    type_registry_closure = map::make(Signature, type &Type)
    type_registry_function = map::make(Signature, type &Type)
    type_registry_tuple = map::make(Signature, type &Type)
    type_registry_variant = map::make(Signature, type &Type)
    type_registry_type = map::make(Box, type &Type)
    type_registry_pointer = map::make(Box, type &Type)
    type_registry_byref = map::make(Box, type &Type)
    type_registry_reference = map::make(Box, type &Type)
    type_registry_weak_reference = map::make(Box, type &Type)
    type_registry_array = map::make(Box, type &Type)
    type_registry_static_array = map::make(Box, type &Type)
    type_registry_instance = map::make(TypeTuple, type &Type)
}

export let null_ = [ kind = TypeKind::NULL, id = 1 ] !&Type
export let void = [ kind = TypeKind::VOID, id = 2 ] !&Type
export let to_infer = [ kind = TypeKind::TO_INFER, id = 3 ] !&Type
export let undef_ = [ kind = TypeKind::UNDEF, id = 4 ] !&Type
export let range = [ kind = TypeKind::RANGE, id = 5 ] !&Type
export let range_inc = [ kind = TypeKind::RANGE_INC, id = 6] !&Type

export implicit def resolve(id: TypeId) -> &Type {
    switch id !int64 {
        case 0; return null
        case 1; return null_
        case 2; return void
        case 3; return to_infer
        case 4; return undef_
        case 5; return range
        case 6; return range_inc
    }
    var res = type_registry.get_or_default(id, null)
    if not res { res = type_registry_internal.get_or_default(id, null) }
    return res
}

export def register(id: TypeId, tpe: &Type) {
    type_registry(id) = tpe
}

export def register_internal(id: TypeId, tpe: &Type) {
    type_registry_internal(id) = tpe
}

def sort_by_typeid(types: &Vector(&TypeRef)) {
    let n = types.length
    // bubble sort because icba // TODO Implement sorting for vectors and arrays
    for var i in 0..n {
        for var j in 0..(n - 1) {
            // FIXME repeated hash calculation, this is potentially slow, cache them
            if hash(types(j)) > hash(types(j + 1)) {
                let t = types(j); types(j) = types(j + 1); types(j + 1) = t
            }
        }
    }
}

// Returns true if there's any destructor present
export def has_destructor(tpe: &Type) -> bool {
    if not tpe { return false }
    if tpe.has_destructor != Ternary::UNDEFINED {
        return tpe.has_destructor == Ternary::TRUE
    }
    var res = false
    if is_ref(tpe) {
        res = true
    } else if tpe.kind == TypeKind::STATIC_ARRAY { 
        res = has_destructor(tpe.tpe) 
    } else if tpe.defmodule and get_user_defined_destructor(tpe) != null {
        res = true
    } else if tpe.kind == TypeKind::STRUCT {
        for var i in 0..tpe.fields.length() {
            let field = tpe.fields(i)
            if has_destructor(field.tpe) {
                res = true
                break
            }
        }
    } else if tpe.kind == TypeKind::CLOSURE {
        res = true
    } else if tpe.kind == TypeKind::TUNION {
        for var v in tpe.return_t {
            if has_destructor(v) {
                res = true
                break
            }
        }
    }

    if not consteval::is_static {
        if res {
            tpe.has_destructor = Ternary::TRUE
        } else {
            tpe.has_destructor = Ternary::FALSE
        }
    }
    return res
}

export def get_builtin_destructor(tpe: &Type) -> &scope::Value {
    if not tpe { return null }
    //if is_polymorph(tpe) { return null }

    if tpe.has_builtin_destructor != Ternary::UNDEFINED and tpe.builtin_destructor {
        return tpe.builtin_destructor
    }

    var destructor = tpe.builtin_destructor
    let args = vector::make(NamedParameter)
    args.push([ tpe = pointer(tpe.id) ] !NamedParameter)
    if not tpe.builtin_destructor {
        let has_builtin_destructor = tpe.has_builtin_destructor
        tpe.has_builtin_destructor = Ternary::TRUE
        destructor = scope::generate_function(builtins::builtins, parser::make_identifier("__destruct__"), args, true)
        tpe.builtin_destructor = destructor
        if consteval::is_static and destructor {
            compiler::create_destructor(destructor.fdef)
        }
        tpe.has_builtin_destructor = has_builtin_destructor
    }
    // The problem is if we cache this value in consteval the relevant functions might not exist
    if not consteval::is_static {
        if destructor {
            tpe.has_builtin_destructor = Ternary::TRUE
        } else {
            tpe.has_builtin_destructor = Ternary::FALSE
        }
    }
    return destructor
}

export def get_user_defined_destructor(tpe: &Type) -> &scope::Value {
    if tpe.has_destructor != Ternary::UNDEFINED {
        if tpe.destructor { return tpe.destructor }
    }
    if tpe.defmodule {
        let args = vector::make(NamedParameter)
        args.push([
            tpe = pointer(tpe.id)
        ] !NamedParameter)
        var destructor = scope::get_function(tpe.defmodule.scope, parser::make_identifier("destruct"), args, false, true, not consteval::is_static)
        if destructor {
            if consteval::is_static {
                destructor = consteval::compile_function(destructor, tpe.defmodule.scope, args)
            } else {
                tpe.has_destructor = Ternary::TRUE
            }
            tpe.destructor = destructor
            return destructor 
        }
    }
    return null
}

export def get_constructor(tpe: &Type) -> &scope::Value {
    has_copy_constructor(tpe)
    return tpe.constructor
}

export def has_user_defined_copy_constructor(tpe: &Type) -> bool {
    if not tpe { return false }
    if tpe.kind != TypeKind::STRUCT and
        tpe.kind != TypeKind::UNION {
        return false        
    }

    if tpe.has_user_defined_constructor != Ternary::UNDEFINED {
        return tpe.has_user_defined_constructor == Ternary::TRUE
    }

    var res = false
    if tpe.kind == TypeKind::STATIC_ARRAY { res = has_user_defined_copy_constructor(tpe.tpe) }
    else if tpe.defmodule {
        let args = vector::make(NamedParameter)
        args.push([ tpe = pointer(tpe.id)] !NamedParameter)
        args.push([ tpe = pointer(tpe.id)] !NamedParameter)

        var module = tpe.defmodule
        if tpe.tc_tpe { module = tpe.tc_tpe.resolve().defmodule }
        var constructor = scope::get_function(module.scope, parser::make_identifier("construct"), args, false, not consteval::is_static)
        if constructor {
            if consteval::is_static {
                constructor = consteval::compile_function(constructor, module.scope, args)
            }
            tpe.constructor = constructor
            res = true 
        }
    }

    if not consteval::is_static {
        if res { tpe.has_user_defined_constructor = Ternary::TRUE }
        else { tpe.has_user_defined_constructor = Ternary::FALSE }
    }
    return res
}

export def get_builtin_constructor(tpe: &Type) -> &scope::Value {
    if not tpe { return null }
    //if is_polymorph(tpe) { return null }

    if tpe.has_constructor != Ternary::UNDEFINED and tpe.constructor {
        return tpe.constructor
    }

    let args = vector::make(NamedParameter)
    vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
    vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
    tpe.constructor = scope::generate_function(builtins::builtins, parser::make_identifier("__construct__"), args, dry_run = true)
    if consteval::is_static and tpe.constructor {
        compiler::create_constructor(tpe.constructor.fdef)
    }
    if not consteval::is_static {
        if tpe.constructor {
            tpe.has_constructor = Ternary::TRUE
        } else {
            tpe.has_constructor = Ternary::FALSE
        }
    }
    return tpe.constructor
}

// Returns true if there's any copy constructor
// TODO Write a separate function for checking without generating
export def has_copy_constructor(tpe: &Type) -> bool {
    if not tpe { return false }
    if tpe.kind != TypeKind::STRUCT and 
        tpe.kind != TypeKind::UNION and
        tpe.kind != TypeKind::STATIC_ARRAY and 
        tpe.kind != TypeKind::CLOSURE and
        tpe.kind != TypeKind::TUNION { 
        return false 
    }

    if has_user_defined_copy_constructor(tpe) {
        tpe.has_constructor = Ternary::TRUE
        return true
    }

    if tpe.has_constructor != 0 {
        if tpe.has_constructor == Ternary::TRUE {
            return true
        } else if tpe.has_constructor == Ternary::FALSE {
            return false
        }
    } 

    var res = false
    if tpe.kind == TypeKind::STRUCT {
        for var i in 0..tpe.fields.length() {
            let field = tpe.fields(i)
            if has_copy_constructor(field.tpe) or is_ref(field.tpe) {  
                res = true
                break
            }
        }
    } else if tpe.kind == TypeKind::CLOSURE {
        res = true
    } else if tpe.kind == TypeKind::STATIC_ARRAY {
        while tpe != null and tpe.kind == TypeKind::STATIC_ARRAY {
            tpe = tpe.tpe
        }
        if has_copy_constructor(tpe) or is_ref(tpe) { 
            res = true
        }
    } else if tpe.kind == TypeKind::TUNION {
        for var variant in tpe.return_t {
            if has_copy_constructor(variant) or is_ref(variant) {  
                res = true
                break
            }
        }
    }

    if not tpe.constructor {
        let has_constructor = tpe.has_constructor
        tpe.has_constructor = Ternary::TRUE
        let args = vector::make(NamedParameter)
        vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
        vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
        tpe.constructor = scope::generate_function(builtins::builtins, parser::make_identifier("__construct__"), args, dry_run = true)
        if consteval::is_static and tpe.constructor {
            compiler::create_constructor(tpe.constructor.fdef)
        }
        tpe.has_constructor = has_constructor
    }

    if not consteval::is_static {
        if res {
            tpe.has_constructor = Ternary::TRUE
        } else {
            tpe.has_constructor = Ternary::FALSE
        }
    }

    return res
}

// This returns a type's module OR if it is a box (i.e references or pointers)
// returns the module of the wrapped type
export def get_module(tpe: &Type) -> &toolchain::Module {
    if not tpe { return null }
    if is_box(tpe) { return get_module(tpe.tpe) }
    return tpe.defmodule
}

export type NamedParameterPre = struct {
    name: Str
    tpe: &TypeRef
    value: &compiler::Value
    kw: parser::VarDecl
    varargs: bool
    node: weak &parser::Node
}
export def copy(this: NamedParameterPre) -> NamedParameterPre {
    this.tpe = this.tpe.copy() if this.tpe else null
    return this
}
export def == (this: NamedParameterPre, other: NamedParameterPre) -> bool {
    return this.name == other.name and this.tpe == other.tpe
}
export def != (this: NamedParameterPre, other: NamedParameterPre) -> bool { 
    return not (this == other)
}
export def hash(this: NamedParameterPre) -> uint64 {
    return combine_hashes(hash(this.name), hash(this.tpe))
}

def make_parameter(tref: &TypeRef, node: &parser::Node = null, name: String = null) -> NamedParameterPre {
    return [ name = name, tpe = tref, node = node ] !NamedParameterPre
}

export def wrap_ref(params: &Vector(NamedParameter)) -> &Vector(NamedParameterPre) {
    var res: &Vector(NamedParameterPre) = vector::make(NamedParameterPre)
    for var param in params {
        // TODO Other parameters
        vector::push(res, make_parameter(make_type_ref(param.tpe), param.node, param.name))
    }
    return res
}
export def wrap_ref(rets: &Vector(TypeId)) -> &Vector(&TypeRef) {
    var res: &Vector(&TypeRef) = vector::make(&TypeRef)
    for var ret in rets {
        vector::push(res, make_type_ref(ret))
    }
    return res
}

export type NamedParameter = struct {
    // Might be empty for positional parameters
    name: Str
    tpe: TypeId
    value: &compiler::Value
    kw: parser::VarDecl
    varargs: bool
    node: weak &parser::Node
}
export def to_pre(this: NamedParameter) -> NamedParameterPre {
    return [ 
        name = this.name, 
        tpe = make_type_ref(this.tpe), 
        value = this.value, 
        kw = this.kw, 
        varargs = this.varargs, 
        node = this.node 
    ] !NamedParameterPre
}
export def == (this: NamedParameter, other: NamedParameter) -> bool {
    return equals(this.tpe, other.tpe)
}
export def != (this: NamedParameter, other: NamedParameter) -> bool { 
    return not (this == other)
}

export def to_pre(vec: &Vector(NamedParameter)) -> &Vector(NamedParameterPre) {
    let res = vector::make(NamedParameterPre)
    for var param in vec {
        res.push(to_pre(param))
    }
    return res
}


export type State = struct {
    module: weak &toolchain::Module
    scope: &scope::Scope
    // Vector of Type
    function_stack: &Vector(&compiler::Function)
    in_defer: bool
    // If this is set to true, consteval doesn't perform the walk_top
    shallow_walk: bool
    current_variable: &scope::Value
    // TODO This should be a parameter but its currently too hard to fix
    block_implicit_conv: bool
    current_lambda: &compiler::Function
    context: &scope::Scope
}

export def get_context(state: &State) -> &toolchain::Module {
    if state.context { return state.context.module }
    return state.module
}

// This needs to be global state
var lambda_counter = 0
var counter = 0

def current_value(state: &State) -> &scope::Value {
    if state.current_variable {
        return state.current_variable
    }
    
    let len = vector::length(state.function_stack)
    for var i in 0..len {
        let j = state.function_stack.length - i - 1
        let fun = state.function_stack(j)
        if j > 0 {
            let parent = state.function_stack(j - 1)
            if parent.is_global {
                return fun.value
            }
        }
        if fun.is_global { 
            return fun.value
        }
    }
    return null
}

export def current_function(state: &State) -> &compiler::Function {
    let length = vector::length((@state).function_stack)
    if length == 0 {
        return null
    } else {
        return (@state).function_stack(length - 1)
    }
}

export def push_function(state: &State, function: &compiler::Function) {
    (@state).function_stack.push(function)
}

export def pop_function(state: &State) -> &compiler::Function {
    return vector::pop((@state).function_stack)
}

export def is_function(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::FUNCTION
}

export def is_closure(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::CLOSURE
}

export def is_function_pointer(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::POINTER and 
        is_function(tpe.tpe)
}

export def is_integer(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::WORD or 
        tpe.kind == TypeKind::BOOL or 
        tpe.kind == TypeKind::ENUM or
        tpe.kind == TypeKind::CHAR
}

export def is_arithmetic(tpe: &Type) -> bool {
    if not tpe { return false }
    return is_integer(tpe) or 
        tpe.kind == TypeKind::FLOAT
}

export def is_float(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::FLOAT
}

// TODO Also allow arrays and strings
export def is_boolean(tpe: &Type, scope: &scope::Scope) -> bool {
    if not tpe { return false }
    if tpe.kind == TypeKind::BOOL or
        tpe.kind == TypeKind::WORD or
        tpe.kind == TypeKind::FLOAT or
        tpe.kind == TypeKind::POINTER or
        tpe.kind == TypeKind::BYREF or
        tpe.kind == TypeKind::REFERENCE or
        tpe.kind == TypeKind::WEAK_REF or
        tpe.kind == TypeKind::CHAR or
        tpe.kind == TypeKind::CLOSURE {
        return true
    }
    return is_assignable(builtins::bool_, tpe, scope)
}

export def is_pointer(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::POINTER or 
        tpe.kind == TypeKind::BYREF
}

export def is_ref(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::REFERENCE
}


export def is_weak_ref(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::WEAK_REF
}

export def is_ref_or_weak(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::WEAK_REF or
        tpe.kind == TypeKind::REFERENCE
}

export def is_box(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::POINTER or
        tpe.kind == TypeKind::BYREF or
        tpe.kind == TypeKind::REFERENCE or
        tpe.kind == TypeKind::WEAK_REF or
        tpe.kind == TypeKind::STATIC_ARRAY or
        tpe.kind == TypeKind::ARRAY
}

export def is_struct(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::STRUCT or
        tpe.kind == TypeKind::UNION
}

export def is_struct_t(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::STRUCT
}

export def is_enum(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::ENUM
}

export def is_type(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::TYPE
}

export def is_array(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::ARRAY or
        tpe.kind == TypeKind::STATIC_ARRAY
}

export def is_array_t(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::ARRAY
}

export def is_static_array(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::STATIC_ARRAY
}

export def is_range(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::RANGE or
        tpe.kind == TypeKind::RANGE_INC
}

/*export def is_stub(tpe: &Type) -> bool {
    if not tpe { return true }
    return tpe.kind == TypeKind::STUB
}*/


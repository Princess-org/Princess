export def contains(a: &Type) -> &Set(TypeId) {
    if is_ref_or_weak(a) { a = a.tpe }
    let res = set::make(type TypeId)
    if not is_struct(a) { return res }
    for var field in @a.fields {
        if field.is_embed {
            res.add(field.tpe)
            res.add_all(contains(field.tpe))
        }
    }
    return res
}


// Returns true if a implements b
// b needs to be a structural type
export def implements(a: &Type, b: &Type, scpe: &scope::Scope, check_embed: bool = true) -> bool {
    if not a or not b { return false }

    if b.kind == TypeKind::REFERENCE and b.tpe and b.tpe.kind == TypeKind::INTERFACE {
        let implements = a.implements
        return implements and implements.contains(b.id)
    } else {
        assert b.kind == TypeKind::INTERFACE
    
        for var member in b.members {
            let params = vector::make(NamedParameter)
            params.push([ tpe = a.id ] !NamedParameter)
            for var param in member.parameter_t {
                params.push(param)
            }
            let fun = scope::get_function(scpe, parser::make_identifier(member.name), params, dry_run = true)
            if not fun { return false }
            if fun.fdef.return_t.length() != member.return_t.length() { return false }
            for var i in 0..fun.fdef.return_t.length() {
                if not equals(fun.fdef.return_t(i).resolve(scpe), member.return_t(i)) { 
                    return false 
                }
            }
        }

        return true
    }
}

// Returns true if b is assignable to a
export def is_assignable(a: &Type, b: &Type, scope: &scope::Scope) -> bool {
    return convert_type_score(a, b, scope) >= 0
}


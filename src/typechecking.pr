// TODO Not a deep copy
export def copy(a: &Type) -> &Type {
    if not a { return null }
    var t: &Type = @a

    if a.tc_args {
        t.tc_args = @a.tc_args
    }

    if a.kind == TypeKind::FUNCTION or 
        a.kind == TypeKind::CLOSURE {
        
        t.return_t = a.return_t.copy()
        t.parameter_t = a.parameter_t.copy()
    }

    return t
}

export def convert_type_score(a: &TypeRef, b: &Type, scpe: &scope::Scope, impl: bool = true) -> int {
    if not a and not b { return 0 }
    if not a or not b { return -1 }
    if a.tpe {
        return convert_type_score(a.tpe, b, scpe, impl)
    } else if a.pattern {
        let r = resolve_generic(a.pattern, scpe, error_on_fail = false)
        if r {
            return convert_type_score(r, b, scpe, impl)
        }
        return convert_type_score(a.pattern, b, scpe, impl)
    } else if a.name {
        let tpe = scope::get_type(scpe, parser::identifier_from_str(a.name))
        if tpe {
            return convert_type_score(tpe, b, scpe, impl)
        } else {
            return -1
        }
    } else {
        return convert_type_score(a.resolve(scpe), b, scpe, impl)
    }
}

export def convert_type_score(a: &Pattern, b: &Type, scpe: &scope::Scope, impl: bool = true) -> int {
    if a.kind == TypeKind::TYPE_DEF {
        if a.tpe {
            if convert_type_score(a.tpe, b, scpe, impl) > 0 {
                return 1
            } else { return -1 }
        } else if a.name {
            scope::create_type(scpe, parser::identifier_from_str(a.name), parser::ShareMarker::NONE, make_type_ref(b.id))
        }
        return 1
    }

    if a.kind == b.kind == TypeKind::STATIC_ARRAY {
        if a.length == b.length {
            return convert_type_score(a.tpe, b.tpe, scpe, impl)
        }
        return -1
    }

    if a.kind == TypeKind::ARRAY and b.kind == TypeKind::STATIC_ARRAY {
        let score = convert_type_score(a.tpe, b.tpe, scpe, impl)
        if score >= 0 { return 1 }
        return -1
    }
    if a.kind == b.kind and b.kind == TypeKind::STATIC_ARRAY {
        if a.length != b.length { return -1 }
        return convert_type_score(a.tpe, b.tpe, scpe, impl)
    }
    if a.kind == b.kind and is_box(b) {
        // Special case for interface implementation, because in the case of
        // &T implements &I where I is an interface, we can't simply unwrap the left hand side
        /*let intf = a.tpe.resolve(scpe, error_on_fail = false)
        if intf and intf.kind == TypeKind::INTERFACE {
            return convert_type_score(reference(intf), b, scpe, impl)
        }*/
        return convert_type_score(a.tpe, b.tpe, scpe, impl)
    }
    if a.kind == b.kind == TypeKind::TUPLE {
        if a.return_t.length != b.return_t.length { return -1 }
        var max_conv = 0 
        for var i in 0..a.return_t.length {
            let conv = convert_type_score(a.return_t(i), b.return_t(i), scpe, impl)
            if conv < 0 { return -1 }
            if conv > max_conv { max_conv = conv }
        }
        return max_conv
    }
    
    // TODO Make up some proper rules how conversions happen and implement that
    if a.kind == TypeKind::CLOSURE or a.kind == TypeKind::FUNCTION {
        var fun: &Type = null
        if is_pointer(b) and b.tpe and b.tpe.kind == TypeKind::FUNCTION {
            fun = resolve(b.tpe)
        } else if a.kind == b.kind == TypeKind::CLOSURE {
            fun = b
        }

        if fun {
            var max_conv = 2 if a.kind != b.kind else 0

            if fun.parameter_t.length != a.parameter_t.length { return -1 }
            if fun.return_t.length != a.return_t.length { return -1 }
            for var i in 0..fun.parameter_t.length {
                let param_a = a.parameter_t(i)
                let param_b = resolve(fun.parameter_t(i).tpe)
                let score = convert_type_score(param_a.tpe, param_b, scpe, impl)
                if score < 0 { return -1 }
                if score > max_conv { max_conv = score }
            }
            for var i in 0..fun.return_t.length {
                let ret_a = a.return_t(i)
                let ret_b = resolve(fun.return_t(i))
                let score = convert_type_score(ret_a.tpe, ret_b, scpe, impl)
                if score < 0 { return -1 }
                if score > max_conv { max_conv = score }
            }

            return max_conv
        } else { return -1 }
    }

    if a.kind == TypeKind::TYPE_INSTANCE {
        // Try to resolve a
        let tpe = a.resolve_generic(scpe, error_on_fail = false).resolve()
        if tpe {
            if tpe == b { return 0 }
            return -1
        } else if b.tc_args {
            var ares = a.tpe.resolve(scpe)
            // We need to recursively look up the type constructor,
            // because we might have cases like this:
            // type T(type T) = Y(T)
            if not ares { return -1 }

            loop {
                let rares = ares.resolve()
                if not rares or rares.kind != TypeKind::TYPE_CONSTRUCTOR { break }
                let node = rares.tc_node
                if not node or node.kind != parser::NodeKind::TYPE_CONSTRUCTOR {
                    break
                }
                
                if a.return_t.length != rares.parameter_t.length {
                    return -1
                }

                // Look up parameters
                let tmp_scope = scope::enter_scope(scpe)
                let state = make_state(scpe.module)
                state.scope = tmp_scope
                for var i in 0..a.return_t.length {
                    let t = a.return_t(i)
                    let name = rares.parameter_t(i).name
                    scope::create_type(state.scope, parser::make_identifier(name), parser::ShareMarker::NONE, t)
                }
                a = type_lookup(rares.tc_node, state).pattern
                ares = a.tpe.resolve(scpe)
            }

            if ares != b.tc_tpe {
                return -1 
            }
            for var i in 0..a.return_t.length {
                let tpe_a = a.return_t(i)
                let tpe_b = b.tc_args(i)
                if convert_type_score(tpe_a, tpe_b, scpe, impl) < 0 { 
                    return -1 
                }
            }
            return 1
        }
        
    }
   
    return -1
}


const IMPLICIT = 15

// TODO This isn't very reliable. Especially when returning bigger numbers than 1, integer conversions can interfere with to reference
// Tries to convert type b to type a
// The return value is -1 if b can't be converted to a
// if the types are equal, 0 is returned.
// Otherwise a positive integer is returned.
export def convert_type_score(a: &Type, b: &Type, scpe: &scope::Scope, impl: bool = true) -> int {
    if not a and not b { return 0 }
    if not a or not b { return -1 }
    if a.id == b.id {
        return 0
    }

    // Force impls when converting to an interface reference
    if impl and a and a.kind == TypeKind::REFERENCE and a.tpe and a.tpe.kind == TypeKind::INTERFACE {
        if not (b.implements and b.implements.contains(a.id)) {
            scope::trigger_impl(scpe, b)
        }
    }

    // If both are either refs or pointers
    if is_pointer(a) and is_pointer(b) and equals(a.tpe, b.tpe) {
        return 2
    }

    // Convert anonymous struct to value
    if a.kind == b.kind and b.kind == TypeKind::STRUCT and b.is_anon {
        if a.fields.length() != b.fields.length() { return -1 }
        for var af in a.fields {
            var found = false
            for var bf in b.fields {
                if equals(af.tpe, bf.tpe) and af.name == bf.name {
                    found = true
                    break
                }
            }
            if not found { return -1 }
        }
        return 11
    }

    if a.kind == TypeKind::UNDEF or b.kind == TypeKind::UNDEF { return 0 }

    if (a.kind == TypeKind::REFERENCE or a.kind == TypeKind::WEAK_REF) and 
        (b.kind == TypeKind::REFERENCE or b.kind == TypeKind::WEAK_REF) and 
        (equals(a.tpe, b.tpe) or not a.tpe) {

        return 0 if a.kind == b.kind else 3
    }
    if a.kind == TypeKind::TUNION {
        if b.kind == TypeKind::TUNION {
            for var v in b.return_t {
                if not has_variant(a, v) { return -1 }
            }
            return 2
        } else if has_variant(a, b) {
            return 3
        }
    }

    // Embedded structs
    if b.kind == TypeKind::STRUCT or (is_ref(b) and is_struct_t(b.tpe)) {
        var nb = b.tpe.resolve() if is_ref(b) else b
        for var field in nb.fields {
            if field.properties.is_embed {
                if equals(field.tpe, a) {
                    return 7
                } else if is_ref(a) and equals(field.tpe, a.tpe) {
                    return 8
                }
            }
        }
    }

    // We need to check if they are actually compatible elsewhere
    /*if a.kind == TypeKind::TYPE_DEF {
        return convert_type_score(a.tpe, b, module)
    }*/
    if a.kind == TypeKind::TYPE and b.kind == TypeKind::TYPE /*or b.may_be_type*/ { 
        return 4
    }
    if equals(a, builtins::reflection_type_t()) and b.kind == TypeKind::TYPE and b.tpe {
        return 4
    }
    if (is_pointer(a) or a.kind == TypeKind::REFERENCE or a.kind == TypeKind::WEAK_REF) and (@b).kind == TypeKind::NULL {
        return 0
    }
    if a.kind == TypeKind::REFERENCE and equals(a.tpe, b) {
        return 5
    }
    if a.kind == TypeKind::REFERENCE and (a.tpe == null or equals(b, builtins::ref_t())) {
        return 6
    }
    if a.kind == TypeKind::REFERENCE and a.tpe and is_array_t(a.tpe) and b.kind == TypeKind::STATIC_ARRAY and a.tpe.tpe == b.tpe {
        return 6
    }
    if equals(a, builtins::ref_t()) and b.kind == TypeKind::REFERENCE {
        return 6
    }
    if ((@a).kind == TypeKind::WORD or a.kind == TypeKind::CHAR) and 
        ((@b).kind == TypeKind::WORD or b.kind == TypeKind::CHAR) and
        (@a).size >= (@b).size {
        
        // TODO if we are ever going to allow a 24 bit value this is going to fail
        return log2((@a).size) !int - log2((@b).size) !int + 3
    }
    if (@a).kind == TypeKind::FLOAT and (@b).kind == TypeKind::FLOAT {
        // TODO This works because there are only two float sizes
        return 4
    }
    if (@a).kind == TypeKind::FLOAT and
        ((@b).kind == TypeKind::WORD or b.kind == TypeKind::CHAR) {
        return 10
    }
    if (is_pointer(a) and is_pointer(b) or
        (@a).kind == TypeKind::REFERENCE and (@b).kind == TypeKind::REFERENCE) and
        (@a).tpe == null {
        
        return 4
    }
    /*if a.kind == TypeKind::POINTER and b.kind == TypeKind::POINTER or
        a.kind == TypeKind::BYREF and b.kind == TypeKind::BYREF or
        a.kind == TypeKind::REFERENCE and b.kind == TypeKind::REFERENCE or
        a.kind == TypeKind::WEAK_REF and b.kind == TypeKind::WEAK_REF or
        a.kind == TypeKind::ARRAY and b.kind == TypeKind::ARRAY or
        a.kind == TypeKind::STATIC_ARRAY and b.kind == TypeKind::STATIC_ARRAY {

        if a.tpe and a.tpe.kind == TypeKind::GENERIC {
            let score = convert_type_score(a.tpe, b.tpe, module)
            if score >= 0 {
                return score
            }
        }
    }*/ 

    if a.kind == TypeKind::TUPLE and b.kind == TypeKind::STATIC_ARRAY and a.return_t.length == b.length {
        var max_conv = 1
        for var tpe in a.return_t {
            let conv = convert_type_score(b.tpe, tpe, scpe, impl)
            if conv > max_conv { max_conv = conv }
            else if conv == -1 { max_conv = -1; break }
        }
        if max_conv >= 0 { return max_conv }
    }

    if a.kind == TypeKind::STATIC_ARRAY and b.kind == TypeKind::STATIC_ARRAY {
        if equals(a.tpe, b.tpe) and 
            (a.length == b.length or a.length !uint64 == std::MAX_UINT64) {
            return 0
        }
    }
    if a.kind == TypeKind::STATIC_ARRAY and b.kind == TypeKind::TUPLE {
        var max_conv = 1
        for var tpe in b.return_t {
            let conv = convert_type_score(a.tpe, tpe, scpe, impl)
            if conv > max_conv {
                max_conv = conv
            } else if conv == -1 {
                max_conv = -1
                break
            }
        }

        if max_conv >= 0 {
            if a.length !uint64 == std::MAX_UINT64 { return max_conv }
            if b.return_t.length == a.length { return max_conv }
        }
    }
    if (@a).kind == TypeKind::ARRAY {
        if (@b).kind == TypeKind::STATIC_ARRAY and equals((@a).tpe, (@b).tpe) {
            return 1
        }
        if (@a).tpe == null and ((@b).kind == TypeKind::ARRAY or (@b).kind == TypeKind::STATIC_ARRAY) {
            return 1
        }
        if b.kind == TypeKind::TUPLE {
            var max_conv = 1
            for var tpe in b.return_t {
                let conv = convert_type_score(a.tpe, tpe, scpe, impl)
                if conv > max_conv {
                    max_conv = conv
                } else if conv == -1 {
                    max_conv = -1
                }
            }
            if max_conv >= 0 { return max_conv }
        }
    }
    /*if a.kind == TypeKind::GENERIC {
        if a.kind != b.kind {
            if b.tc_args and equals(a.tpe, b.tc_tpe) {
                if vector::length(a.tc_args) != vector::length(b.tc_args) { return -1 }
                for var i in 0..vector::length(a.tc_args) {
                    let arg_a = a.tc_args(i)
                    let arg_b = b.tc_args(i)
                    if arg_a.kind == TypeKind::TYPE_DEF { continue }
                    if not equals(arg_a, arg_b) { return -1 }
                }
                return 3
            } else {
                return 3 if infer_interface_types(a, b, scope) != null else -1
            }
        } else {
            return 0 if equals(a.tpe, b.tpe) else -1
        }
    }*/
    if a.kind == TypeKind::CLOSURE and b.kind == TypeKind::CLOSURE /*and b.is_anon */ {
        if vector::length(a.parameter_t) != vector::length(b.parameter_t) {
            return -1
        }
        for var i in 0..vector::length(a.parameter_t) {
            let param_a = a.parameter_t(i)
            let param_b = b.parameter_t(i)
            if not equals(param_a.tpe, param_b.tpe) and not equals(param_b.tpe, to_infer) {
                return -1
            }
        }
        // If we have a return type we're going to check them
        var has_right_return_types = false
        if b.return_t.length > 0 {
            if vector::length((@a).return_t) != vector::length((@b).return_t) {
                return -1
            }
            for var i in 0..vector::length((@a).return_t) {
                if not equals(a.return_t(i), b.return_t(i)) {
                    return -1
                }
            }
            has_right_return_types = true
        } else if a.return_t.length == 0 {
            has_right_return_types = true
        }

        return 2 if has_right_return_types else 3
    }
    if a.kind == TypeKind::CLOSURE and is_pointer(b) and is_function(b.tpe) {
        b = b.tpe.resolve()
        if vector::length(a.parameter_t) != vector::length(b.parameter_t) {
            return -1
        }
        for var i in 0..vector::length(a.parameter_t) {
            let param_a = a.parameter_t(i)
            let param_b = b.parameter_t(i)
            if not equals(param_a.tpe, param_b.tpe) {
                return -1
            }
        }
        if vector::length(a.return_t) != vector::length(b.return_t) {
            return -1
        }
        for var i in 0..vector::length(a.return_t) {
            if not equals(a.return_t(i), b.return_t(i)) {
                return -1
            }
        }
        return 2
    }
    
    if impl and a.kind != TypeKind::TYPE {
        let parameter_t = vector::make(NamedParameter)
        parameter_t.push([ tpe = b.id ] !NamedParameter)
        let conv = scope::find_implicit_function(scpe, parameter_t, a, not consteval::is_static)
        if conv {
            if consteval::is_static {
                consteval::compile_function(conv, scpe, parameter_t)
            }
            return IMPLICIT
        }
    }

    if a.kind == TypeKind::INTERFACE or (a.kind == TypeKind::REFERENCE and a.tpe and a.tpe.kind == TypeKind::INTERFACE) {
        if a.kind == TypeKind::REFERENCE and b.kind == TypeKind::REFERENCE {
            if b.tpe and b.tpe.kind == TypeKind::NULL or implements(b.tpe, a, scpe) {
                return 6
            }
        }
        if a.kind == TypeKind::REFERENCE and implements(reference(b.id), a, scpe) { return 6 }
        if a.kind == TypeKind::REFERENCE and implements(b, a, scpe) { return 6 }
        if implements(b, a, scpe) { return 1 } // This is so that new specializations always win
    }

    /*if is_type { 
        if a.kind == TypeKind::ARRAY {
            if (b.kind == TypeKind::ARRAY or b.kind == TypeKind::STATIC_ARRAY) {
                return convert_type_score(a.tpe, b.tpe, module, true)
            }
            return -1
        }
        if is_pointer(a) or a.kind == TypeKind::REFERENCE or a.kind == TypeKind::WEAK_REF or a.kind == TypeKind::STATIC_ARRAY {
            if a.kind == b.kind {
                return convert_type_score(a.tpe, b.tpe, module, true)
            }
            if convert_type_score(a.tpe, b, module, true) >= 0 {
                return 10
            }
            return -1
        }
        return 1
    }*/
    return -1
}

export def get_type_constructor(tpe: &Type) -> &Type {
    if not tpe { return null }
    if tpe.tc_tpe { return tpe.tc_tpe }
    /*if tpe.kind == TypeKind::GENERIC {
        return tpe.tpe
    }*/
    if is_box(tpe) {
        return get_type_constructor(tpe.tpe)
    }
    return null
}

export def get_generic(tpe: &Type) -> &Type {
    if not tpe { return null }
    if tpe.tc_args { return tpe }
    if is_box(tpe) {
        return get_generic(tpe.tpe)
    }
    return null
}

export def is_polymorph(fdef: FunctionDef) -> bool {
    assert fdef.context
    return is_polymorph(fdef.parameter_t, fdef.context.scope)
}

export def is_polymorph(tpe: &TypeRef, scpe: &scope::Scope) -> bool {
    tpe = tpe.copy() // Don't mutate type
    if not tpe { return false }
    if tpe.tpe {
        let res = tpe.tpe.resolve()
        if not res { return false } // Do we return false here?
        if res.kind == TypeKind::INTERFACE or res.kind == TypeKind::TYPE_DEF {
            return true
        }
        return false
    } else if tpe.pattern {
        let pattern = tpe.pattern
        if pattern.kind == TypeKind::TYPE_DEF {
            return true
        } else if pattern.kind == TypeKind::POINTER or
            pattern.kind == TypeKind::STATIC_ARRAY or pattern.kind == TypeKind::ARRAY {
            return is_polymorph(pattern.tpe, scpe)
        } else if pattern.kind == TypeKind::REFERENCE {
            if pattern.tpe and pattern.tpe.kind == TypeKind::INTERFACE {
                return false
            } else {
                return is_polymorph(pattern.tpe, scpe)
            }
        } else if pattern.kind == TypeKind::TUPLE or 
            pattern.kind == TypeKind::TUNION or 
            pattern.kind == TypeKind::TYPE_INSTANCE {
                
            for var tpe in pattern.return_t {
                if is_polymorph(tpe, scpe) { return true }
            }
            return false
        }
    } else if tpe.name {
        //let tpe = scope::get_type(scpe, parser::identifier_from_str(tpe.name), error_on_fail = false)
        //if tpe {
        //    return is_polymorph(tpe, scpe, or_name)
        //}
        return false
    }
    return false
}

/*export def is_polymorph(tpe: &Type, is_ref: bool = false) -> bool {
    if not tpe { return false }
    else if tpe.tc_incomplete {
        return true
    } else if tpe.kind == TypeKind::STRUCTURAL {
        return not is_ref 
    } else if tpe.tc_args {
        return tpe.tc_incomplete
    } else if tpe.kind == TypeKind::TYPE_DEF {
        return true
    } else if tpe.kind == TypeKind::GENERIC {
        return tpe.tc_incomplete
    } else if tpe.kind == TypeKind::TYPE {
        return tpe.tpe == null
    } else if tpe.kind == TypeKind::POINTER or
        tpe.kind == TypeKind::STATIC_ARRAY or tpe.kind == TypeKind::ARRAY {
        return is_polymorph(tpe.tpe)
    } else if tpe.kind == TypeKind::REFERENCE {
        return is_polymorph(tpe.tpe, true)
    } else if tpe.kind == TypeKind::FUNCTION {
        return is_polymorph(tpe.parameter_t)
    } else if tpe.kind == TypeKind::TUPLE {
        for var tpe in tpe.return_t {
            if is_polymorph(tpe) { return true }
        }
        return false
    }
    return false
}*/

export def is_polymorph(args: &Vector(NamedParameterPre), scpe: &scope::Scope) -> bool {
    for var i in 0..vector::length(args) {
        let np = args(i)
        if is_polymorph(np.tpe, scpe) {
            return true
        }
    }
    return false
}

// NOTE: This function mutates param_a and return_t, watch out!
export def replace_type_defs(
    param_a: &Vector(NamedParameterPre), 
    return_t: &Vector(&TypeRef), 
    param_b: &Vector(NamedParameter), 
    scpe: &scope::Scope,
    replace: bool = true,
    impl: bool = true) {

    for var i in 0..vector::length(param_a) {
        let left = param_a.get(i)
        var right: *NamedParameter = null
        for var j in 0..vector::length(param_b) {
            let r = param_b.get(j)
            if r.name and r.name == left.name {
                right = r
                break
            }
        }
        if not right and i < vector::length(param_b) {
            right = param_b.get(i)
        }

        var rtpe: TypeId
        if right {
            rtpe = right.tpe
        }
        if not right and left.value {
            rtpe = left.value.tpe
        }

        if left.kw == parser::VarDecl::TYPE and rtpe and rtpe.kind == TypeKind::TYPE {
            // Don't equate types that aren't the same
            if left.tpe and left.tpe.tpe {
                let left_tpe = left.tpe.tpe.resolve().tpe
                let right_tpe = rtpe.tpe
                if not equals(left_tpe, right_tpe) { return }
            }

            // We have a type parameter, create it in scope and continue
            left.tpe = make_type_ref(rtpe)
            scope::create_type(
                scpe, 
                parser::make_identifier(left.name), 
                parser::ShareMarker::NONE, 
                make_type_ref(rtpe.tpe)
            )
            continue
        }

        if not rtpe { return }
        if convert_type_score(left.tpe.copy(), rtpe, scpe, impl) < 0 { return }

        /*let intf = get_interface(ltpe.tpe)
        if intf and replace {
            left.tpe = rtpe
            continue
        }*/

        /*if ltpe.kind == TypeKind::TYPE {
            if ltpe.name and right and right.value and replace {
                types_map(ltpe.name) = right.value.value_tpe
                ltpe.tpe = right.value.value_tpe
            }
        } else {
            find_type_defs(module, ltpe, rtpe, types_map, replace)
            left.tpe = ltpe
        }*/

        if replace {
            if is_polymorph(left.tpe, scpe)  {
                left.tpe = make_type_ref(rtpe)
            } else {
                left.tpe = make_type_ref(left.tpe.copy().resolve(scpe))
            }
        }
    }

    // Resolve return types
    for var i in 0..vector::length(return_t) {
        let cpy = return_t(i).copy()
        let rtpe = resolve(cpy, scpe)
        return_t(i) = make_type_ref(rtpe)
    }
}

export def parameter_equals(
    a: FunctionDef, param_b: &Vector(NamedParameterPre), scpe: &scope::Scope) -> bool {
        
    if a.parameter_t.length != vector::length(param_b) {
        return false
    }
    let env = make_eq_env(scpe)
    for var i in 0..vector::length(param_b) {
        let left = param_b(i)
        let right = a.parameter_t(i)
        let e = parameter_equals_single(left.tpe, right.tpe, env)
        //print(generic_to_string(left.tpe), " == ", generic_to_string(right.tpe), " = ", e, "\n")
        if not e {
            return false
        }
    }
    return true
}

def parameter_equals_single(a: &TypeRef, b: &TypeRef, env: &EqEnv) -> bool {
    if not env { return a == b }
    if is_type(a) and is_type(b) {
        return a == b
    } else if is_type(a) {
        let tb = b.copy().resolve(env.scope, error_on_fail = false)
        return tb == a.tpe
    } else if is_type(b) {
        let ta = a.copy().resolve(env.scope, error_on_fail = false)
        return ta == b.tpe
    } else if a.name and b.name {
        if env.typedefs_a.contains(a.name) and env.typedefs_b.contains(b.name) {
            return env.typedefs_a(a.name) == env.typedefs_b(b.name)
        } else if env.typedefs_a.contains(a.name) or env.typedefs_b.contains(b.name) {
            return false
        } else {
            return a.name == b.name
        }
    } else if a.name {
        let ta_r = a.copy().resolve(env.scope, error_on_fail = false)
        if ta_r { return ta_r == b.copy().resolve(env.scope, error_on_fail = false) } 
        return false
    } else if b.name {
        let tb_r = b.copy().resolve(env.scope, error_on_fail = false)
        if tb_r { return tb_r == a.copy().resolve(env.scope, error_on_fail = false) } 
        return false
    } else {
        let pa = a.pattern
        let pb = b.pattern
        if not pa and not pb { return true }
        if not pa or not pb { return false }
        return equals(pa, pb, env)
    }
}

export def overload_score(
    a: FunctionDef, param_b: &Vector(NamedParameter), scpe: &scope::Scope, 
    positional: bool, partial: bool = false, impl: bool = true) -> int {
    
    return overload_score(
        a.parameter_t, a.return_t, param_b, scpe, 
        positional, partial, impl
    )
}

// Calculates a score for overload resultion, the result is 0 for an exact match
// and a positive integer if the argument types need to be converted.
// -1 is returned if the argument types don't match.

export def overload_score(
    param_a: &Vector(NamedParameterPre), 
    return_t: &Vector(&TypeRef), 
    param_b: &Vector(NamedParameter),
    scpe: &scope::Scope, 
    positional: bool, partial: bool = false,
    impl: bool = true
) -> int {
    
    let param_a2 = vector::make(NamedParameterPre)
    for var np in param_a {
        param_a2.push(np.copy())
    }
    param_a = param_a2

    let return_t2 = vector::make(&TypeRef)
    for var rt in return_t {
        return_t2.push(rt.copy())
    }
    return_t = return_t2

    if vector::length(param_a) > vector::length(param_b) and not partial {
        let a = param_a(vector::length(param_b))
        let not_default_param = a.value == null or a.tpe.kind == TypeKind::TYPE
        if vector::length(param_a) == vector::length(param_b) + 1 {
            if not vector::peek(param_a).varargs and not_default_param {
                return -1
            }
        } else if not_default_param {
            return -1
        }
    }

    replace_type_defs(param_a, return_t, param_b, scpe, false, impl = impl)

    var sum = 0
    for var i in 0..vector::length(param_b) {
        let right = param_b(i)
        var left: *NamedParameterPre = null
        if right.name and not positional {
            for var i in 0..vector::length(param_a) {
                let param = param_a.get(i)
                if right.name == param.name {
                    left = param
                    break
                }
            }
            if not left { return -1 }
        } else {
            if i < vector::length(param_a) {
                left = param_a.get(i)
            } else if vector::length(param_a) > 0 {
                left = param_a.get(param_a.length - 1)
                if not left.varargs {
                    return -1
                } 
            } else {
                return -1
            }
        }
        var lvalue = left.tpe
        if i == vector::length(param_a) - 1 and 
            left.varargs and not right.varargs and left.tpe and
            convert_type_score(array(left.tpe, parser::VarDecl::VAR), right.tpe, scpe, impl = impl) >= 0 {

            lvalue = array(left.tpe, parser::VarDecl::VAR)
        }
        var score = -1
        if left.kw == parser::VarDecl::TYPE {
            if kind(right.tpe) == TypeKind::TYPE {
                if not left.tpe.tpe { score = 4 }
                else {
                    let left_tpe = left.tpe.tpe.resolve().tpe
                    let right_tpe = right.tpe.tpe

                    if not equals(left_tpe, right_tpe) { score = -1 }
                    else { score = 0 }
                }
            }
        } else {
            if left.varargs and not lvalue { score = 0 }
            else {
                score = convert_type_score(lvalue, right.tpe, scpe, impl = impl)
            }
        }
        if score < 0 { return -1 }
        sum += score
    }

    /*if is_polymorph(param_a) and not is_polymorph(param_b) and sum >= 0 {
        // Penalty for specialization
        sum += 1
    }*/
    return sum
}

export def mangle_function_name(name: Str, parameter_t: &Vector(NamedParameterPre), test: bool = false, context: &toolchain::Module = null) -> Str {
    var res = name
    if context {
        res = context.module + "#" + name
    }
    res += "::("

    let len = vector::length(parameter_t)
    for var i in 0..len {
        let np = parameter_t(i)
        if np.varargs and not np.tpe {
            res += "..."
            break
        }
        if np.varargs {
            res += '['
        }
        if np.tpe.tpe {
            res += debug::type_to_str(np.tpe.tpe, true)
        } else if np.tpe.pattern {
            res += generic_to_string(np.tpe.pattern)
        } else if np.tpe.name {
            res += "type " + np.tpe.name
        } else { assert }

        if np.varargs {
            res += ']'
        }
        if i < len - 1 {
            res += ", "
        }
    }
    res += ')'

    if test {
        res = "__test::" + res
    }

    return res
}

// TODO Move this into parser
export def last_ident_to_str(node: &parser::Node) -> String {
    if not node { return "" }
    assert(node.kind == parser::NodeKind::IDENTIFIER)
    if vector::length(node.value.identifier.path) > 1 {
        errors::errorn(node, "Expected plain identifier without path")
    }
    return node.value.identifier.path(0)
}

def flatten_return_type(node: &parser::Node, return_t: &Vector(TypeId)) -> TypeId {
    let len = vector::length(return_t) 
    if len > 1 {
        // TODO size and alignment! Same as a struct,
        // also refactor type_lookup and compiler (functions with multiple return types)
        // into a single function for calculating the size and alignmenet of a struct
        let return_tpe = tuple(return_t)
        return return_tpe
    } else if len == 1 {
        return vector::peek(return_t)
    }

    return void.id
}

def check_is_identifier_assignable(node: &parser::Node, state: &State) -> bool {
    if node.kw != parser::VarDecl::VAR {
        errors::errorn(node, "Assignment to non var")
        return false
    }
    return true
}

export def make_union_type(fields: &Vector(StructMemberPre), const_fields: &Vector(StructMemberPre) = null) -> &TypeRef {
    let pattern = [ kind = TypeKind::UNION, fields = fields, const_fields = const_fields ] !&Pattern
    return make_type_ref(pattern)
}

export def make_union_type(fields: &Vector(StructMember), const_fields: &Vector(StructMember) = null) -> &Type {
    let tpe = [] !&Type
    tpe.kind = TypeKind::UNION
    let field_types = vector::make(TypeMember)
    
    var size = 0 !size_t
    var align = 1 !size_t
    var biggest_type: TypeId
    for var i in 0..fields.length() {
        let field = fields(i)
        var field_tpe = field.tpe.resolve()
        if field_tpe {
            if field_tpe.size > size {
                size = field_tpe.size
                biggest_type = field_tpe.id
            }
            // TODO No node, no error, catch this somewhere before calling this function
            /*if field_tpe.kind == TypeKind::TYPE_CONSTRUCTOR {
                errors::errorn(field.node, "Can't use type constructor as field type")
            }*/
            // TODO Alignment of bit fields on Windows is strange
            align = max(field_tpe.align, align) !size_t
        }
    }

    let type_member = [ tpe = biggest_type, offset = 0 ] !TypeMember
    field_types.push(type_member)

    tpe.name = "<anonymous>"
    tpe.size = size
    tpe.align = align
    tpe.fields = fields
    tpe.const_fields = (const_fields if const_fields else vector::make(StructMember))
    tpe.field_types = field_types

    return tpe
}

export def make_struct_type(fields: &Vector(StructMemberPre), const_fields: &Vector(StructMemberPre) = null) -> &TypeRef {
    let pattern = [ kind = TypeKind::STRUCT, fields = fields, const_fields = const_fields ] !&Pattern
    return make_type_ref(pattern)
}

export def make_struct_type(fields: &Vector(StructMember), const_fields: &Vector(StructMember) = null, struct_tpe: &Type = null) -> &Type {
    if not struct_tpe {
        struct_tpe = [] !&Type
    }
    struct_tpe.kind = TypeKind::STRUCT
    
    let field_types = vector::make(TypeMember)

    var j = 0
    var bit_offset = 0
    var bit_type: &Type = null

    for var i in 0..fields.length() {
        let field = fields.get(i)
        let tpe = field.tpe.resolve()
        if not tpe { continue }
        field.index = j

        // TODO We don't have the node anymore so this needs to be done elsewhere
        /*if tpe.kind == TypeKind::TYPE_CONSTRUCTOR {
            errors::errorn(field.node, "Can't use type constructor as field type")
            continue
        }*/

        if field.properties.is_bitfield {
            #if defined WIN32 {
                // TODO Windows
                bit_type = tpe
                continue
            } else {
                // Linux
                if not bit_type {
                    bit_type = tpe
                }
                if bit_offset + field.properties.bit_size < bit_type.size * 8 {
                    // Go back and extend the type
                    if tpe.size > bit_type.size {
                        bit_type = tpe
                    }
                    field.properties.bit_offset = bit_offset
                    bit_offset += field.properties.bit_size
                    continue
                } else {
                    // It doesn't fit so let's make a new entry
                    field_types.push([
                        tpe = bit_type.id
                    ] !TypeMember)

                    bit_type = tpe
                    bit_offset = 0
                    field.properties.bit_offset = 0

                    j += 1
                    continue
                }
            }
        } else {
            if bit_type {
                field_types.push([
                    tpe = bit_type.id
                ] !TypeMember)
                j += 1
            }

            field.index = j
            
            field_types.push([
                tpe = tpe.id
            ] !TypeMember)

            bit_type = null
            bit_offset = 0

            j += 1
        }
    }

    if bit_type {
        field_types.push([
            tpe = bit_type.id
        ] !TypeMember)
    }

    var offset = 0 !size_t
    var align = 1 !size_t

    for var type_member in field_types.iterate_ref() {
        let tpe = type_member.tpe.resolve()
        if tpe.align > 0 {
            offset = (ceil(offset / tpe.align !double) * tpe.align) !int
            align = util::lcm(align !int, tpe.align !int)
        }

        type_member.offset = offset
        offset += tpe.size
    }

    offset = (ceil(offset / align !double) * align) !int

    struct_tpe.name = "<anonymous>"
    // type_name is set up later
    struct_tpe.size = offset
    struct_tpe.align = align
    struct_tpe.fields = fields
    struct_tpe.const_fields = const_fields if const_fields else vector::make(StructMember)
    struct_tpe.field_types = field_types

    return struct_tpe
}

def lookup_type_constructor(tc: &parser::Node, node: &parser::Node, state: &State) -> &Type {
    if not node { return null }
    let name = tc.value.type_constructor.name
    let tpe = [ kind = TypeKind::TYPE_CONSTRUCTOR ] !&Type
    tpe.name = parser::identifier_to_str(name)
    tpe.type_name = append_module(tpe.name, node.loc.module)
    tpe.parameter_t = vector::make(NamedParameter)

    let args = tc.value.type_constructor.args
    for var i in 0..vector::length(args) {
        let arg = args(i)
        assert arg.kind == parser::NodeKind::PARAMETER
        tpe.parameter_t.push([ 
            name = parser::identifier_to_str(arg.value.param.name) 
        ] !NamedParameter)
    }
    tpe.tc_node = node
    tpe.tc_node.module = state.module
    tpe.defmodule = state.module
    //tpe.cache = map::make(TypeRef, type &Type)

    return tpe
}


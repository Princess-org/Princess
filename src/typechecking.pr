export def contains(a: &Type) -> &Set(TypeId) {
    if is_ref_or_weak(a) { a = a.tpe }
    let res = set::make(type TypeId)
    if not is_struct(a) { return res }
    for var field in a.fields {
        if field.properties.is_embed {
            res.add(field.tpe)
            res.add_all(contains(field.tpe))
        }
    }
    return res
}

export def is_setter(mb: StructuralTypeMember) -> bool {
    return mb.name.starts_with("__set_") and mb.name.ends_with("__")
}

export def is_getter(mb: StructuralTypeMember) -> bool {
    return mb.parameter_t.length == 0
}


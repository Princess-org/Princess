export type TypeKind = enum {
    UNSET
    BOOL
    WORD
    FLOAT
    STRUCT
    UNION
    ARRAY
    STATIC_ARRAY
    POINTER
    REFERENCE
    WEAK_REF
    FUNCTION
    CLOSURE
    ENUM
    CHAR
    INTERFACE
    TUNION
    TUPLE
    TYPE
    OPAQUE
    // This is a type with arguments
    TYPE_CONSTRUCTOR
    // Forward declaration
    // STUB
    // Placeholder for arguments with polymorphic type parameter in function definition
    TYPE_DEF
    BYREF // ref parameter   
    RANGE // TODO Ranges should be a concrete Type defined by the stdlib
    RANGE_INC
    // Used for enums
    // NAMESPACE
    // Auto cast, this type will convert to anything
    // AUTO_CAST // TODO Actually implement this
    NULL
    UNDEF
    // This is used as a function parameter that is generic
    // GENERIC
    // References to structs are using a wk reference, ie. Type::wk instead of Type::_tpe
    // This is because references to structs can cause cycles
    // TODO I think we don't really need this because we can just use wk directly
    BOX
    VOID
    TO_INFER // Placeholder type for inference
}

export type TypeMember = struct {
    tpe: TypeId
    offset: size_t
}

export type StructMember = struct {
    // Source line
    line: int
    node: weak &parser::Node
    name: Str
    tpe: TypeId
    // index into the field_types vector
    index: size_t

    is_bitfield: bool
    bit_size: size_t
    bit_offset: size_t

    is_embed: bool
    is_const: bool
    value: &compiler::Value
}

export type StructuralTypeMember = struct {
    name: Str
    // Vector of NamedParameter
    parameter_t: &Vector(NamedParameter)
    // Vector of Type
    return_t: &Vector(TypeId)
}

def make_type_member(name: Str, parameter_t: &Vector(NamedParameter), return_t: &Vector(TypeId)) -> StructuralTypeMember {
    return [
        name = name,
        parameter_t = parameter_t,
        return_t = return_t 
    ] !StructuralTypeMember
}

export type TypeId = int64
export def hash(id: TypeId) -> uint64 {
    return id !uint64
}
export def tpe(id: TypeId) -> TypeId {
    return resolve(id).tpe
}
export def kind(id: TypeId) -> TypeKind {
    return resolve(id).kind
}
export def type_name(id: TypeId) -> Str {
    return resolve(id).type_name
}
export def name(id: TypeId) -> Str {
    return resolve(id).name
}

export type Type = struct {
    id: TypeId

    kind: TypeKind
    defmodule: weak &toolchain::Module
    // Name of the type as used by the source code
    // Might be the name of a typedef
    name: Str
    // Unique name of the type
    type_name: Str
    // Size in bytes
    size: size_t
    align: size_t
    unsig: bool
    // Static array
    length: size_t
    kw: parser::VarDecl
    // Type both used for array/pointer and enum
    // This is also used for type arguments to specify the actual type
    // And tagged unions carry the underlying union type
    tpe: TypeId
    packed: bool
    // Fields for struct, array of StructMember
    fields: &[StructMember]
    // Constants
    const_fields: &[StructMember]
    // Vector of TypeMember
    field_types: &Vector(TypeMember)
    // Function and Tuple
    return_t: &Vector(TypeId)
    // Vector of NamedParameter
    parameter_t: &Vector(NamedParameter)
    // Enum scope
    scope: &scope::Scope
    // Structural types
    members: &Vector(StructuralTypeMember)
    // Type constructors save a template of a type
    tc_node: weak &parser::Node
    // Cache of specialized type constructor
    //cache: &Map(TypeRef, &Type)
    // Type constructor instances have a type and arguments
    tc_tpe: TypeId
    // Vector of Type, also used by GENERIC
    tc_args: &Vector(TypeId)
    // True if some parameters weren't set yet
    //tc_incomplete: bool
    // null means any for variant
    //variants: &Set(TypeId)
    // This is set so that we can find dependencies of functions
    // by looking at the values that defined the types
    svalue: weak &scope::Value

    // This is used by deserialization to check if a type is in the
    // type cache, so that structs can keep a wk reference to the type
    //is_in_type_cache: bool
    // Set on type arguments
    //is_type_argument: bool
    
    // Interface implementation
    intf: TypeId
    // This gets set if it might also be a type argument, in that case we also consider the overload with a type
    // As an example, consider [int], this might be an array of types or an array type
    //may_be_type: &Type
    // True if this is an anonymous struct
    is_anon: bool

    // constructor and destructor meta data
    has_constructor: Ternary
    has_user_defined_constructor: Ternary
    constructor: &scope::Value

    has_destructor: Ternary
    has_builtin_destructor: Ternary
    destructor: &scope::Value
    builtin_destructor: &scope::Value

    // Members for structural Types
    functions: &Vector(TypeEntryMember)
    //cached: &Map(TypeId, CacheEntry)
}

export def has_variant(this: &Type, tpe: &Type) -> bool {
    assert this.kind == TypeKind::TUNION
    for var t in this.return_t {
        if t == tpe.id { return true }
    }
    return false
}

export def hash(tpe: &Type) -> uint64 {
    return tpe.id
}

export type Ternary = enum {
    UNDEFINED
    TRUE
    FALSE
}

export type Generic = struct {
    kind: TypeKind
    length: size_t
    tpe: TypeId
    name: Str
    generic: &Generic
    parameter_t: &Vector(&Generic)
    // Also used for type constructors
    return_t: &Vector(&Generic)
}

export def is_type(generic: &Generic) -> bool {
    return generic.tpe and generic.kind != TypeKind::TYPE_DEF
}

def generic_to_string(generic: &Generic) -> Str {
    if is_type(generic) {
        return debug::type_to_str(generic.tpe, true)
    } else if generic.name {
        return "type " + generic.name
    } else if generic.kind == TypeKind::REFERENCE {
        return "&" + generic_to_string(generic.generic) // FIXME *let kw
    } else if generic.kind == TypeKind::POINTER {
        return "*" + generic_to_string(generic.generic) // FIXME &let kw
    } else if generic.kind == TypeKind::ARRAY {
        return "[" + generic_to_string(generic.generic) + "]"
    } else if generic.kind == TypeKind::STATIC_ARRAY {
        return "[" + generic.length + "; " + generic_to_string(generic.generic) + "]"
    } else if generic.kind == TypeKind::TUPLE {
        var res: StringBuffer = "["
        let len = generic.parameter_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.parameter_t(i))
            if i < len - 1 {
                res += ", "
            }
        }
        res += ']'
        return res
    } else if generic.kind == TypeKind::FUNCTION or generic.kind == TypeKind::CLOSURE {
        var res: StringBuffer = "def [" if generic.kind == TypeKind::CLOSURE else "["
        var len = generic.parameter_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.parameter_t(i))
            if i < len - 1 {
                res += ", "
            }
        }
        res += "] -> ["
        for var i in 0..len {
            res += generic_to_string(generic.return_t(i))
            if i < len - 1 {
                res += ", "
            }
        }
        return res
    } else if generic.kind == TypeKind::TUNION {
        var res: StringBuffer = "("
        let len = generic.parameter_t.length()
        for var i in 0..len {
            res += generic_to_string(generic.parameter_t(i))
            if i < len - 1 {
                res += " | "
            }
        }
        res += ")"
        return res
    }
    assert
}

// TODO Offset this by a project id that is unique for a build
export var current_type_id: uint64
export def next_type_id -> TypeId {
    let id = current_type_id
    current_type_id += 1
    return id !TypeId
}

export var type_registry: &map::Map(TypeId, &Type)
// This is used for types that get synthesized during compilation. 
// Without this, new types would fill up the type registry slowly when using incremental compilation
export var type_registry_internal: &Map(TypeId, &Type)
// This is needed to filter out types that aren't used and don't need to be serialized
export var used_types: &Set(TypeId)

export var type_registry_word: &Map(Primitive, &Type)
export var type_registry_closure: &Map(Signature, &Type)
export var type_registry_function: &Map(Signature, &Type)
export var type_registry_tuple: &Map(Signature, &Type)
export var type_registry_variant: &Map(Signature, &Type)
export var type_registry_type: &Map(Box, &Type)
export var type_registry_pointer: &Map(Box, &Type)
export var type_registry_byref: &Map(Box, &Type)
export var type_registry_reference: &Map(Box, &Type)
export var type_registry_weak_reference: &Map(Box, &Type)
export var type_registry_array: &Map(Box, &Type)
export var type_registry_static_array: &Map(Box, &Type)
export var type_registry_instance: &Map(TypeTuple, &Type)

export def load_type_registries {
    current_type_id = 7
    type_registry = map::make(TypeId, type &Type)
    type_registry_internal = map::make(TypeId, type &Type)
    used_types = set::make(TypeId)

    type_registry_word = map::make(Primitive, type &Type)
    type_registry_closure = map::make(Signature, type &Type)
    type_registry_function = map::make(Signature, type &Type)
    type_registry_tuple = map::make(Signature, type &Type)
    type_registry_variant = map::make(Signature, type &Type)
    type_registry_type = map::make(Box, type &Type)
    type_registry_pointer = map::make(Box, type &Type)
    type_registry_byref = map::make(Box, type &Type)
    type_registry_reference = map::make(Box, type &Type)
    type_registry_weak_reference = map::make(Box, type &Type)
    type_registry_array = map::make(Box, type &Type)
    type_registry_static_array = map::make(Box, type &Type)
    type_registry_instance = map::make(TypeTuple, type &Type)
}

export let null_ = [ kind = TypeKind::NULL, id = 1 ] !&Type
export let void = [ kind = TypeKind::VOID, id = 2 ] !&Type
export let to_infer = [ kind = TypeKind::TO_INFER, id = 3 ] !&Type
export let undef_ = [ kind = TypeKind::UNDEF, id = 4 ] !&Type
export let range = [ kind = TypeKind::RANGE, id = 5 ] !&Type
export let range_inc = [ kind = TypeKind::RANGE_INC, id = 6] !&Type

export implicit def resolve(id: TypeId) -> &Type {
    switch id !int64 {
        case 0; return null
        case 1; return null_
        case 2; return void
        case 3; return to_infer
        case 4; return undef_
        case 5; return range
        case 6; return range_inc
    }
    var res = type_registry.get_or_default(id, null)
    if not res { res = type_registry_internal.get_or_default(id, null) }
    return res
}

export def register(id: TypeId, tpe: &Type) {
    type_registry(id) = tpe
}

export def register_internal(id: TypeId, tpe: &Type) {
    type_registry_internal(id) = tpe
}

def sort_by_typeid(types: &Vector(&Generic)) {
    let n = types.length
    // bubble sort because icba // TODO Implement sorting for vectors and arrays
    for var i in 0..n {
        for var j in 0..(n - 1) {
            if types(j).tpe > types(j + 1).tpe {
                let t = types(j); types(j) = types(j + 1); types(j + 1) = t
            }
        }
    }
}

// Returns true if there's any destructor present
export def has_destructor(tpe: &Type) -> bool {
    if not tpe { return false }
    if tpe.has_destructor != Ternary::UNDEFINED {
        return tpe.has_destructor == Ternary::TRUE
    }
    var res = false
    if is_ref(tpe) {
        res = true
    } else if tpe.kind == TypeKind::STATIC_ARRAY { 
        res = has_destructor(tpe.tpe) 
    } else if tpe.defmodule and get_user_defined_destructor(tpe) != null {
        res = true
    } else if tpe.kind == TypeKind::STRUCT {
        for var i in 0..tpe.fields.size {
            let field = tpe.fields(i)
            if has_destructor(field.tpe) {
                res = true
                break
            }
        }
    } else if tpe.kind == TypeKind::CLOSURE {
        res = true
    } else if tpe.kind == TypeKind::TUNION {
        for var v in tpe.return_t {
            if has_destructor(v) {
                res = true
                break
            }
        }
    }

    if not consteval::is_static {
        if res {
            tpe.has_destructor = Ternary::TRUE
        } else {
            tpe.has_destructor = Ternary::FALSE
        }
    }
    return res
}

export def get_builtin_destructor(tpe: &Type, lookup: bool = true) -> &scope::Value {
    if not tpe { return null }
    //if is_polymorph(tpe) { return null }

    if tpe.has_builtin_destructor != Ternary::UNDEFINED and tpe.builtin_destructor {
        return tpe.builtin_destructor
    }

    var destructor = tpe.builtin_destructor
    let args = vector::make(NamedParameter)
    args.push([ tpe = pointer(tpe.id) ] !NamedParameter)
    if not tpe.builtin_destructor {
        destructor = scope::generate_function(builtins::builtins, parser::make_identifier("__destruct__"), args, true)
        tpe.builtin_destructor = destructor
        if lookup and consteval::is_static and destructor {
            compiler::create_destructor(destructor.tpe)
        }
    }
    // The problem is if we cache this value in consteval the relevant functions might not exist
    if not consteval::is_static {
        if destructor {
            tpe.has_builtin_destructor = Ternary::TRUE
        } else {
            tpe.has_builtin_destructor = Ternary::FALSE
        }
    }
    return destructor
}

export def get_user_defined_destructor(tpe: &Type) -> &scope::Value {
    if tpe.has_destructor != Ternary::UNDEFINED {
        if tpe.destructor { return tpe.destructor }
    }
    if tpe.defmodule {
        let args = vector::make(NamedParameter)
        args.push([
            tpe = pointer(tpe.id)
        ] !NamedParameter)
        var destructor = scope::get_function(tpe.defmodule.scope, parser::make_identifier("destruct"), args, false, true, not consteval::is_static)
        if destructor {
            if consteval::is_static {
                destructor = consteval::compile_function(destructor, tpe.defmodule.scope, args)
            } else {
                tpe.has_destructor = Ternary::TRUE
            }
            tpe.destructor = destructor
            return destructor 
        }
    }
    return null
}

export def get_constructor(tpe: &Type, lookup: bool = true) -> &scope::Value {
    has_copy_constructor(tpe, lookup)
    return tpe.constructor
}

export def has_user_defined_copy_constructor(tpe: &Type) -> bool {
    if not tpe { return false }
    if tpe.kind != TypeKind::STRUCT and
        tpe.kind != TypeKind::UNION {
        return false        
    }

    if tpe.has_user_defined_constructor != Ternary::UNDEFINED {
        return tpe.has_user_defined_constructor == Ternary::TRUE
    }

    var res = false
    if tpe.kind == TypeKind::STATIC_ARRAY { res = has_user_defined_copy_constructor(tpe.tpe) }
    else if tpe.defmodule {
        let args = vector::make(NamedParameter)
        args.push([ tpe = pointer(tpe.id)] !NamedParameter)
        args.push([ tpe = pointer(tpe.id)] !NamedParameter)

        var module = tpe.defmodule
        if tpe.tc_tpe { module = tpe.tc_tpe.resolve().defmodule }
        var constructor = scope::get_function(module.scope, parser::make_identifier("construct"), args, false, not consteval::is_static)
        if constructor {
            if consteval::is_static {
                constructor = consteval::compile_function(constructor, module.scope, args)
            }
            tpe.constructor = constructor
            res = true 
        }
    }
    if not consteval::is_static {
        if res { tpe.has_user_defined_constructor = Ternary::TRUE }
        else { tpe.has_user_defined_constructor = Ternary::FALSE }
    }
    return res
}

export def get_builtin_constructor(tpe: &Type) -> &scope::Value {
    if not tpe { return null }
    //if is_polymorph(tpe) { return null }

    if tpe.has_constructor != Ternary::UNDEFINED and tpe.constructor {
        return tpe.constructor
    }

    let args = vector::make(NamedParameter)
    vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
    vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
    tpe.constructor = scope::generate_function(builtins::builtins, parser::make_identifier("__construct__"), args, dry_run = true)
    if consteval::is_static and tpe.constructor {
        compiler::create_constructor(tpe.constructor.tpe)
    }
    if not consteval::is_static {
        if tpe.constructor {
            tpe.has_constructor = Ternary::TRUE
        } else {
            tpe.has_constructor = Ternary::FALSE
        }
    }
    return tpe.constructor
}

// Returns true if there's any copy constructor
// TODO Write a separate function for checking without generating
export def has_copy_constructor(tpe: &Type, lookup: bool = true) -> bool {
    if not tpe { return false }
    if tpe.kind != TypeKind::STRUCT and 
        tpe.kind != TypeKind::UNION and
        tpe.kind != TypeKind::STATIC_ARRAY and 
        tpe.kind != TypeKind::CLOSURE and
        tpe.kind != TypeKind::TUNION { 
        return false 
    }

    if tpe.has_constructor != 0 {
        if tpe.has_constructor == Ternary::TRUE and tpe.constructor {
            return true
        } else if tpe.has_constructor == Ternary::FALSE {
            return false
        }
    } 

    var res = false
    if has_user_defined_copy_constructor(tpe) { res = true }
    else if tpe.kind == TypeKind::STRUCT {
        for var i in 0..tpe.fields.size {
            let field = tpe.fields(i)
            if has_copy_constructor(field.tpe) or is_ref(field.tpe) {  
                res = true
                break
            }
        }
    } else if tpe.kind == TypeKind::CLOSURE {
        res = true
    } else if tpe.kind == TypeKind::STATIC_ARRAY {
        while tpe != null and tpe.kind == TypeKind::STATIC_ARRAY {
            tpe = tpe.tpe
        }
        if has_copy_constructor(tpe) or is_ref(tpe) { 
            res = true
        }
    } else if tpe.kind == TypeKind::TUNION {
        for var variant in tpe.return_t {
            if has_copy_constructor(variant) or is_ref(variant) {  
                res = true
                break
            }
        }
    }

    if not tpe.constructor and lookup {
        let args = vector::make(NamedParameter)
        vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
        vector::push(args, [ tpe = pointer(tpe.id) ] !NamedParameter)
        tpe.constructor = scope::generate_function(builtins::builtins, parser::make_identifier("__construct__"), args, dry_run = true)
        if consteval::is_static and tpe.constructor {
            compiler::create_constructor(tpe.constructor.tpe)
        }
    }

    if not consteval::is_static {
        if res {
            tpe.has_constructor = Ternary::TRUE
        } else {
            tpe.has_constructor = Ternary::FALSE
        }
    }

    return res
}

// This returns a type's module OR if it is a box (i.e references or pointers)
// returns the module of the wrapped type
export def get_module(tpe: &Type) -> &toolchain::Module {
    if not tpe { return null }
    if is_box(tpe) { return get_module(tpe.tpe) }
    return tpe.defmodule
}

export type NamedParameter = struct {
    // Might be empty for positional parameters
    name: Str
    tpe: TypeId
    generic: &Generic
    varargs: bool
    node: weak &parser::Node
    value: &compiler::Value
    kw: parser::VarDecl
    //type_node: weak &parser::Node
}
export def == (this: NamedParameter, other: NamedParameter) -> bool {
    if this.generic or other.generic { return false }
    return this.tpe == other.tpe
}
export def != (this: NamedParameter, other: NamedParameter) -> bool { return not (this == other) }

export def get_generic(np: NamedParameter) -> &Generic {
    if np.tpe { return [ tpe = np.tpe ] !&Generic }
    return np.generic
}

def make_parameter(tpe: TypeId, node: &parser::Node = null, name: String = null) -> NamedParameter {
    return [ name = name, tpe = tpe, node = node ] !NamedParameter
}

def make_parameter(generic: &Generic, node: &parser::Node = null, name: String = null) -> NamedParameter {
    if is_type(generic) {
        return [ name = name, tpe = generic.tpe, node = node ] !NamedParameter
    }
    return [ name = name, generic = generic, node = node ] !NamedParameter
}

export type State = struct {
    module: weak &toolchain::Module
    scope: &scope::Scope
    // Vector of Type
    function_stack: &Vector(&compiler::Function)
    in_defer: bool
    // If this is set to true, consteval doesn't perform the walk_top
    shallow_walk: bool
    current_variable: &scope::Value
    // TODO This should be a parameter but its currently too hard to fix
    block_implicit_conv: bool
    current_lambda: &compiler::Function
    context: &scope::Scope
}

export def get_context(state: &State) -> &toolchain::Module {
    if state.context { return state.context.module }
    return state.module
}

// This needs to be global state
var lambda_counter = 0
var counter = 0

def current_value(state: &State) -> &scope::Value {
    if state.current_variable {
        return state.current_variable
    }
    
    let len = vector::length(state.function_stack)
    for var i in 0..len {
        let j = state.function_stack.length - i - 1
        let fun = state.function_stack(j)
        if j > 0 {
            let parent = state.function_stack(j - 1)
            if parent.is_global {
                return fun.value
            }
        }
        if fun.is_global { 
            return fun.value
        }
    }
    return null
}

export def current_function(state: &State) -> &compiler::Function {
    let length = vector::length((@state).function_stack)
    if length == 0 {
        return null
    } else {
        return (@state).function_stack(length - 1)
    }
}

export def push_function(state: &State, function: &compiler::Function) {
    (@state).function_stack.push(function)
}

export def pop_function(state: &State) -> &compiler::Function {
    return vector::pop((@state).function_stack)
}

export def is_function(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::FUNCTION
}

export def is_closure(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::CLOSURE
}

export def is_function_pointer(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::POINTER and 
        is_function(tpe.tpe)
}

export def is_integer(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::WORD or 
        tpe.kind == TypeKind::BOOL or 
        tpe.kind == TypeKind::ENUM or
        tpe.kind == TypeKind::CHAR
}

export def is_arithmetic(tpe: &Type) -> bool {
    if not tpe { return false }
    return is_integer(tpe) or 
        tpe.kind == TypeKind::FLOAT
}

export def is_float(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::FLOAT
}

// TODO Also allow arrays and strings
export def is_boolean(tpe: &Type, module: &Module) -> bool {
    if not tpe { return false }
    if tpe.kind == TypeKind::BOOL or
        tpe.kind == TypeKind::WORD or
        tpe.kind == TypeKind::FLOAT or
        tpe.kind == TypeKind::POINTER or
        tpe.kind == TypeKind::BYREF or
        tpe.kind == TypeKind::REFERENCE or
        tpe.kind == TypeKind::WEAK_REF or
        tpe.kind == TypeKind::CHAR or
        tpe.kind == TypeKind::CLOSURE {
        return true
    }
    return is_assignable(builtins::bool_, tpe, module)
}

export def is_pointer(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::POINTER or 
        tpe.kind == TypeKind::BYREF
}

export def is_ref(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::REFERENCE
}


export def is_weak_ref(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::WEAK_REF
}

export def is_ref_or_weak(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::WEAK_REF or
        tpe.kind == TypeKind::REFERENCE
}

export def is_box(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::POINTER or
        tpe.kind == TypeKind::BYREF or
        tpe.kind == TypeKind::REFERENCE or
        tpe.kind == TypeKind::WEAK_REF or
        tpe.kind == TypeKind::STATIC_ARRAY or
        tpe.kind == TypeKind::ARRAY
}

export def is_struct(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::STRUCT or
        tpe.kind == TypeKind::UNION
}

export def is_struct_t(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::STRUCT
}

export def is_enum(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::ENUM
}

export def is_type(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::TYPE
}

export def is_array(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::ARRAY or
        tpe.kind == TypeKind::STATIC_ARRAY
}

export def is_array_t(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::ARRAY
}

export def is_static_array(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::STATIC_ARRAY
}

export def is_range(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::RANGE or
        tpe.kind == TypeKind::RANGE_INC
}

/*export def is_stub(tpe: &Type) -> bool {
    if not tpe { return true }
    return tpe.kind == TypeKind::STUB
}*/

// TODO Actually go inside of function types, etc
/*export def is_stub_rec(tpe: &Type) -> bool {
    if not tpe { return false }
    if is_box(tpe) {
        return is_stub_rec(tpe.tpe)
    }
    return tpe.kind == TypeKind::STUB
}*/

export def is_interface(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::INTERFACE
}

export def is_tuple(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::TUPLE
}

export def is_tunion(tpe: &Type) -> bool {
    if not tpe { return false }
    return tpe.kind == TypeKind::TUNION
}

export def get_interface(tpe: &Type) -> &Type {
    if not tpe { return null }
    if is_array(tpe) or is_ref(tpe) or is_pointer(tpe) {
        return get_interface(tpe.tpe)
    }
    if tpe.kind == TypeKind::INTERFACE {
        return tpe
    }
    return null
}

export def append_module(name: Str, module: Str) -> Str {
    var res: StringBuffer = ""
    if module {
        res += module + "::"
    }
    res += name
    return res
}

def make_function_type() -> &Type {
    let tpe = [ kind = TypeKind::FUNCTION ] !&Type
    tpe.size = size_of type def [] -> []
    tpe.align = align_of type def [] -> []
    return tpe
}


export type Primitive = struct {
    size: size_t
    align: size_t
    signed: bool
}
export def hash(this: Primitive) -> uint64 {
    return combine_hashes(this.size, this.signed !size_t, this.align)
}
export def == (this: Primitive, other: Primitive) -> bool {
    return this.size == other.size and 
        this.signed == other.signed and
        this.align == other.align
}
export def != (this: Primitive, other: Primitive) -> bool {
    return not (this == other)
}

export def _word(signed: bool, size: size_t, align: size_t) -> TypeId {
    let primitive = [ size = size, align = align, signed = signed ] !Primitive
    if type_registry_word.contains(primitive) {
        return type_registry_word(primitive).id
    }
    let tpe = [ kind = TypeKind::WORD ] !&Type
    tpe.id = next_type_id()
    tpe.size = size
    tpe.align = align
    tpe.unsig = not signed
    type_registry_word(primitive) = tpe
    register(tpe.id, tpe)

    return tpe.id
}

export type Signature = struct {
    parameter_t: &Vector(NamedParameter)
    return_t: &Vector(TypeId)
    name: Str
}
export def hash(signature: Signature) -> uint64 {
    var hash: uint64
    if signature.parameter_t {
        for var par in signature.parameter_t { // TODO hash for vectors
            if par.generic {
                hash = combine_hashes(hash, par.generic !* !uint64) // Unique ID
            } else {
                assert par.tpe or par.varargs
                hash = combine_hashes(hash, par.tpe !uint64)
            }   
        }
    }
    for var r in signature.return_t {
        hash = combine_hashes(hash, r !uint64)
    }
    hash = combine_hashes(hash, hash(signature.name))
    return hash
}
export def == (this: Signature, other: Signature) -> bool {
    if this.parameter_t and other.parameter_t {
        if this.parameter_t.length != other.parameter_t.length { return false }
        for var i in 0..this.parameter_t.length {
            if this.parameter_t(i) != other.parameter_t(i) { return false }
        }
    }
    if this.return_t.length != other.return_t.length { return false }
    for var i in 0..this.return_t.length {
        if this.return_t(i) != other.return_t(i) { return false }
    }
    if this.name != other.name { return false }
    return true
}
export def != (this: Signature, other: Signature) -> bool {
    return not (this == other)
}

def callable_generic(kind: TypeKind, parameter_t: &Vector(NamedParameter), return_t: &Vector(&Generic)) -> &Generic {
    if is_polymorph(parameter_t) {
        let generic_pars = vector::make(type &Generic)
        for var par in parameter_t {
            if par.generic { generic_pars.push(par.generic) }
            else { generic_pars.push([ tpe = par.tpe ] !&Generic) }
        }
        return [ kind = kind, parameter_t = generic_pars, return_t = return_t ] !&Generic
    }
    let return_t_tpe = vector::make(TypeId)
    for var r in return_t {
        return_t_tpe.push(r.tpe)
    }
    
    if kind == TypeKind::CLOSURE {
        return [ tpe = closure(parameter_t, return_t_tpe) ] !&Generic
    } else {
        return [ tpe = function("", parameter_t, return_t_tpe) ] !&Generic
    }
}

def closure(parameter_t: &Vector(NamedParameter), return_t: &Vector(TypeId)) -> TypeId {
    let signature = [ parameter_t = parameter_t, return_t = return_t ] !Signature
    if type_registry_closure.contains(signature) {
        return type_registry_closure(signature).id
    }
    
    let parameter_t2 = parameter_t.copy()
    parameter_t2.insert(0, [ name = "__data", tpe = reference(0) ] !NamedParameter)
    let fun = function("", parameter_t2, return_t, extern = true)

    let types = allocate_ref(StructMember, 2)
    types(0) = [ tpe = pointer(fun), name = "function" ] !StructMember
    types(1) = [ tpe = reference(0), name = "data" ] !StructMember
    let tpe = make_struct_type(types)
    tpe.id = next_type_id()
    tpe.kind = TypeKind::CLOSURE

    type_registry_closure(signature) = tpe
    register(tpe.id, tpe)
    return tpe.id
}

export def function(
    name: Str, 
    parameter_t: &Vector(NamedParameter), 
    return_t: &Vector(TypeId), 
    module: &toolchain::Module = null,
    extern: bool = false,
    test: bool = false,
    context: &toolchain::Module = null,
    type_name: String = null
) -> TypeId {
    var tname: Str
    if extern {
        tname = name
    } else if type_name {
        tname = type_name
    } else {
        let name = append_module(name, module.module) if module else name
        tname = mangle_function_name(name, parameter_t, test, context)
    }

    let signature = [ 
        parameter_t = parameter_t, 
        return_t = return_t, 
        name = tname 
    ] !Signature

    if type_registry_function.contains(signature) {
        return type_registry_function(signature).id
    }

    let tpe = make_function_type()
    tpe.id = next_type_id()
    tpe.parameter_t = parameter_t
    tpe.return_t = return_t
    tpe.name = name
    tpe.type_name = tname
    
    type_registry_function(signature) = tpe
    register(tpe.id, tpe)

    return tpe.id
}


export def tuple(generics: &Vector(&Generic)) -> &Generic {
    let types = vector::make(TypeId)
    var is_generic = false
    for var generic in generics {
        if is_type(generic) { 
            types.push(generic.tpe)
        } else {
            is_generic = true
            break
        }
    }
    
    if not is_generic {
        return [ tpe = tuple(types) ] !&Generic
    }

    return [ kind = TypeKind::TUPLE, return_t = generics ]
}

export def tuple(types: &Vector(TypeId)) -> TypeId {
    let signature = [ return_t = types ] !Signature
    if type_registry_tuple.contains(signature) {
        return type_registry_tuple(signature).id
    }

    let fields = vector::make(StructMember)
    for var t in types {
        fields.push([ tpe = t ] !StructMember)
    }
    let struct_type = make_struct_type(fields.to_array())

    let tuple = [ kind = TypeKind::TUPLE ] !&Type
    tuple.id = next_type_id()
    tuple.return_t = types
    tuple.size = struct_type.size
    tuple.align = struct_type.align

    type_registry_tuple(signature) = tuple
    register(tuple.id, tuple)

    return tuple.id
}

export def variant(generics: &Vector(&Generic)) -> &Generic {
    sort_by_typeid(generics)

    let types = vector::make(TypeId)
    var is_generic = false
    for var tpe in types {
        if is_type(tpe) { 
            types.push(tpe.tpe)
        } else {
            is_generic = true
            break
        }
    }

    if not is_generic {
        let signature = [ return_t = types ] !Signature
        if type_registry_variant.contains(signature) {
            return [ tpe = type_registry_variant(signature).id ] !&Generic
        }
        let variant = [ kind = TypeKind::TUNION ] !&Type
        variant.id = next_type_id()
        variant.return_t = types
        
        var biggest_type: &Type
        var offset: uint64 = size_of *
        var align: uint64 = align_of *

        for var tpe in types {
            if not biggest_type or tpe.resolve().size > biggest_type.size {
                biggest_type = tpe.resolve()
            }
        }

        variant.size = (ceil(offset / biggest_type.align !double) * biggest_type.align) !int
        variant.align = util::lcm(align !int, biggest_type.align !int)
         
        var fields = allocate_ref(StructMember, generics.length)
        for var i in 0..generics.length {
            fields(i) = [ name = "_" + to_string(i), tpe = generics(i).tpe ] !StructMember
        }
    
        let union_tpe = make_union_type(fields)
        union_tpe.id = next_type_id()
        register_internal(union_tpe.id, union_tpe)
        variant.tpe = union_tpe.id
        
        type_registry_variant(signature) = variant
        register(variant.id, variant)

        return [ tpe = variant.id ] !&Generic
    }

    return [ kind = TypeKind::TUNION, return_t = generics ] !&Generic
}

// This is used to lookup box types like pointers and arrays in the type registry
export type Box = struct {
    id: TypeId
    kw: parser::VarDecl
    size: size_t
}
export def hash(this: Box) -> uint64 { return combine_hashes(this.id !uint64, this.kw !uint64, this.size !uint64) }
export def == (this: Box, other: Box) -> bool { return this.id == other.id and this.kw == other.kw and this.size == other.size }
export def != (this: Box, other: Box) -> bool { return not (this == other) }

export def _type(tpe: TypeId) -> TypeId {
    let tid = [ id = tpe ] !Box
    if type_registry_type.contains(tid) {
        return type_registry_type(tid).id
    }
    let tpetpe = [
        kind = TypeKind::TYPE,
        id = next_type_id(),
        tpe = tpe
    ] !&Type
    type_registry_type(tid) = tpetpe
    register(tpetpe.id, tpetpe)
    return tpetpe.id
}

// TODO Use default arguments for this, right now its bugged (it doesn't define the type)
export def pointer(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let pid = [ id = tpe, kw = kw ] !Box
    if type_registry_pointer.contains(pid) {
        return type_registry_pointer(pid).id
    }
    let ptrtpe = [
        kind = TypeKind::POINTER,
        id = next_type_id(),
        tpe = tpe,
        kw = kw,
        size = (size_of type *),
        align = (align_of type *)
    ] !&Type
    type_registry_pointer(pid) = ptrtpe
    register(ptrtpe.id, ptrtpe)
    return ptrtpe.id
}

def pointer(generic: &Generic, kw: parser::VarDecl) -> &Generic {
    if generic == null { return [ tpe = pointer(0, kw) ] !&Generic }
    if is_type(generic) { return [ tpe = pointer(generic.tpe, kw) ] !&Generic }
    return [ kind = TypeKind::POINTER, generic = generic ] !&Generic
}

export def pointer(tpe: TypeId) -> TypeId {
    return pointer(tpe, parser::VarDecl::VAR)
}

export def byref(tpe: TypeId) -> TypeId {
    let pid = [ id = tpe ] !Box
    if type_registry_byref.contains(pid) {
        return type_registry_byref(pid).id
    }
    let reftpe = [
        kind = TypeKind::BYREF,
        id = next_type_id(),
        tpe = tpe,
        size = (size_of type *),
        align = (align_of type *)
    ] !&Type
    type_registry_byref(pid) = reftpe
    register(reftpe.id, reftpe)
    return reftpe.id
}

export def byref(generic: &Generic) -> &Generic {
    if generic == null { return [ tpe = byref(0) ] !&Generic }
    if is_type(generic) { return [ tpe = byref(generic.tpe) ] !&Generic }
    return [ kind = TypeKind::BYREF, generic = generic ] !&Generic
}

export def reference(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = tpe, kw = kw ] !Box
    if type_registry_reference.contains(rid) {
        return type_registry_reference(rid).id
    }
    let reftpe = [
        kind = TypeKind::REFERENCE,
        id = next_type_id(),
        tpe = tpe,
        kw = kw,
        size = (size_of type &),
        align = (align_of type &)
    ] !&Type
    type_registry_reference(rid) = reftpe
    register(reftpe.id, reftpe)
    return reftpe.id
}

def reference(generic: &Generic, kw: parser::VarDecl) -> &Generic {
    if generic == null { return [ tpe = reference(0, kw) ] !&Generic }
    if is_type(generic) { return [ tpe = reference(generic.tpe, kw) ] !&Generic }
    return [ kind = TypeKind::REFERENCE, generic = generic ] !&Generic
}

export def reference(tpe: TypeId) -> TypeId {
    return reference(tpe, parser::VarDecl::VAR)
}

export def weak_reference(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = tpe, kw = kw ] !Box
    if type_registry_weak_reference.contains(rid) {
        return type_registry_weak_reference(rid).id
    }
    let reftpe = [
        kind = TypeKind::WEAK_REF,
        id = next_type_id(),
        tpe = tpe,
        kw = kw,
        size = (size_of type &),
        align = (align_of type &)
    ] !&Type
    type_registry_reference(rid) = reftpe
    register(reftpe.id, reftpe)
    return reftpe.id
}

export def weak_reference(tpe: TypeId) -> TypeId {
    return weak_reference(tpe, parser::VarDecl::VAR)
}

def weak_reference(generic: &Generic, kw: parser::VarDecl) -> &Generic {
    if generic == null { return [ tpe = weak_reference(0, kw) ] !&Generic }
    if is_type(generic) { return [ tpe = weak_reference(generic.tpe, kw) ] !&Generic }
    return [ kind = TypeKind::WEAK_REF, generic = generic ] !&Generic
}

export def array(tpe: TypeId, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = tpe, kw = kw ] !Box
    if type_registry_array.contains(rid) {
        return type_registry_array(rid).id
    }
    let arrtpe = [
        kind = TypeKind::ARRAY,
        id = next_type_id(),
        tpe = tpe,
        kw = kw,
        size = (size_of type [*]),
        align = (align_of type [*])
    ] !&Type
    type_registry_array(rid) = arrtpe
    register(arrtpe.id, arrtpe)
    return arrtpe.id
}

def array(generic: &Generic, kw: parser::VarDecl) -> &Generic {
    if is_type(generic) { return [ tpe = array(generic.tpe, kw) ] !&Generic }
    return [ kind = TypeKind::ARRAY, generic = generic ] !&Generic
}

export def array(tpe: TypeId) -> TypeId {
    return array(tpe, parser::VarDecl::VAR)
}

export def static_array(array_tpe: TypeId, size: size_t, kw: parser::VarDecl) -> TypeId {
    let rid = [ id = array_tpe, kw = kw, size = size ] !Box
    if type_registry_static_array.contains(rid) {
        return type_registry_static_array(rid).id
    }
    let tpe = array_tpe.resolve()
    let arrtpe = [
        kind = TypeKind::STATIC_ARRAY,
        id = next_type_id(),
        tpe = array_tpe,
        kw = kw,
        length = size,
        size = size * tpe.size,
        align = tpe.align
    ] !&Type
    type_registry_static_array(rid) = arrtpe
    register(arrtpe.id, arrtpe)
    return arrtpe.id
}

def static_array(generic: &Generic, size: size_t, kw: parser::VarDecl) -> &Generic {
    if is_type(generic) { return [ tpe = static_array(generic.tpe, size, kw) ] !&Generic }
    return [ kind = TypeKind::STATIC_ARRAY, length = size, generic = generic ] !&Generic
}

export def static_array(array_tpe: TypeId, size: size_t) -> TypeId {
    return static_array(array_tpe, size, parser::VarDecl::VAR)
}

def make_unique_name(name: Str, state: &State) -> Str {
    let cnt = counter
    counter += 1
    return state.module.module + "::" + name + '.' + cnt
}


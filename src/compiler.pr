export type TypeEntry = struct {
    tpe: &typechecking::Type
    value: &scope::Value
    module: weak &toolchain::Module
}

export def create_type(tpe: &typechecking::Type, module: &toolchain::Module, res: &Vector(TypeEntry)) -> &Value {
    if not tpe { return null }
    //if tpe.kind == typechecking::TypeKind::BOX {
    //    tpe = tpe.wk
    //}
    //if tpe.tc_incomplete { return null }
    //let generic = typechecking::get_generic(tpe)
    //if generic and generic.tc_incomplete { return null }
    if tpe.kind == typechecking::TypeKind::TYPE_DEF { return null }

    let name = debug::type_to_str(tpe, full_name = true)
    /*if is_stub(tpe) {
        if name {
            let to_resolve = [ module = module, tpe = tpe ] !ToResolve
            types_to_resolve(name) = to_resolve
        }
        return null
    }*/

    import_structure(builtins::type_t(), toolchain::types)

    let ident = make_identifier(name)
    ident.loc.module = "type"

    var svalue = scope::get(toolchain::types.scope, ident, false, false)
    if not svalue {
        //print("create_type: ", name, "\n")
        svalue = scope::create_variable(
            toolchain::types.scope, ident, parser::ShareMarker::NONE, 
            parser::VarDecl::CONST, typechecking::make_type_ref(builtins::type_t()), 
            false, false, false, null, scope::Phase::COMPILED, null, null)

        let entry = [ tpe = tpe, value = svalue, module = module ] !TypeEntry
        res.push(entry)
        //all_types.push(entry)
        queued_types(tpe.id) = tpe

        /*svalue = scope::create_variable(
            toolchain::types.scope, 
            ident, parser::ShareMarker::NONE, parser::VarDecl::CONST, 
            builtins::type_t(), do_create_type(tpe, svalue, module))*/
        svalue.identifier = ident

        // Recursively add all sub types
        if is_box(tpe) {
            create_type(tpe.tpe, module, res)
        } else if is_struct(tpe) {
            for var i in 0..tpe.fields.length() {
                let field = tpe.fields(i)
                create_type(field.tpe, module, res)
            }
        } else if tpe.kind == typechecking::TypeKind::FUNCTION or
            tpe.kind == typechecking::TypeKind::CLOSURE or
            tpe.kind == typechecking::TypeKind::TUPLE or
            tpe.kind == typechecking::TypeKind::TUNION {
            
            if tpe.kind == typechecking::TypeKind::FUNCTION or 
                tpe.kind == typechecking::TypeKind::CLOSURE {
                for var param in tpe.parameter_t {
                    create_type(param.tpe, module, res)
                }
            }
            for var rtpe in tpe.return_t {
                create_type(rtpe, module, res)
            }
        }

        if tpe.implementors {
            for var t in @tpe.implementors.keys() {
                create_type(t, module, res)
            }
        }
        if tpe.implements {
            for var t in @tpe.implements.keys() {
                create_type(t, module, res)
            }
        }
    }

    let state = toolchain::types_state
    let assembly_name = scope::assembly_name(svalue, state)
    if module {
        if not map::contains(module.result.globals, assembly_name) {
            let global = [
                external = true,
                name = assembly_name,
                tpe = builtins::type_t(),
                line = -1,
                identifier = ident
            ] !&Global
            module.result.add_global(global.name, global)
            module.imported.add(global.name)
        }
    }
   

    let value = [
        kind = ValueKind::GLOBAL,
        tpe = typechecking::pointer(builtins::type_t()), 
        name = assembly_name
    ] !&Value

    // value.value_tpe = tpe

    return value
}

var fun_type_id: &scope::Value

def declare_reflection_type_t_fun(state: &State) -> &scope::Value {

    let reflection = toolchain::find_module("reflection")
    if not reflection { return null }
    if not fun_type_id {
        fun_type_id = reflection.scope.get(parser::make_identifier("type_id"), force_compile = not consteval::is_static)
        if consteval::is_static {
            consteval::compile_function_no_queue(fun_type_id, state.scope)
        }
    }

    predeclare_function(fun_type_id.fdef, state.module)
    state.module.imported.add(fun_type_id.fdef.name)

    return fun_type_id
}

def change_value_to_type(tpe: &typechecking::Type, loc: &Value, state: &State) -> Value {
    //add_type_meta(tpe, state)
    if not create_type(tpe, state.module) { return NO_VALUE }

    let fun = declare_reflection_type_t_fun(state)
    if not fun { return NO_VALUE }
    let tmp = state.alloca(builtins::reflection_type_t(), loc)
    let res = state.call(fun.fdef.name, builtins::reflection_type_t(), [[ tpe = builtins::uint64_, kind = ValueKind::INT, i = tpe.id ] !Value], loc)
    state.store(tmp, res, loc)
    create_temporary(tmp, res, loc, state)
    return res
}

def make_global_data(name: Str, value: &ByteStream, state: &State) {
    let tpe = typechecking::static_array(builtins::char_, value.data().size)

    let s = value.data() !&[byte] !&[char]
    let global = [
        name = name,
        tpe = tpe,
        value = [ tpe = tpe, kind = ValueKind::STRING, s = s ] !Value,
        line = -1
    ] !&Global

    state.module.result.add_global(name, global)
    state.module.imported.add(name)
}

def make_global_data(name: Str, value: size_t, state: &State) {
    let global = [
        name = name,
        tpe = builtins::size_t_,
        value = [ tpe = builtins::size_t_, kind = ValueKind::INT, i = value ] !Value,
        line = -1
    ] !&Global

    state.module.result.add_global(name, global)
    state.module.imported.add(name)
}

// This gets called once
export def generate_reflection_data {
    let reflection = toolchain::find_module("reflection")
    if not reflection { return }

    // TODO it is internal for a reason we should really keep out some types...
    for var id in @typechecking::type_registry_internal.keys() {
        queued_types(id) = typechecking::type_registry_internal(id)
    }
    for var id in 0..typechecking::type_registry.length {
        let tpe = typechecking::type_registry(id)
        if not tpe { continue }
        queued_types(id !typechecking::TypeId) = tpe
    }

    let data, strings, count = generate_reflection_data_queued()

    // Need to 0 terminate the whole thing so that it can be converted to a Str
    data.write(0 !uint8) 
    strings.strings.write(0 !uint8)

    make_global_data("__reflection_data", data, toolchain::types_state)
    make_global_data("__reflection_data_size", data.data().size, toolchain::types_state)
    make_global_data("__reflection_strings", strings.strings, toolchain::types_state)
    make_global_data("__reflection_num_types", count, toolchain::types_state)
}

var fun_load_types: &scope::Value
var fun_load_types_rec_lock: bool
var fun_load_types_count: size_t = 0
var queued_types = map::make(typechecking::TypeId, type &typechecking::Type)

export def load_fun_load_types_function {
    let state = consteval::compiler_state
    if not fun_load_types {
        let reflection = toolchain::find_module("reflection")
        fun_load_types = scope::get(reflection.scope, parser::make_identifier("load_types"), force_compile = not consteval::is_static)
        if consteval::is_static and fun_load_types {
            var lock = fun_load_types_rec_lock
            fun_load_types_rec_lock = true
            consteval::compile_function_no_queue(fun_load_types, state.scope)
            create_builtin_functions()
            fun_load_types_rec_lock = lock
        }
    }
}

export def generate_reflection_data_queued -> &io::ByteStream, &UniquedStrings, size_t {
    let data = io::make_stream()
    let strings = [ strings = io::make_stream(), map = map::make(size_t) ] !&UniquedStrings

    if queued_types.size == 0 {
        return data, strings, 0
    }

    let state = consteval::compiler_state

    load_fun_load_types_function()

    if not fun_load_types or fun_load_types_rec_lock {
        return data, strings, 0
    }

    let all_types = map::make(typechecking::TypeId, type &typechecking::Type)
    let res = vector::make(TypeEntry)
    while queued_types.size > 0 {
        for var id in @queued_types.keys() {
            let tpe = queued_types(id)
            queued_types.remove(id)
            all_types(id) = tpe

            // TODO This might be unnecessary
            if tpe.implementors {
                for var t in @tpe.implementors.keys() {
                    create_type(t, state.module, res)
                }
            }
            if tpe.implements {
                for var t in @tpe.implements.keys() {
                    create_type(t, state.module, res)
                }
            }
            
            /*for var member in typechecking::iterate_member_functions(tpe) {
                let function = member.function.resolve()

                if function.parameter_t(0).tpe.kind == typechecking::TypeKind::TYPE { continue }

                print(member.function.type_name, " (")

                var is_incomplete = false
                for var i in 0..vector::length(function.parameter_t) {
                    let np = function.parameter_t(i)
                    // TODO This really only matters for compile time reflection and shouldn't happen otherwise
                    if np.generic { is_incomplete = true; break }
                    create_type(np.tpe, state.module, res)
                }
                for var tpe in function.return_t {
                    create_type(tpe, state.module, res)
                    print(debug::type_to_str(tpe, full_name = true), " ")
                }
                if is_incomplete { continue }
                type_members.push(member)
            }*/
        }
    }
    
    resolve_types(res)

    for var id in @all_types.keys() {
        generate_reflection_data_1(id, all_types(id), data, strings)
    }
    for var id in @all_types.keys() {
        generate_reflection_data_2(id, all_types(id), data, strings)
    }

    if consteval::is_static {
        let block = make_block()
        let call = make_insn(InsnKind::CALL)

        let strings_ident = "__reflection_strings_" + fun_load_types_count
        fun_load_types_count += 1

        let args = allocate_ref(Value, 4)
        args(0) = [ kind = ValueKind::GLOBAL, name = "__reflection_data", tpe = pointer(builtins::uint8_)] !Value
        args(1) = [ kind = ValueKind::INT, tpe = builtins::uint64_, i = data.data().size ] !Value
        args(2) = [ kind = ValueKind::INT, tpe = builtins::uint64_, i = all_types.size ] !Value
        args(3) = [ kind = ValueKind::GLOBAL, name = strings_ident, tpe = pointer(builtins::char_)]

        call.value.call = [
            name = [ kind = ValueKind::GLOBAL, name = fun_load_types.fdef.name ],
            ret = NO_VALUE,
            args = args
        ] !InsnCall

        block.insn.push(call)

        // load globals
        state.globals("__reflection_data") = *data.data().value

        let sz = strings.strings.data().size
        let strings_data = state.mem.allocate(sz)
        std::memcopy(strings.strings.data().value, strings_data, sz)

        let strings_ptr = state.mem.allocate(size_of *) !**
        @strings_ptr = strings_data
        state.globals(strings_ident) = strings_ptr // This is a copy so we can keep it here

        eval::eval(state, block)

        // remove this so that it doesn't get cleaned up later, we're just borrowing it inside this function
        state.globals.remove("__reflection_data")
    }

    return data, strings, all_types.size
}

type UniquedStrings = struct {
    strings: &ByteStream
    map: &SMap(size_t)
}

def write_zt(uniqued: &UniquedStrings, s: Str) -> int {
    if uniqued.map.contains(s) {
        return uniqued.map(s) !int
    }
    let val = uniqued.strings.write_zt(s)
    uniqued.map(s) = val
    return val !int
}

def generate_reflection_data_2(id: typechecking::TypeId, tpe: &typechecking::Type, data: &ByteStream, strings: &UniquedStrings) {

    // Write implements
    if tpe.implements {
        data.write(tpe.implements.size !int)
        for var intf in @tpe.implements.keys() {
            data.write(intf !uint64)
        }
    } else {
        data.write(0 !int)
    }

    // Write type members
    /*data.write(type_members.length !int)

    print(debug::type_to_str(tpe), " members: ", type_members.length, "\n")

    for var member in type_members {
        let function = member.function.to_type().resolve()
        data.write(strings.write_zt(function.type_name))
        data.write(strings.write_zt(function.name))
        data.write(member.exported)
        data.write(strings.write_zt(member.function.context.module))

        print("\t", function.type_name, "\n")

        data.write(function.parameter_t.length !int)
        for var arg in function.parameter_t {
            data.write(arg.tpe.hash if arg.tpe else 0) // TODO Do we want function argument names maybe?
        }
        data.write(function.return_t.length !int)
        for var t in function.return_t {
            data.write(t.hash)
        }
    }*/

    switch tpe.kind {
    case typechecking::TypeKind::STRUCT, typechecking::TypeKind::UNION
        for var member in tpe.fields {
            data.write(member.tpe.hash)
        }
    case typechecking::TypeKind::INTERFACE
        for var member in tpe.members {
            //print("\tmember: ", member.name, " args: ")
            for var np in member.parameter_t {
                assert np.tpe
                //print(np.tpe)
                data.write(np.tpe !uint64)
            }
            //print(" returns: ")
            for var t in member.return_t {
                assert t
                //print(t)
                data.write(t !uint64)
            }
            //print("\n")
        }
    case typechecking::TypeKind::POINTER, typechecking::TypeKind::REFERENCE,
        typechecking::TypeKind::WEAK_REF, typechecking::TypeKind::ARRAY,
        typechecking::TypeKind::STATIC_ARRAY, typechecking::TypeKind::ENUM

        //print(tpe.kind, "\n")
        //print("\ttpe: ", tpe.tpe, "\n")
        //if is_stub(tpe.tpe) {
        //    data.write(0 !uint64) // Probably an opaque type
        //} else {
            data.write(tpe.tpe.hash if tpe.tpe else 0)
        //}

        if tpe.kind == typechecking::TypeKind::REFERENCE {
            if tpe.tpe and tpe.tpe.kind == typechecking::TypeKind::INTERFACE and tpe.implementors {
                data.write(tpe.implementors.size !int)
                for var impl in @tpe.implementors.keys() {
                    //print("\timpl: ", debug::type_to_str(impl), " (", impl, ")\n")
                    data.write(impl !uint64)
                }
            } else {
                data.write(0 !int)
            }
        }
    case typechecking::TypeKind::TUPLE, typechecking::TypeKind::TUNION
        for var t in tpe.return_t {
            data.write(t.hash)
        }
    case typechecking::TypeKind::CLOSURE, typechecking::TypeKind::FUNCTION
        for var np in tpe.parameter_t {
            data.write(np.tpe.hash)
        }
        for var t in tpe.return_t {
            data.write(t.hash)
        }
    }
}

def generate_reflection_data_1(id: typechecking::TypeId, tpe: &typechecking::Type, data: &ByteStream, strings: &UniquedStrings) {
    data.write(tpe.kind) // This does rely on the values being the same
    data.write(strings.write_zt(debug::type_to_str(tpe, full_name = true)))
    data.write(strings.write_zt(tpe.defmodule.module if tpe.defmodule else to_str("")))
    data.write(id)

    //print(tpe.kind, " ", tpe.name, " ", (tpe.defmodule.module if tpe.defmodule else to_str("")), " ", tpe.hash, "\n")
    
    switch tpe.kind {
    case typechecking::TypeKind::WORD
        data.write(tpe.size !int)
        data.write(tpe.align !int)
        data.write(not tpe.unsig)
    case typechecking::TypeKind::FLOAT
        data.write(tpe.size !int)
        data.write(tpe.align !int)
    case typechecking::TypeKind::STRUCT, typechecking::TypeKind::UNION
        data.write(tpe.size !int)
        data.write(tpe.align !int)
        data.write(tpe.fields.length() !int)

        //print("\tsize: ", tpe.size, " align: ", tpe.align, " members: ", tpe.fields.length(), "\n")
        for var i in 0..tpe.fields.length() {
            let field = tpe.fields(i)
            let member = tpe.field_types(field.index)
            data.write(strings.write_zt(field.name))
            data.write(member.offset !int)
            //print("\tname: ", field.name, " offset: ", member.offset, " tpe: ", debug::type_to_str(member.tpe), " (", member.tpe, ")\n")
        }
    case typechecking::TypeKind::STATIC_ARRAY
        data.write(tpe.size)
        data.write(tpe.align)
        data.write(tpe.length)
    case typechecking::TypeKind::FUNCTION, typechecking::TypeKind::CLOSURE
        data.write(tpe.parameter_t.length !int)
        data.write(tpe.return_t.length !int)
    case typechecking::TypeKind::ENUM
        data.write(tpe.size !int)
        data.write(tpe.align !int)
        data.write(not tpe.unsig)
        
        data.write(tpe.scope.fields.size !int)
        for var name in @tpe.scope.fields.keys() {
            let svalue = tpe.scope.fields(name)
            data.write(strings.write_zt(name))
            data.write(svalue.value.i)
        }

    case typechecking::TypeKind::INTERFACE
        data.write(tpe.members.length !int)
        for var member in tpe.members {
            data.write(strings.write_zt(member.name))
            data.write(member.parameter_t.length !int)
            data.write(member.return_t.length !int)
        }
    case typechecking::TypeKind::TUPLE, typechecking::TypeKind::TUNION
        data.write(tpe.size !int)
        data.write(tpe.align !int)
        data.write(tpe.return_t.length !int)
    }
}


export def make_result -> &Result {
    return [
        functions = map::make(type &Function),
        structures = map::make(type typechecking::TypeId),
        globals = map::make(type &Global),
        metadata = map::make(type &Value)
    ] !&Result
}

export def make_state(module: &toolchain::Module) -> &State {
    let state = [
        module = module,
        loops = vector::make(LoopState),
        ditypes = map::make(type &typechecking::Type, type &Value),
        discope = vector::make(type &Value),
        current_block = make_block(),
        globals = map::make(type *),
        function_stack = vector::make(type &Function),
        mem = arena::make()
    ] !&State

    return state
}

export def predeclare_functions(module: &toolchain::Module) {
    let sc = module.scope
    if sc.imports {
        for var i in 0..vector::length(sc.imports) {
            let imprt = sc.imports(i)
            let m_scope = imprt.module.scope
            let keys = map::keys((@m_scope).fields)
            for var i in 0..keys.size {
                var value = m_scope.fields(keys(i))
                while value {
                    if value.share !int & parser::ShareMarker::EXPORT !int {
                        if value.kind == scope::ValueKind::FUNCTION {
                            if not typechecking::is_polymorph(value.tpe, module.scope) {
                                var fun: &Function
                                if value.node {
                                    fun = value.node.value.def_.function
                                } else {
                                    fun = predeclare_function(value.fdef, imprt.module, value.imported)
                                }
                                insert_function(module, fun)
                            }
                        } else if value.kind == scope::ValueKind::VALUE {
                            let name = value._assembly_name
                            let global = [
                                name = name,
                                tpe = value.tpe.resolve(module.scope),
                                external = true,
                                line = -1,
                                dllimport = value.dllimport,
                                dllexport = value.dllexport
                            ] !&Global
                            module.result.add_global(name, global)
                        }
                    }
                    value = value.next
                }
            }
        }
    }
}

export def generate_vtable_function(function: &Function, fdef: typechecking::FunctionDef, state: &State) {
    let ftpe = fdef.to_type().resolve()
    let first_param = ftpe.parameter_t(0).tpe

    debug::trace("Generating vtable function for ", fdef.name)

    function.block = make_block()
    function.forward_declare = false
    let previous_block = state.current_block
    state.current_block = function.block

    var ret_tpe: typechecking::TypeId
    if vector::length(ftpe.return_t) > 1 {
        ret_tpe = make_return_type(ftpe, state.module)
    } else if vector::length(ftpe.return_t) == 1 {
        ret_tpe = vector::peek(ftpe.return_t)
    }

    // Extract type
    let ref_tpe = state.extract_value(
        typechecking::pointer(builtins::type_t()), 
        [ kind = ValueKind::LOCAL, tpe = first_param, name = "__ref.value"] !Value,
        [2]
    )
    let tpe_deref = state.load(builtins::type_t(), ref_tpe)
    let tpe_id = state.extract_value(builtins::int64_, tpe_deref, [0])

    let switch_values = vector::make(SwitchValue)
    let swtch = make_insn(InsnKind::SWITCH)
    swtch.value.switch_ = [
        value = tpe_id,
        switch_values = switch_values
    ] !InsnSwitch
    push_insn(swtch, state)

    let intf = first_param.resolve()
    if intf.implementors {
        for var key in @intf.implementors.keys() {
            let functions = intf.implementors(key)
            let implementor = key.resolve()
            let hash = key !uint64

            //let generic = typechecking::get_generic(type_entry.tpe)
            //if generic and generic.tc_incomplete { continue }

            state.module.imported.add(implementor.type_name)

            let parameter_t = vector::copy(ftpe.parameter_t)
            parameter_t(0) = [ tpe = implementor.id ] !typechecking::NamedParameter
            
            var score = std::MAX_INT32 !int
            var fun: &typechecking::FunctionDef
            var module: &toolchain::Module = null

            for var f in functions {
                let fdef2 = f.fdef
                if function.unmangled != fdef2.unmangled { continue }
                //print_fdef(fdef)
                let score = typechecking::overload_score(fdef2, parameter_t, state.scope, true)
                //print_fdef(fdef2)
                //print("score: ", score, "\n")
                if score == 0 {
                    fun = fdef2
                    module = f.module
                    break
                }
            }

            var kind = 0
            if not fun {
                if function.unmangled.starts_with("__set_") and function.unmangled.ends_with("__") {
                    kind = 1
                } else if function.args.length == 1 {
                    kind = 2
                } else {
                    continue
                }
            } else {
                predeclare_function(@fun, state.module)
                state.module.imported.add(fun.name)

                if consteval::is_static {
                    let fun = scope::get_function(module.scope, parser::make_identifier(fun.unmangled), parameter_t, false, false, false)
                    let val = consteval::compile_function_no_queue(fun, state.scope)
                    import_structures(val.get_type(), state.module)
                }
            }

            if kind != 0 and implementor.kind != typechecking::TypeKind::REFERENCE { continue }

            import_structures(implementor, state.module)

            let if_true = make_label(state)
            push_label(if_true, state)
            
            let svalue = [
                label_ = if_true,
                value = [ kind = ValueKind::INT, i = hash, tpe = builtins::int64_ ] !Value
            ] !SwitchValue
            switch_values.push(svalue)

            let target_type = fun.to_type().resolve().parameter_t(0).tpe if fun else implementor.id
            let reference = convert_ref_to_ref(target_type, [ kind = ValueKind::LOCAL, tpe = first_param, name = "__ref.value"] !Value, null, state)
            
            if kind == 0 {
                let args = allocate_ref(Value, vector::length(ftpe.parameter_t))
                args(0) = reference
                for var i in 1..vector::length(ftpe.parameter_t) {
                    let np = ftpe.parameter_t(i)
                    args(i) = [ kind = ValueKind::LOCAL, tpe = np.tpe, name = np.name + ".value" ] !Value
                }
                let r = state.call(fun.name, ret_tpe, args)
                state.ret(r)
            } else if kind == 1 {
                // Setter 
                var deref = state.extract_value(pointer(implementor.tpe), reference, [1])
                var value = state.load(implementor.tpe, deref)
                let name = function.unmangled.slice(6, function.unmangled.length() - 2)
                var findex: size_t = 0
                for var field in @implementor.tpe.resolve().fields {
                    if field.name == name {
                        findex = field.index
                    }
                }

                let np = ftpe.parameter_t(1)
                let arg = [ kind = ValueKind::LOCAL, tpe = np.tpe, name = np.name + ".value" ] !Value
                value = state.insert_value(implementor.tpe, value, arg, [findex !int])
                state.store(deref, value)
                state.ret(NO_VALUE)
            } else {
                // Getter
                let name = function.unmangled
                
                var const_field: typechecking::StructMember
                var is_const = false
                let const_fields = implementor.tpe.resolve().const_fields
                if const_fields {
                    for var field in @const_fields {
                        if field.name == name {
                            is_const = true
                            const_field = field
                            break
                        }
                    }
                }

                if is_const {
                    let res = convert_to(null !&Value, @const_field.properties.value, ret_tpe, state)
                    state.ret(res)
                } else {
                    var stpe = implementor.tpe
                    // Resolve member
                    var deref = state.extract_value(pointer(stpe), reference, [1])
                    var value = state.load(stpe, deref)
                    value.addr = deref
                    
                    let vec = vector::make(Member)
                    if not resolve_member(vec, stpe, name) {
                        return
                    }

                    let len = vector::length(vec)
                    for var i in 0..len {
                        let j = len - i - 1
                        let member = vec(j)
                        value = walk_MemberAccess_struct(null, stpe, member, value, state)
                        stpe = member.tpe
                    }
                    let val = convert_to(null !&Value, load_value(value, null, state), ret_tpe, state)

                    increase_ref_count_of_value(val, null, state)
                    state.ret(val)
                }
            }
        }
    }

    let end_label = make_label(state)
    push_label(end_label, state)
    swtch.value.switch_.otherwise = end_label

    import_cstd_function("abort", state)
    state.call("abort", 0, [] ![Value])

    state.module.imported.add(function.name)
    push_insn(make_insn(InsnKind::UNREACHABLE), state)
    state.current_block = previous_block
}

def check_for_dependency(svalue: &scope::Value, node: &parser::Node) {
    if node.kind == parser::NodeKind::STRUCT_T or node.kind == parser::NodeKind::UNION_T {
        for var i in 0..node.value.body.length {
            let iddecl = node.value.body(i)
            if iddecl.kind == parser::NodeKind::ID_DECL_STRUCT {
                let tpe = node.value.id_decl_struct.tpe
                check_for_dependency(svalue, tpe)
            } else {
                check_for_dependency(svalue, iddecl)
            }
        }
    } else {
        // TODO This could also refer to functions and other complex types
        scope::create_dependency_on_type(svalue, node)
    }
}

def verify_struct(value: &scope::Value, node: &parser::Node) {
    for var i in 0..node.value.body.length {
        let member = node.value.body(i)
        if member.kind == parser::NodeKind::STRUCT_T or
            member.kind == parser::NodeKind::UNION_T {
            verify_struct(value, member)
        } else {
            let tpe = member.value.id_decl_struct.tpe
            scope::create_dependency_on_type(value, tpe)
        }
    }
}

/*export def verify_function(node: &parser::Node) {
    if not node or not node.tpe { return }

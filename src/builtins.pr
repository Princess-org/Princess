import parser
import scope
import map
import vector
import typechecking
import compiler
import toolchain

typechecking::load_type_registries()

export let builtins = scope::enter_scope()
export let builtins_module = toolchain::make_module(null, "builtin", null, builtins)
builtins_module.stage = toolchain::Stage::COMPILING
builtins.module = builtins_module

def create_int_type(name: String, size: size_t, unsig: bool) -> typechecking::TypeId {
    let ident = parser::make_identifier(name)
    var tpe = [] !&typechecking::Type
    tpe.kind = typechecking::TypeKind::WORD
    tpe.id = typechecking::next_type_id()
    tpe.name = name
    tpe.type_name = "builtins::" + name
    tpe.size = size
    tpe.align = size
    tpe.unsig = unsig
    tpe.defmodule = builtins_module
    typechecking::register(tpe.id, tpe)
    scope::create_type(builtins, ident, parser::ShareMarker::EXPORT, typechecking::make_type_ref(tpe.id))
    return tpe.id
}

def create_float_type(name: String, size: size_t) -> typechecking::TypeId {
    let ident = parser::make_identifier(name)
    var tpe = [] !&typechecking::Type
    tpe.kind = typechecking::TypeKind::FLOAT
    tpe.id = typechecking::next_type_id()
    tpe.name = name
    tpe.type_name = "builtins::" + name
    tpe.size = size
    tpe.align = size
    tpe.unsig = false
    tpe.defmodule = builtins_module
    typechecking::register(tpe.id, tpe)
    scope::create_type(builtins, ident, parser::ShareMarker::EXPORT, typechecking::make_type_ref(tpe.id))
    return tpe.id
}

let char_ident = parser::make_identifier("char")
let char_t = [] !&typechecking::Type
char_t.kind = typechecking::TypeKind::CHAR
char_t.id = typechecking::next_type_id()
char_t.name = "char"
char_t.type_name = "builtins::char"
char_t.size = size_of char
char_t.align = align_of char
char_t.unsig = true
char_t.defmodule = builtins_module
typechecking::register(char_t.id, char_t)
scope::create_type(builtins, char_ident, parser::ShareMarker::EXPORT, typechecking::make_type_ref(char_t.id))
export let char_ = char_t.id

let bool_ident = parser::make_identifier("bool")
let bool_t = [] !&typechecking::Type
bool_t.kind = typechecking::TypeKind::BOOL
bool_t.id = typechecking::next_type_id()
bool_t.name = "bool"
bool_t.type_name = "builtins::bool"
bool_t.size = (size_of bool)
bool_t.align = (align_of bool)
// This isn't very well defined, but I guess we need this for treating bool as an arithmetic type
bool_t.unsig = true
bool_t.defmodule = builtins_module
typechecking::register(bool_t.id, bool_t)
scope::create_type(builtins, bool_ident, parser::ShareMarker::EXPORT, typechecking::make_type_ref(bool_t.id))
export let bool_ = bool_t.id

export let string_ = typechecking::array(char_)
scope::create_type(builtins, parser::make_identifier("string"), parser::ShareMarker::EXPORT, typechecking::make_type_ref(string_))

export def get_int_of_size(size: size_t, unsig: bool) -> typechecking::TypeId {
    if unsig {
        switch size {
            case 1; return uint8_
            case 2; return uint16_
            case 4; return uint32_
            case 8; return uint64_
            case 16; return uint128_
        }
    } else {
        switch size {
            case 1; return int8_
            case 2; return int16_
            case 4; return int32_
            case 8; return int64_
            case 16; return int128_
        }
    }
    return 0 
}

def register(name: Str, tpe: typechecking::TypeId) -> typechecking::TypeId {
    scope::create_type(builtins, parser::make_identifier(name), parser::ShareMarker::EXPORT, typechecking::make_type_ref(tpe))
    return tpe
}

export let float32_ = create_float_type("float32", size_of float32)
export let float64_ = create_float_type("float64", size_of float64)
export let float80_ = create_float_type("float80", size_of float80)
export let float_   = register("float", float32_)
export let double_  = register("double", float64_)

export let int8_    = create_int_type("int8", size_of int8, false)
export let int16_   = create_int_type("int16", size_of int16, false)
export let int32_   = create_int_type("int32", size_of int32, false)
export let int64_   = create_int_type("int64", size_of int64, false)
export let int128_  = create_int_type("int128", 16, false)

export let uint8_   = create_int_type("uint8", size_of uint8, true)
export let uint16_  = create_int_type("uint16", size_of uint16, true)
export let uint32_  = create_int_type("uint32", size_of uint32, true)
export let uint64_  = create_int_type("uint64", size_of uint64, true)
export let uint128_ = create_int_type("uint128", 16, true)

export let byte_    = register("byte", get_int_of_size(size_of byte, false))
export let short_   = register("short", get_int_of_size(size_of short, false))
export let int_     = register("int", get_int_of_size(size_of int, false))
export let long_    = register("long", get_int_of_size(size_of long, false))

export let ubyte_   = register("ubyte", get_int_of_size(size_of ubyte, true))
export let ushort_  = register("ushort", get_int_of_size(size_of ushort, true))
export let uint_    = register("uint", get_int_of_size(size_of uint, true))
export let ulong_   = register("ulong", get_int_of_size(size_of ulong, true))

export let size_t_  = register("size_t", get_int_of_size(size_of size_t, true))


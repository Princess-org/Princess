// This one gets set by toolchain
//export var File_: typechecking::TypeId

export var Type_: typechecking::TypeId
export def type_t -> typechecking::TypeId {
    if Type_ { return Type_ }
    Type_ = scope::get_type_id(toolchain::runtime_.scope, make_identifier("Type"))
    return Type_
}

export var Ref_: typechecking::TypeId
export def ref_t -> typechecking::TypeId {
    if Ref_ { return Ref_ }
    Ref_ = scope::get_type_id(toolchain::runtime_.scope, make_identifier("Ref"))
    return Ref_
}

export var Generator_: typechecking::TypeId
export def generator_t -> typechecking::TypeId {
    if Generator_ { return Generator_ }
    Generator_ = scope::get_type_id(toolchain::runtime_.scope, make_identifier("Generator"))
    return Generator_
}

export var TestEnvironment_: typechecking::TypeId
export def test_environment_t -> typechecking::TypeId {
    if TestEnvironment_ { return TestEnvironment_ }
    TestEnvironment_ = scope::get_type_id(toolchain::runtime_.scope, make_identifier("TestEnvironment"))
    return TestEnvironment_
}

export var TypeT_: typechecking::TypeId
export def reflection_type_t -> typechecking::TypeId {
    if TypeT_ { return TypeT_ }
    let reflection = toolchain::find_module("reflection")
    if not reflection { return 0 }
    let value = reflection.scope.get(parser::make_identifier("Type"), force_compile = false)
    if value {
        TypeT_ = value.tpe.resolve(reflection.scope)
    }
    return TypeT_
}
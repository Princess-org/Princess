import vector
import set
import map
import util
import typechecking
import compiler
import scope
import debug
import toolchain
import builtins
import strings

// TODO Passing via global variables, eugh
export var cresult: &compiler::Result
var cstart_index: int

def output(fp: File, a: type A) {
    fprint(fp, to_string(a).to_str())
}
def output(fp: File, a: type A, b: type B) {
    fprint(fp, to_string(a).to_str())
    fprint(fp, to_string(b).to_str())
}
def output(fp: File, a: type A, b: type B, c: type C) {
    fprint(fp, to_string(a).to_str())
    fprint(fp, to_string(b).to_str())
    fprint(fp, to_string(c).to_str())
}
def output(fp: File, a: type A, b: type B, c: type C, d: type D) {
    fprint(fp, to_string(a).to_str())
    fprint(fp, to_string(b).to_str())
    fprint(fp, to_string(c).to_str())
    fprint(fp, to_string(d).to_str())
}

def type_to_str(tpe: &typechecking::Type) -> Str {
    if not tpe { return "void" }
    var ret: StringBuffer = ""
    switch tpe.kind !int {
        case typechecking::TypeKind::BOOL
            ret = "i1"
        case typechecking::TypeKind::CHAR
            ret = "i8"
        case typechecking::TypeKind::WORD
            ret = "i" + tpe.size * 8
        case typechecking::TypeKind::FLOAT
            // TODO We might want to support float128 as a different type
            switch tpe.size {
                case 4; ret = "float"
                case 8; ret = "double"
                case 16; ret = "x86_fp80"
                case; assert
            }
        case typechecking::TypeKind::POINTER, typechecking::TypeKind::BYREF
            ret += "ptr"
        case typechecking::TypeKind::REFERENCE, typechecking::TypeKind::WEAK_REF
            ret += "{ptr, ptr, ptr}"
        case typechecking::TypeKind::ARRAY
            let tpe_tpe = tpe.tpe.resolve()
            ret = "{i" + (size_of size_t) * 8 + ", ptr}"
        case typechecking::TypeKind::STATIC_ARRAY
            assert tpe.length !uint64 < std::MAX_UINT64
            ret = "[" + tpe.length + " x " + type_to_str(tpe.tpe) + ']'
        case typechecking::TypeKind::STRUCT, typechecking::TypeKind::CLOSURE
            if tpe.kind == typechecking::TypeKind::CLOSURE or tpe.is_literal {
                // TODO We might need real anonymous structs at some point
                // Anonymous struct
                ret = "{"
                let len = vector::length(tpe.field_types)
                for var i in 0..len {
                    let type_member = tpe.field_types(i)
                    ret += type_to_str(type_member.tpe)
                    if i < len - 1 {
                        ret += ", "
                    }
                }
                ret += '}'
            } else {
                var name = debug::type_to_str(tpe, full_name = true)
                ret = "%\"" + name + '"'
            }
        case typechecking::TypeKind::TUPLE
            ret = "{"
            let len = vector::length(tpe.return_t)
            for var i in 0..len {
                ret += type_to_str(tpe.return_t(i))
                if i < len - 1 {
                    ret += ", "
                }
            }
            ret += '}'
        case typechecking::TypeKind::UNION
            if tpe.is_literal {
                ret = "{"
                ret += type_to_str([ kind = typechecking::TypeKind::WORD, size = tpe.align ] !&typechecking::Type)
                if tpe.size > tpe.align {
                    ret += ", "
                    ret += type_to_str(typechecking::static_array(builtins::int8_, tpe.size - tpe.align))
                }
                ret += "}"
            } else {
                var name = debug::type_to_str(tpe, full_name = true)
                ret = "%\"" + name + '"'
            }
        case typechecking::TypeKind::TUNION
            ret = "{ptr, "
            ret += type_to_str(tpe.tpe)
            ret += "}"
        case typechecking::TypeKind::ENUM
            ret = type_to_str(tpe.tpe)
        case typechecking::TypeKind::FUNCTION
            assert vector::length(tpe.return_t) <= 1
            if vector::length(tpe.return_t) == 1 {
                ret = type_to_str(tpe.return_t(0))
            } else {
                ret = "void"
            }
            ret += " ("
            let len = vector::length(tpe.parameter_t)
            for var i in 0..len {
                let param = tpe.parameter_t(i)
                ret += named_parameter_to_str(param)
                if i < len - 1 {
                    ret += ", "
                }
            }
            ret += ')'
        case typechecking::TypeKind::NULL
            ret = "null"
        case typechecking::TypeKind::OPAQUE
            ret = "%\"" + tpe.type_name + '"'
        case typechecking::TypeKind::TO_INFER
            ret = "<?>"
        //case typechecking::TypeKind::GENERIC
        //    ret = "<ERROR>"
        case typechecking::TypeKind::TYPE
            ret = "{ptr, ptr, ptr}"
        case typechecking::TypeKind::UNDEF
            ret = "undef"
        case
            error(debug::type_to_str(tpe), "\n")
            error(tpe.kind, "\n")
            assert
    }
    return ret
}

def metadata_to_str(name: Str) -> Str {
    if cresult and name.starts_with("!") {
        var index = cresult.meta_mapping.get_or_default(name, -1)
        if index == -1 {
            index = cstart_index
            cresult.meta_mapping(name) = index
            cstart_index += 1
        }
        name = to_string(index)
    }
    return name
}

def debug_value_to_str(value: compiler::DebugValue) -> Str {
    var ret: StringBuffer = ""
    switch value.kind !int {
        case compiler::DebugValueKind::NULL
            ret = "null"
        case compiler::DebugValueKind::STRING
            ret = util::repr(value.s, false)
        case compiler::DebugValueKind::INT
            ret = to_string(value.i)
        case compiler::DebugValueKind::BOOL
            if value.i {
                ret = "true"
            } else {
                ret = "false"
            }
        case compiler::DebugValueKind::CONST
            ret = value.name
        case compiler::DebugValueKind::METADATA
            ret = "!" + metadata_to_str(value.name)
        case compiler::DebugValueKind::DIEXP
            ret = "!DIExpression()"
    }
    return ret
}

export def value_to_str(value: compiler::Value) -> Str {
    var ret: StringBuffer
    let value_tpe = value.tpe.resolve()
    switch value.kind !int {
        case compiler::ValueKind::ZEROINITIALIZER
            ret = "zeroinitializer"
        case compiler::ValueKind::NULL
            ret = "null"
        case compiler::ValueKind::UNDEF
            ret = "undef"
        case compiler::ValueKind::METADATA
            ret = "!" + metadata_to_str(value.name)
        case compiler::ValueKind::LOCAL
            ret = "%" + value.name
        case compiler::ValueKind::GLOBAL
            ret = "@\"" + value.name + '"'
        case compiler::ValueKind::BOOL
            if value.i {
                ret = "true"
            } else {
                ret = "false"
            }
        case compiler::ValueKind::INT
            if value_tpe.unsig {
                ret = to_string(value.i !uint64)
            } else {
                ret = to_string(value.i)
            }
            if value_tpe.kind == typechecking::TypeKind::FLOAT {
                ret += ".0"
            }
        case compiler::ValueKind::FLOAT
            ret = util::double_to_hex_str(value.f)
        case compiler::ValueKind::STRUCT
            ret = ""
            if value.metadata {
                ret += '!'
            }
            ret += '{'
            for var i in 0..value.values.size {
                // TODO Figure out why we need that cast
                let val = value.values(i) !compiler::Value
                if val.tpe {
                    ret += type_to_str(val.tpe) + ' '
                }
                ret += value_to_str(val)
                if i < value.values.size - 1 {
                    ret += ", "
                }
            }
            ret += '}'
        case compiler::ValueKind::ARRAY
            ret = "["
            for var i in 0..value.values.size {
                let val = value.values(i) !compiler::Value
                if val.tpe {
                    ret += type_to_str(val.tpe) + ' '
                }
                ret += value_to_str(val)
                if i < value.values.size - 1 {
                    ret += ", "
                }
            }
            ret += ']'
        case compiler::ValueKind::STRING
            if value.metadata {
                ret = "!"
            } else {
                ret = "c"
            }
            ret += util::repr(value.s, not value.metadata)
        case compiler::ValueKind::DEBUG_INFO
            ret = ""
            if value.distinct {
                ret += "distinct "
            }
            ret += '!' + value.name + '('
            for var i in 0..value.debug_values.size {
                let val = value.debug_values(i) !compiler::DebugParam
                ret += val.name + ": " + debug_value_to_str(val.value)
                if i < value.debug_values.size - 1 {
                    ret += ", "
                }
            }
            ret += ')'
        case
            error(value.kind, "\n")
            assert
    }
    return ret
}

def named_parameter_to_str(named: typechecking::NamedParameter) -> Str {
    var ret: StringBuffer = ""
    var tpe = named.tpe
    if named.varargs {
        if tpe {
            ret += "{i" + (size_of size_t) * 8 + ", ptr}"
        } else {
            ret += "..."
        }
    } else {
        ret += type_to_str(tpe)
    }
    return ret
}

def emit_arithmetic(fp: File, name: string, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.arith.ret))
    output(fp, " = ")
    output(fp, name, " ")
    output(fp, type_to_str((@insn).value.arith.ret.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.arith.left))
    output(fp, ", ")
    output(fp, value_to_str((@insn).value.arith.right))
}

def emit_ret(fp: File, insn: &compiler::Insn) {
    output(fp, "ret ")
    output(fp, type_to_str((@insn).value.ret.value.tpe))
    if (@insn).value.ret.value.tpe {
        output(fp, " ", value_to_str((@insn).value.ret.value))
    }
}

def emit_call(fp: File, insn: &compiler::Insn) {
    if (@insn).value.call.ret.tpe {
        output(fp, value_to_str((@insn).value.call.ret))
        output(fp, " = ")
    }
    output(fp, "call ")
    output(fp, type_to_str((@insn).value.call.ret.tpe))
    output(fp, " ")
    if (@insn).value.call.proto {
        let protosize = insn.value.call.proto.size
        output(fp, "(")
        for var i in 0..protosize {
            let arg = (@insn).value.call.proto(i)
            output(fp, named_parameter_to_str(arg))
            
            if i < protosize - 1 {
                output(fp, ", ")
            }
        }
        output(fp, ") ")
    }
    output(fp, value_to_str((@insn).value.call.name))
    output(fp, "(")
    let argsize = (@insn).value.call.args.size
    for var i in 0..argsize {
        let arg = (@insn).value.call.args(i)
        if arg.metadata {
            output(fp, "metadata ")
        }
        if arg.tpe {
            output(fp, type_to_str(arg.tpe), " ")
        }
        output(fp, value_to_str(arg))
        if i < argsize - 1 {
            output(fp, ", ")
        }
    }
    output(fp, ")")
}

def emit_alloca(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.alloca.ret))
    output(fp, " = alloca ")
    output(fp, type_to_str((@insn).value.alloca.ret.tpe))
}

def emit_store(fp: File, insn: &compiler::Insn) {
    output(fp, "store ")
    output(fp, type_to_str((@insn).value.store.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.store.value))
    output(fp, ", ")
    output(fp, type_to_str((@insn).value.store.loc.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.store.loc))
}

def emit_load(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.load.value))
    output(fp, " = load ")
    output(fp, type_to_str((@insn).value.load.value.tpe))
    output(fp, ", ")
    output(fp, type_to_str((@insn).value.load.loc.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.load.loc))
}

def emit_br(fp: File, insn: &compiler::Insn) {
    output(fp, "br ")
    output(fp, type_to_str((@insn).value.br.cond.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.br.cond))
    output(fp, ", label %")
    output(fp, (@insn).value.br.if_true.name)
    output(fp, ", label %")
    output(fp, (@insn).value.br.if_false.name)
}

def emit_br_unc(fp: File, insn: &compiler::Insn) {
    output(fp, "br label %")
    output(fp, (@insn).value.br_unc.label_.name)
}

def emit_insert_value(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.insert_value.ret))
    output(fp, " = insertvalue ")
    output(fp, type_to_str((@insn).value.insert_value.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.insert_value.value))
    output(fp, ", ")
    output(fp, type_to_str((@insn).value.insert_value.element.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.insert_value.element))
    output(fp, ", ")

    let index = (@insn).value.insert_value.index
    for var i in 0..index.size {
        output(fp, index(i))
        if i < index.size - 1 {
            output(fp, ", ")
        }
    }
}

def emit_extract_value(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.extract_value.ret))
    output(fp, " = extractvalue ")
    output(fp, type_to_str((@insn).value.extract_value.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.extract_value.value))
    output(fp, ", ")

    let index = (@insn).value.extract_value.index
    for var i in 0..index.size {
        output(fp, index(i))
        if i < index.size - 1 {
            output(fp, ", ")
        }
    }
}

def emit_convert(fp: File, name: string, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.convert.ret))
    output(fp, " = ", name, " ")
    output(fp, type_to_str((@insn).value.convert.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.convert.value))
    output(fp, " to ")
    output(fp, type_to_str((@insn).value.convert.ret.tpe))
}

def emit_gep(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.gep.ret))
    output(fp, " = getelementptr inbounds ")
    output(fp, type_to_str((@insn).value.gep.tpe))
    output(fp, ", ")
    output(fp, type_to_str((@insn).value.gep.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.gep.value))
    output(fp, ", ")
        
    let index = (@insn).value.gep.index
    for var i in 0..index.size {
        output(fp, type_to_str(index(i).tpe))
        output(fp, " ")
        output(fp, value_to_str(index(i)))
        if i < index.size - 1 {
            output(fp, ", ")
        }
    }
}

def emit_icmp(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.icmp.ret))
    output(fp, " = icmp ", (@insn).value.icmp.op.to_string(), " ")
    output(fp, type_to_str((@insn).value.icmp.left.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.icmp.left))
    output(fp, ", ")
    output(fp, value_to_str((@insn).value.icmp.right))
}

def emit_fcmp(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.fcmp.ret))
    output(fp, " = fcmp ", (@insn).value.fcmp.op.to_string(), " ")
    output(fp, type_to_str((@insn).value.fcmp.left.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.fcmp.left))
    output(fp, ", ")
    output(fp, value_to_str((@insn).value.fcmp.right))
}


def emit_fneg(fp: File, insn: &compiler::Insn) {
    output(fp, value_to_str((@insn).value.fneg.ret))
    output(fp, " = fneg ")
    output(fp, type_to_str((@insn).value.fneg.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.fneg.value))
}

def emit_switch(fp: File, insn: &compiler::Insn) {
    output(fp, "switch ")
    output(fp, type_to_str((@insn).value.switch_.value.tpe))
    output(fp, " ")
    output(fp, value_to_str((@insn).value.switch_.value))
    output(fp, ", label %")
    output(fp, (@insn).value.switch_.otherwise.name)
    output(fp, " [\n")
    for var i in 0..vector::length((@insn).value.switch_.switch_values) {
        let sw = (@insn).value.switch_.switch_values(i)
        output(fp, "\t\t")
        output(fp, type_to_str(sw.value.tpe))
        output(fp, " ")
        output(fp, value_to_str(sw.value))
        output(fp, ", label %")
        output(fp, sw.label_.name)
        output(fp, "\n")
    }
    output(fp, "\t]")
}

export def emit(fp: File, insn: &compiler::Insn) {
    output(fp, "\t")
    switch (@insn).kind !int {
        case compiler::InsnKind::FNEG
            emit_fneg(fp, insn)
        case compiler::InsnKind::ADD
            emit_arithmetic(fp, "add", insn)
        case compiler::InsnKind::FADD
            emit_arithmetic(fp, "fadd", insn)
        case compiler::InsnKind::SUB
            emit_arithmetic(fp, "sub", insn)
        case compiler::InsnKind::FSUB
            emit_arithmetic(fp, "fsub", insn)
        case compiler::InsnKind::MUL
            emit_arithmetic(fp, "mul", insn)
        case compiler::InsnKind::FMUL
            emit_arithmetic(fp, "fmul", insn)
        case compiler::InsnKind::SREM
            emit_arithmetic(fp, "srem", insn)
        case compiler::InsnKind::UREM
            emit_arithmetic(fp, "urem", insn)
        case compiler::InsnKind::FREM
            emit_arithmetic(fp, "frem", insn)
        case compiler::InsnKind::SDIV
            emit_arithmetic(fp, "sdiv", insn)
        case compiler::InsnKind::UDIV
            emit_arithmetic(fp, "udiv", insn)
        case compiler::InsnKind::FDIV
            emit_arithmetic(fp, "fdiv", insn)
        case compiler::InsnKind::AND
            emit_arithmetic(fp, "and", insn)
        case compiler::InsnKind::OR
            emit_arithmetic(fp, "or", insn)
        case compiler::InsnKind::XOR
            emit_arithmetic(fp, "xor", insn)
        case compiler::InsnKind::ASHR
            emit_arithmetic(fp, "ashr", insn)
        case compiler::InsnKind::LSHR
            emit_arithmetic(fp, "lshr", insn)
        case compiler::InsnKind::SHL
            emit_arithmetic(fp, "shl", insn)
        case compiler::InsnKind::TRUNC
            emit_convert(fp, "trunc", insn)
        case compiler::InsnKind::ZEXT
            emit_convert(fp, "zext", insn)
        case compiler::InsnKind::SEXT
            emit_convert(fp, "sext", insn)
        case compiler::InsnKind::FPTRUNC
            emit_convert(fp, "fptrunc", insn)
        case compiler::InsnKind::FPEXT
            emit_convert(fp, "fpext", insn)
        case compiler::InsnKind::FPTOUI
            emit_convert(fp, "fptoui", insn)
        case compiler::InsnKind::FPTOSI
            emit_convert(fp, "fptosi", insn)
        case compiler::InsnKind::UITOFP
            emit_convert(fp, "uitofp", insn)
        case compiler::InsnKind::SITOFP
            emit_convert(fp, "sitofp", insn)
        case compiler::InsnKind::PTRTOINT
            emit_convert(fp, "ptrtoint", insn)
        case compiler::InsnKind::INTTOPTR
            emit_convert(fp, "inttoptr", insn)
        case compiler::InsnKind::BITCAST
            emit_convert(fp, "bitcast", insn)
        case compiler::InsnKind::ICMP
            emit_icmp(fp, insn)
        case compiler::InsnKind::FCMP
            emit_fcmp(fp, insn)
        case compiler::InsnKind::SWITCH
            emit_switch(fp, insn)
        case compiler::InsnKind::GETELEMENTPTR
            emit_gep(fp, insn)
        case compiler::InsnKind::INSERTVALUE
            emit_insert_value(fp, insn)
        case compiler::InsnKind::EXTRACTVALUE
            emit_extract_value(fp, insn)
        case compiler::InsnKind::ALLOCA
            emit_alloca(fp, insn)
        case compiler::InsnKind::STORE
            emit_store(fp, insn)
        case compiler::InsnKind::LOAD
            emit_load(fp, insn)
        case compiler::InsnKind::CALL
            emit_call(fp, insn)
        case compiler::InsnKind::BR
            emit_br(fp, insn)
        case compiler::InsnKind::BR_UNC
            emit_br_unc(fp, insn)
        case compiler::InsnKind::RET
            emit_ret(fp, insn)
        case compiler::InsnKind::UNREACHABLE
            output(fp, "unreachable")
        case 
            assert(false)
    }
    if (@insn).debug {
        output(fp, ", !dbg ")
        output(fp, value_to_str(@(@insn).debug))
    }
    output(fp, "\n")
}

export def emit_block(fp: File, block: &compiler::Block) {
    output(fp, (@block).label_)
    output(fp, ":\n")
    for var i in 0..vector::length((@block).insn) {
        let insn = (@block).insn(i)
        emit(fp, insn)
    }
}

def emit_function(fp: File, function: &compiler::Function, module: &toolchain::Module) {
    // TODO Everything in type has the wrong module, fix this elsewhere instead of just relying on it here
    let forward_declare = function.forward_declare or (function.module != module and module.module != "type") 
    if function.meta_hash {
        output(fp, "; ", strings::int_to_hex_str(function.meta_hash, prefix = false), "\n")
    }

    if forward_declare {
        output(fp, "declare ")
    } else {
        output(fp, "define ")

        if function.metadata {
            for var k in @function.metadata.keys() {
                cresult.metadata(k) = function.metadata(k)
            }
        }
    }
    if function.dllimport {
        output(fp, "dllimport ")
    }

    if toolchain::is_shared {
        if function.dllexport {
            output(fp, "dllexport ")
        } else if not forward_declare {
            output(fp, "hidden ")
        }
    }
    
    output(fp, type_to_str((@function).ret), " ")
    output(fp, "@\"", (@function).name, "\"(")

    let len = vector::length((@function).args)
    for var i in 0..len {
        let np = (@function).args(i)
        if np.tpe and np.tpe.kind == typechecking::TypeKind::TYPE { continue }
        output(fp, named_parameter_to_str(np))

        if not (@function).forward_declare {
            output(fp, " ")
            output(fp, "%", np.name, ".value")
        }
        if i < len - 1 {
            output(fp, ", ")
        }
    }

    output(fp, ")")
    if (@function).debug and not forward_declare {
        output(fp, " !dbg ")
        output(fp, value_to_str(@(@function).debug))
    }
    if not forward_declare {
        output(fp, " {\n")
        var block = (@function).block
        while block {
            emit_block(fp, block)
            block = (@block).next
        }
        output(fp, "}\n")
    } else {
        output(fp, "\n")
    }
}

def emit_structure(fp: File, structure: &typechecking::Type) {
    #if not defined WIN32 {
        if structure == builtins::__va_list_tag_ { return }
    }

    var name = debug::type_to_str(structure, full_name = true)

    output(fp, "%\"", name, "\"")
    output(fp, " = type ")
    if (@structure).packed {
        output(fp, "<")
    }
    output(fp, "{")
    let len = vector::length(structure.field_types)
    for var i in 0..len {
        let type_member = structure.field_types(i)
        output(fp, type_to_str(type_member.tpe))
        if i < len - 1 {
            output(fp, ", ")
        }
    }
    output(fp, "}")
    if (@structure).packed {
        output(fp, ">")
    }
    output(fp, "\n")
}

def emit_union(fp: File, union_: &typechecking::Type) {
    var name = union_.type_name
    if not name {
        name = "<anonymous " + union_._hash + ">"
    }

    output(fp, "%\"", name, "\"")
    output(fp, " = type {")
    output(fp, type_to_str([ kind = typechecking::TypeKind::WORD, size = union_.align ] !&typechecking::Type))
    if union_.size > union_.align {
        output(fp, ", ", type_to_str(typechecking::static_array(builtins::int8_, union_.size - union_.align)))
    }
    output(fp, "}\n")
}

def emit_opaque(fp: File, stub: &typechecking::Type) {
    output(fp, "%\"", (@stub).type_name, "\"")
    output(fp, " = type opaque\n")
}

def emit_global(fp: File, global: &compiler::Global) {
    output(fp, "@\"", global.name, "\"")
    output(fp, " = ")
    if global.external {
        output(fp, "external ")
    }
    if global.private {
        output(fp, "private ")
    }
    if global.dllimport {
        output(fp, "dllimport ")
    }

    if toolchain::is_shared {
        if global.dllexport {
            output(fp, "dllexport ")
        } else if not global.private and not global.external {
            output(fp, "hidden ")
        }
    }
    
    output(fp, "global ")
    
    output(fp, type_to_str(global.tpe))
    output(fp, " ")
    if global.value {
        output(fp, value_to_str(@global.value))
    } else if not global.external {
        output(fp, "zeroinitializer")
    }
    if global.debug {
        output(fp, ", !dbg ")
        output(fp, value_to_str(@global.debug))
    }
    output(fp, "\n")
}

def gen_main_function(fp: File) {
    if toolchain::is_shared { return }
    output(fp, "define i32 @main(i32 %argc, ptr %argv) {\n")
    output(fp, "\t%size = zext i32 %argc to i64\n")
    output(fp, "\t%size.1 = mul i64 %size, ", size_of string, "\n")
    output(fp, "\t%args = call ptr @malloc(i64 %size.1)\n")
    output(fp, "\t%args.1 = insertvalue {i64, ptr} undef, i64 %size, 0\n")
    output(fp, "\t%args.2 = insertvalue {i64, ptr} %args.1, ptr %args, 1\n")
    output(fp, "\t%i = alloca i32\n")
    output(fp, "\tstore i32 0, ptr %i\n")
    output(fp, "\tbr label %loop\n")
    output(fp, "loop:\n")
    output(fp, "\t%i.1 = load i32, ptr %i\n")
    output(fp, "\t%cond = icmp eq i32 %argc, %i.1\n")
    output(fp, "\tbr i1 %cond, label %end, label %inner\n")
    output(fp, "inner:\n")
    output(fp, "\t%arg = getelementptr ptr, ptr %argv, i32 %i.1\n")
    output(fp, "\t%arg.1 = load ptr, ptr %arg\n")
    output(fp, "\t%arg.2 = getelementptr {i64, ptr}, ptr %args, i32 %i.1\n")
    output(fp, "\t%arglen = call i64 @strlen(ptr %arg.1)\n")
    output(fp, "\t%arglen.1 = add i64 %arglen, 1\n")
    output(fp, "\t%arg.3 = insertvalue {i64, ptr} undef, i64 %arglen.1, 0\n")
    output(fp, "\t%arg.4 = insertvalue {i64, ptr} %arg.3, ptr %arg.1, 1\n")
    output(fp, "\tstore {i64, ptr} %arg.4, ptr %arg.2\n")
    output(fp, "\t%i.2 = add i32 %i.1, 1\n")
    output(fp, "\tstore i32 %i.2, ptr %i\n")
    output(fp, "\tbr label %loop\n")
    output(fp, "end:\n")
    output(fp, "\tcall void @\"main::__main__::([[char]])\"({i64, ptr} %args.2)\n")
    output(fp, "\tcall void @\"main::__finalizer__::()\"()\n")
    output(fp, "\tcall void @free(ptr %args)\n")
    output(fp, "\tret i32 0\n")
    output(fp, "}\n")
}

def gen_header(fp: File, module: &toolchain::Module) {
    output(fp, "source_filename = \"", module.filename, "\"\n")
    #if defined WIN32 {
        output(fp, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"\n")
        output(fp, "target triple = \"x86_64-pc-windows-msvc\"\n")
    } else {
        output(fp, "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"\n")
        output(fp, "target triple = \"x86_64-pc-linux-gnu\"\n")
        output(fp, "%__va_list_tag = type { i32, i32, ptr, ptr }\n")
    }
}

export def gen(module: &toolchain::Module) {

    if module.stage !int >= toolchain::Stage::CODEGEN { return }
    module.stage = toolchain::Stage::CODEGEN
    
    toolchain::progress_update(module, toolchain::ProgressUpdate::START)
    cresult = module.result

    let outfile = toolchain::outfolder + '/' + module.file + ".ll"
    let fp = open(outfile, "w")
    
    output(fp, "; This file was compiled by the grace of your highness Princess Vic Nightfall\n")

    gen_header(fp, module)

    if module.module == "main" {
        gen_main_function(fp)
    }

    for var key in @cresult.structures.keys() {
        let structure = cresult.structures(key).resolve()
        switch structure.kind !int {
            case typechecking::TypeKind::STRUCT
                emit_structure(fp, structure)
            case typechecking::TypeKind::UNION
                emit_union(fp, structure)
            case typechecking::TypeKind::OPAQUE
                emit_opaque(fp, structure)
        }
    }

    for var key in @cresult.functions.keys() {
        let function = cresult.functions(key)
        if function.ditypes {
            cresult.ditypes.add_all(function.ditypes)
        }
        if function.module == module and function.companion_functions {
            for var df in function.companion_functions {
                if df.ditypes { cresult.ditypes.add_all(df.ditypes) }
                cresult.functions(df.name) = df
                module.imported.add(df.name)
            }
        }
    }

    // TODO inefficient looping over the entire set repeatedly
    let generated_types = set::make(typechecking::TypeId)
    loop {
        var before = cresult.metadata.size
        for var tpe in @cresult.ditypes.keys() {
            if generated_types.contains(tpe) { continue }
            let value = compiler::di_type_gen(tpe, module.compiler_state)
            let name = compiler::di_type_name(tpe)
            cresult.metadata(name) = value
            generated_types.add(tpe)
        }
        if cresult.metadata.size == before { break }
    }
    

    cstart_index = (cresult.metadata.size - 1) !int

    // TODO Sometimes in the compiler there might be multiple cases
    // of the same function defined under different names. We should only emit one of them.
    // This can happen if consteval incorrectly creates a name on a partial result 
    // like strings::to_str(type String) and then later on the same function is
    // created with the correct name as strings::to_str(strings::String). Both
    // of them will have the correct function.name set though, so we can use that to deduplicate them.
    let deduplicate = set::make()
    for var key in @cresult.functions.keys() {
        let function = cresult.functions(key)
        if map::contains(module.imported, (@function).name) {
            if deduplicate.contains(function.name) { continue }
            deduplicate.add(function.name)
            emit_function(fp, function, module)
            if function.constants {
                for var k in @function.constants.keys() {
                    emit_global(fp, function.constants(k))
                }
            }
        }
    }

    for var key in @cresult.globals.keys() {
        let global = cresult.globals(key)
        if not global.is_function_scoped and 
            (global.private or map::contains(module.imported, global.name)) and
            not cresult.functions.contains(global.name) { // If there's already a function with that name we do skip it
            emit_global(fp, global)
        }
    }
    
    if toolchain::debug_sym {
        output(fp, "declare void @llvm.dbg.declare(metadata, metadata, metadata)\n")
    }
    
    let keys_meta = map::keys(cresult.metadata)
    for var key in @keys_meta {
        let value = cresult.metadata(key)
        if key.starts_with("!") {
            output(fp, "; ", key, "\n")
        }
        output(fp, "!", metadata_to_str(key))
        output(fp, " = ")
        output(fp, value_to_str(@value))
        output(fp, "\n")
    }
    
    close(fp)
    toolchain::progress_update(module, toolchain::ProgressUpdate::END)
}
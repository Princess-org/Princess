import vector
import map

import compiler

export type Opcode = enum uint8 {
    NOP = 0;

    ADD64; SUB64; MUL64; SREM64; UREM64; SDIV64; UDIV64;
    ADD; SUB; MUL; SREM; UREM; SDIV; UDIV; // Variable size

    FADD; FSUB; FMUL; FREM; FDIV
    DADD; DSUB; DMUL; DREM; DDIV

    ASHR; ASHR64
    LSHR; LSHR64
    SHL; SHL64

    AND; OR; XOR
    AND64; OR64; XOR64

    ICMP; ICMP8; ICMP16; ICMP32; ICMP64
    FCMP; DCMP
    FNEG; DNEG

    TRUNC8; TRUNC16; TRUNC32; TRUNC
    ZEXT8: ZEXT16; ZEXT32; ZEXT
    SEXT8; SEXT16; SEXT32; SEXT

    PUSH8; PUSH16; PUSH32; PUSH64;
    POP64; POP
    DUP64; PICK64

    GOTO; BR; CALL; RET
    SWITCH;

    LOAD; LOAD64; 
    STORE; STORE8; STORE16; STORE32; STORE64

    ADDROF;

    FPTRUNC; FPEXT; 
    DPTOUI; FPTOUI; FPTOSI; FPTOUI
    UITODP; UITOFP;
}

type Instruction = struct {
    op: Opcode
    arg1: uint64
    arg2: uint64
}

type Block = struct {
    cblock: &compiler::Block
    insn: &Vector(Instruction)
    pred: &Vector(weak &Block)
    succ: &Vector(weak &Block)
}

type Cfg = struct {
    blocks: &SMap(&Block)
    start: weak &Block
    ends: &Vector(weak &Block)
}

def create_cfg(block: &compiler::Block) -> Cfg {
    assert block != null
    var blocks = map::make(type &Block)

    var first_block: &Block
    while block {
        var new_block = [ 
            cblock = current, 
            pred: vector::make(type weak &Block),
            succ: vector::make(type weak &Block)
        ] !&Block
        blocks(block.label_) = new_block
        block = block.next

        if not first_block {
            first_block = new_block
        }
    }

    var queue = vector::make(type &compiler::Block)
    queue.push(first_block)
    while queue.length > 0 {
        var current = queue.pop()
        var cblock = current.cblock
        let last_insn = cblock.insns(cblock.insns.length - 1)
        if last_insn.kind == compiler::InsnKind::BR
    }
}

export def to_bytecode(block: &compiler::Block) -> &Vector(uint8) {
    var code = vector::make(uint8)
}
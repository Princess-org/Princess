export type Opcode = enum: uint8 {
    // Instructions with zero arguments
    NOP = 0

    ADD64; SUB64; MUL64; SREM64; UREM64; SDIV64; UDIV64
    FADD; FSUB; FMUL; FREM; FDIV
    DADD; DSUB; DMUL; DREM; DDIV

    ASHR64; LSHR64; SHL64

    AND64; OR64; XOR64

    FCMP_UEQ; FCMP_UGT; FCMP_UGE; FCMP_ULT; FCMP_ULE; FCMP_UNE
    DCMP_UEQ; DCMP_UGT; DCMP_UGE; DCMP_ULT; DCMP_ULE; DCMP_UNE
    
    FNEG; DNEG
    POP64; DUP64

    CALL; RET; RETVOID

    LOAD64; STORE64

    FPTRUNC; FPEXT
    DPTOUI; FPTOUI; FPTOSI
    UITODP; UITOFP

    TRUNC8; TRUNC16; TRUNC32
    ZEXT8; ZEXT16; ZEXT32
    SEXT8; SEXT16; SEXT32 

    // Instructions with one int argument
    ADD; SUB; MUL; SREM; UREM; SDIV; UDIV
    AND; OR; XOR
    ASHR; LSHR; SHL
    ZEXT; SEXT; TRUNC
    LOAD; STORE
    STOREIZ; PUSHZ

    POP; DUP; ROLL; PICK

    ADDROFGLOBAL; ADDROFSTACK

    ICMP_EQ; ICMP_NE; ICMP_UGT; ICMP_UGE; ICMP_ULT
    ICMP_ULE; ICMP_SGT; ICMP_SGE; ICMP_SLT; ICMP_SLE

    // Instructions with variable data argument
    PUSH; PUSH8; PUSH16; PUSH32; PUSH64
    STOREI; STOREI8; STOREI16; STOREI32; STOREI64

    // Instructions with special arguments
    GOTO; BR; CALLG; SWAP
    ADDROFLOCAL
}

type Instruction = struct {
    op: Opcode
    arg1: uint64
    arg2: uint64
    value: &[uint8] // Embedded value like for store
}

type Variable = struct {
    name: Str
    tpe: typechecking::TypeId
    size: uint64 // Size in bytes, multiple of 8
    stack_index: uint64
}

type StackValue = struct {
    variable: uint64
    // When the variable is bigger than 64 bits, this is
    // the index of the part of the variable
    sub_index: uint64
}
def hash(value: StackValue) -> uint64 {
    return combine_hashes(value.variable !uint64, value.sub_index !uint64)
}
def == (a: StackValue, b: StackValue) -> bool {
    return a.variable == b.variable and a.sub_index == b.sub_index
}
def != (a: StackValue, b: StackValue) -> bool {
    return not (a == b)
}

type Block = struct {
    label_: int
    cblock: &compiler::Block
    pred_stack: &Vector(StackValue)
    succ_stack: &Vector(StackValue)
    stack: &Vector(StackValue)
    insn: &Vector(Instruction)
    pred: &Vector(weak &Block)
    succ: &Vector(weak &Block)
    offset: uint64
}
export def hash(block: &Block) -> uint64 {
    return block !* !uint64
}
def push_insn(block: &Block, insn: Instruction) {
    //print("\t", insn.op, " ", insn.arg1, " ", insn.arg2, "\n")
    block.insn.push(insn)
}

type Cfg = struct {
    globals: &SMap(uint64)
    last_global: uint64
    variables: &SMap(Variable)
    local_offset: uint64
    blocks: &SMap(&Block)
    blocks_by_index: &Vector(&Block)
    start: weak &Block
    ends: &Vector(weak &Block)
    max_stack_size: uint64
}

export type Program = struct {
    start_offset: uint64
    globals: &Map(uint64, Str)
    max_stack_size: uint64
    locals_size: uint64
    code: &Vector(uint8)
    locals: &Vector(Variable)
}

def add_global(cfg: *Cfg, name: Str) -> uint64 {
    if cfg.globals.contains(name) {
        return cfg.globals(name)
    }
    let id = cfg.last_global
    cfg.globals(name) = id
    cfg.last_global += 1
    return id
}

export def round_up(num: uint64, multiple: uint64) -> uint64 {
    assert multiple != 0
    return ((num + multiple - 1) / multiple) * multiple
}


def create_cfg(block: &compiler::Block) -> Cfg {
    assert block != null
    let globals = map::make(uint64)
    let variables = map::make(Variable)
    let blocks = map::make(type &Block)
    let blocks_by_index = vector::make(type &Block)
    let ends = vector::make(type weak &Block)
    var local_offset = 0

    var first_block: &Block
    while block {
        var new_block = [
            label_ = blocks_by_index.length !int32,
            cblock = block, 
            pred = vector::make(type weak &Block),
            succ = vector::make(type weak &Block),
            insn = vector::make(type Instruction),
            stack = vector::make(type StackValue)
        ] !&Block
        blocks(block.label_) = new_block
        blocks_by_index.push(new_block)
        block = block.next

        // Pick up alloca instructions and turn them into stack variables
        for var insn in new_block.cblock.insn {
            if insn.kind == compiler::InsnKind::ALLOCA {
                let var_name = insn.value.alloca.ret.name
                let var_type = insn.value.alloca.ret.tpe
                let size = round_up(var_type.resolve().size, 8)
                variables(var_name) = [
                    name = var_name,
                    tpe = var_type,
                    size = size,
                    stack_index = local_offset
                ] !Variable
                local_offset += size
            }
        }

        if not first_block {
            first_block = new_block
        }
    }

    var visisted = set::make(type &Block)
    var queue = vector::make(type &Block)
    
    def add_next(block: &Block) {
        if not visisted.contains(block) {
            visisted.add(block)
            queue.push(block)
        }
    }

    add_next(first_block)
    while queue.length > 0 {
        var current = queue.pop()
        //print("Processing block: " + current.cblock.label_, "\n")
        let cblock = current.cblock
        let last_insn = cblock.insn(cblock.insn.length - 1)
        if last_insn.kind == compiler::InsnKind::BR_UNC {
            let next = blocks(last_insn.value.br_unc.label_.name)
            next.pred.push(current)
            current.succ.push(next)
            add_next(next)
        } else if last_insn.kind == compiler::InsnKind::BR {
            let next1 = blocks(last_insn.value.br.if_true.name)
            let next2 = blocks(last_insn.value.br.if_false.name)
            next1.pred.push(current)
            next2.pred.push(current)
            current.succ.push(next1)
            current.succ.push(next2)
            add_next(next1)
            add_next(next2)
        } else if last_insn.kind == compiler::InsnKind::SWITCH {
            assert false, "Switch statements are not implemented yet"
            /*for var case_ in last_insn.value.switch_.switch_values {
                let next = blocks(case_.label_.name)
                next.pred.push(current)
                current.succ.push(next)
                add_next(next)
            }
            let default = blocks(last_insn.value.switch_.otherwise.name)
            default.pred.push(current)
            current.succ.push(default)
            add_next(default)*/
        } else if last_insn.kind == compiler::InsnKind::RET {
            ends.push(current)
        } else {
            assert
        }
        //print("\tPred: " + current.pred.length + ", Succ: " + current.succ.length + "\n")
    }
    return [
        globals = globals,
        variables = variables,
        local_offset = local_offset,
        blocks = blocks,
        blocks_by_index = blocks_by_index,
        start = first_block,
        ends = ends
    ] !Cfg
}

def get_label(cfg: *Cfg, lbl: Str) -> int {
    for var e in cfg.blocks {
        let block = e.value
        if block.cblock.label_ == lbl {
            return block.label_
        }
    }
    assert
}

def expect_stack_value(stack: &Vector(StackValue), index: uint64, tpe: typechecking::TypeId) {
    let size = round_up(tpe.resolve().size, 8)
    let num_parts = size / 8
    for var i in 0..num_parts {
        stack.push([ variable = index, sub_index = i ] !StackValue)
    }
}

/*def expect_stack_value(stack: &Vector(StackValue), index: uint64, tpe: typechecking::TypeId) {
    let size = round_up(tpe.resolve().size, 8)
    let num_parts = size / 8
    for var i in 0..num_parts {
        stack.insert(0, [ variable = index, sub_index = num_parts - 1 - i ] !StackValue)
    }
}*/


def int_to_mem(value: uint64, size: uint64) -> &[uint8] {
    let mem = allocate_ref(uint8, size)
    for var i in 0..size {
        mem(i) = ((value >> (i * 8)) & 0xFF) !uint8
    }
    return mem
}

def expect_value(cfg: *Cfg, block: &Block, loc: compiler::Value) {
    if loc.kind == compiler::ValueKind::LOCAL {
        if loc.i > 0 {
            // Actual local variable
            expect_stack_value(block.stack, loc.i - 1, loc.tpe)
        } else {
            block.push_insn([ 
                op = Opcode::ADDROFLOCAL, 
                arg1 = cfg.variables(loc.name).stack_index
            ] !Instruction)
        }
    } else if loc.kind == compiler::ValueKind::GLOBAL {
        block.push_insn([ 
            op = Opcode::ADDROFGLOBAL, 
            arg1 = add_global(cfg, loc.name)
        ] !Instruction)
    } else {
        let tpe = loc.tpe.resolve()
        let vsize = tpe.size
        let mem = allocate_ref(uint8, vsize)
        serialize(mem.value, tpe, loc)
        if vsize == 8 {
            block.push_insn([ op = Opcode::PUSH64, value = mem ] !Instruction)
        } else if vsize == 4 {
            block.push_insn([ op = Opcode::PUSH32, value = mem ] !Instruction)
        } else if vsize == 2 {
            block.push_insn([ op = Opcode::PUSH16, value = mem ] !Instruction)
        } else if vsize == 1 {
            block.push_insn([ op = Opcode::PUSH8, value = mem ] !Instruction)
        } else {
            var is_zero = true
            for var i in 0..vsize {
                if mem(i) != 0 { is_zero = false; break }
            }
            if is_zero {
                block.push_insn([ op = Opcode::PUSHZ, arg1 = vsize ] !Instruction)
            } else {
                block.push_insn([ op = Opcode::PUSH, arg1 = vsize, value = mem ] !Instruction)
            }
        } 
    }
}

def print_stack(stack: &Vector(StackValue)) {
    if not stack { return }
    for var v in stack {
        print(v.variable, ":", v.sub_index, " ")
    }
}

// TODO This function might return an absurd amount of instructions in
// case you have big arrays (or structs) on the stack, these should be optimized to
// using memmove instead of moving each element one by one.
def equalize_stacks(
    block: &Block,
    source: &Vector(StackValue),
    target: &Vector(StackValue)
) {
    let stack = source.copy()
    let program = vector::make(Instruction)

    print("Equalizing stacks: ")
    print_stack(source)
    print("-> ")
    print_stack(target)
    print("\n")

    var target_index: int64 = 0

    while target_index < target.length {
        let wanted = target(target_index)
        var pos: int64 = -1

        for var i in target_index..stack.length {
            if stack(i) == wanted {
                pos = i
                break
            }
        }

        if pos == -1 {
            for var i in 0..target_index {
                if stack(i) == wanted {
                    pos = i
                    break
                }
            }

            assert pos != -1

            let n = stack.length - 1 - pos
            program.push([
                op = Opcode::PICK,
                arg1 = n
            ] !Instruction)
            stack.push(stack(pos))
            pos = stack.length - 1
        }

        if pos > target_index {
            program.push([
                op = Opcode::SWAP,
                arg1 = stack.length - 1 - target_index,
                arg2 = stack.length - 1 - pos
            ] !Instruction)

            let temp = stack(pos)
            stack(pos) = stack(target_index)
            stack(target_index) = temp
        }

        target_index += 1
    }

    while stack.length > target.length {
        let pos = target.length
        let n = stack.length - 1 - pos

        if n != 0 {
            program.push([
                op = Opcode::ROLL,
                arg1 = n
            ] !Instruction)

            let value = stack(pos)
            stack.remove(pos)
            stack.push(value)
        }

        program.push([
            op = Opcode::POP64
        ] !Instruction)

        stack.pop()
    }

    assert stack.length == target.length

    for var i in 0..target.length {
        assert stack(i) == target(i)
    }

    //for var v in program {
    //    print("\t", v.op, " ", v.arg1, " ", v.arg2, "\n")
    //}

    for var i in 0..program.length {
        let value = program(program.length - 1 - i)
        block.push_insn(value)
    }
}

def push_stack_value(block: &Block, loc: compiler::Value) {
    assert loc.kind == compiler::ValueKind::LOCAL
    var expected_stack = block.stack.copy()
    var used = false
    var new_stack = vector::make(StackValue)
    for var i in 0..block.stack.length {
        let v = block.stack(i)
        if v.variable != loc.i - 1 {
            new_stack.push(v)
        } else { used = true }
    }
    block.stack = new_stack.copy()
    if used {
        expect_stack_value(block.stack, loc.i - 1, loc.tpe)
    } else {
        // if the value is unused, we need to pop it
        // TODO Actually remove useless instructions
        let sz = round_up(loc.tpe.resolve().size, 8)
        if sz <= 8 {
            block.push_insn([ op = Opcode::POP64 ] !Instruction)   
        } else {
            block.push_insn([ op = Opcode::POP, arg1 = sz / 8 ] !Instruction)
        }
    }
    equalize_stacks(block, block.stack, expected_stack)
    block.stack = new_stack
}

def get_address(tpe: typechecking::TypeId, idx: &[compiler::Value], 
    instructions: &Vector(Instruction), stack: &Vector(StackValue)) -> uint64 {

    var addr: uint64 = 0
    for var i in 1..idx.size {
        let kind = tpe.resolve().kind
        let index = idx(i)
        if kind == typechecking::TypeKind::STRUCT or kind == typechecking::TypeKind::CLOSURE {
            assert index.kind == compiler::ValueKind::INT
            let stpe = tpe.resolve()
            let len = vector::length(stpe.field_types)
            assert index.i < len
            let type_member = stpe.field_types(index.i)
            addr = addr + type_member.offset
            tpe = type_member.tpe
        } else if kind == typechecking::TypeKind::UNION {
            assert index.kind == compiler::ValueKind::INT
            assert index.i == 0
            tpe = typechecking::static_array(builtins::int8_, tpe.resolve().size)
        } else if kind == typechecking::TypeKind::ARRAY {
            assert index.kind == compiler::ValueKind::INT
            if index.i == 0 {
                tpe = builtins::size_t_
            } else if index.i == 1 {
                let addr = addr + (size_of size_t)
                tpe = tpe.tpe
            } else {
                assert
            }
        } else if kind == typechecking::TypeKind::REFERENCE or kind == typechecking::TypeKind::WEAK_REF {
            assert index.kind == compiler::ValueKind::INT
            if index.i == 0 {
                tpe = typechecking::pointer(compiler::ref_meta())
            } else if index.i == 1 {
                addr += (size_of type *)
                tpe = tpe.tpe
            } else if index.i == 2 {
                addr += (size_of type *) * 2
                tpe = typechecking::pointer(builtins::type_t())
            } else {
                assert
            }
        } else if kind == typechecking::TypeKind::STATIC_ARRAY {
            if index.kind == compiler::ValueKind::INT {
                let array_tpe = tpe.resolve()
                assert index.i < array_tpe.length
                addr += array_tpe.tpe.resolve().size * index.i
                tpe = tpe.tpe
            } else {
                expect_stack_value(stack, index.i, index.tpe)
                instructions.push([op = Opcode::PUSH64, value = int_to_mem(tpe.tpe.resolve().size, 8)] !Instruction)
                instructions.push([op = Opcode::MUL64] !Instruction)
                instructions.push([op = Opcode::ADD64] !Instruction)
                if addr > 0 {
                    instructions.push([op = Opcode::PUSH64, value = int_to_mem(addr, 8)] !Instruction)
                    instructions.push([op = Opcode::ADD64] !Instruction)
                }
                tpe = tpe.tpe
                addr = 0
            }
        } else if kind == typechecking::TypeKind::POINTER or kind == typechecking::TypeKind::BYREF {
            if index.kind == compiler::ValueKind::INT {
                addr += (index.i * tpe.tpe.resolve().size)
                tpe = tpe.tpe
            } else {
                expect_stack_value(stack, index.i, index.tpe)
                instructions.push([op = Opcode::PUSH64, value = int_to_mem(tpe.tpe.resolve().size, 8)] !Instruction)
                instructions.push([op = Opcode::MUL64] !Instruction)
                instructions.push([op = Opcode::ADD64] !Instruction)
                if addr > 0 {
                    instructions.push([op = Opcode::PUSH64, value = int_to_mem(addr, 8)] !Instruction)
                    instructions.push([op = Opcode::ADD64] !Instruction)
                }
                tpe = tpe.tpe
                addr = 0
            }
        } else {
            error(kind, "\n")
            assert
        }
    }
    return addr
}

def getelementptr(cfg: *Cfg, block: &Block, insn: &compiler::Insn) -> uint64 {
    assert insn.kind == compiler::InsnKind::GETELEMENTPTR
    var instructions = vector::make(Instruction)
    var index = insn.value.gep.index
    var stack = vector::make(StackValue)
    
    push_stack_value(block, insn.value.gep.ret)

    let addr = get_address(insn.value.gep.tpe, insn.value.gep.index, instructions, stack)

    if addr > 0 {
        instructions.push([op = Opcode::PUSH64, value = int_to_mem(addr, 8)] !Instruction)
        instructions.push([op = Opcode::ADD64] !Instruction)
    }

    // We need to do everything backwards
    for var i in 0..instructions.length {
        block.push_insn(instructions(instructions.length - 1 - i))
    }
    for var i in 0..stack.length {
        block.stack.push(stack(stack.length - 1 - i))
    }

    expect_value(cfg, block, insn.value.gep.value)
}

def insert_value(cfg: *Cfg, block: &Block, insn: &compiler::Insn) {
    let tpe = insn.value.insert_value.value.tpe.resolve()
    let size = round_up(tpe.size, 8)
    var offset = size - tpe.size

    push_stack_value(block, insn.value.insert_value.ret)

    let e_size = round_up(insn.value.insert_value.element.tpe.resolve().size, 8)
    if e_size == 8 {
        block.push_insn([ op = Opcode::STORE64 ] !Instruction)
    } else {
        block.push_insn([ op = Opcode::STORE, arg1 = size ] !Instruction)
    }

    let index = allocate_ref(compiler::Value, insn.value.insert_value.index.size + 1)
    index(0) = ([ kind = compiler::ValueKind::INT, i = 0 ] !compiler::Value)
    for var i in 0..insn.value.insert_value.index.size {
        let ind = insn.value.insert_value.index(i)
        index(i + 1) = ([ kind = compiler::ValueKind::INT, i = ind ] !compiler::Value)
    }
    offset += get_address(insn.value.insert_value.value.tpe, index, null, null)
    //print("insert_value: ", debug::type_to_str(insn.value.insert_value.value.tpe), 
    //    " index: ", insn.value.insert_value.index, 
    //    " offset: ", offset, "\n")

    if offset > 0 {
        block.push_insn([ op = Opcode::ADD64 ] !Instruction)
        block.push_insn([ op = Opcode::PUSH64, value = int_to_mem(offset, 8) ] !Instruction)
    }
    block.push_insn([ op = Opcode::ADDROFSTACK, arg1 = (size / 8) ] !Instruction)

    // roll element to the top of the stack if it is a stack value
    if insn.value.insert_value.element.kind == compiler::ValueKind::LOCAL {
        for var i in 0..(e_size / 8) {
            block.push_insn([ op = Opcode::ROLL, arg1 = (size / 8) + (e_size / 8) - 1 ] !Instruction)
        }
    }

    expect_value(cfg, block, insn.value.insert_value.element)
    expect_value(cfg, block, insn.value.insert_value.value)

    // We temporarily might go over the stack limit here
    if block.stack.length + 2 > cfg.max_stack_size {
        cfg.max_stack_size = block.stack.length + 2
    }
}

def extract_value(cfg: *Cfg, block: &Block, insn: &compiler::Insn) {
    let tpe = insn.value.extract_value.value.tpe.resolve()
    let size = round_up(tpe.size, 8)
    var offset = size - tpe.size

    let r_size = round_up(insn.value.extract_value.ret.tpe.resolve().size, 8)

    block.push_insn([ op = Opcode::POP, arg1 = size / 8 ] !Instruction)
    // Pop value off the stack (v = value, r = result)
    // v v v r r ->
    // r r v v v ->
    // r r
    for var i in 0..(r_size / 8) {
        block.push_insn([ op = Opcode::ROLL, arg1 = r_size / 8 ] !Instruction)
    }

    push_stack_value(block, insn.value.extract_value.ret)
    load_value(cfg, block, insn.value.extract_value.ret.tpe)

    let index = allocate_ref(compiler::Value, insn.value.extract_value.index.size + 1)
    index(0) = ([ kind = compiler::ValueKind::INT, i = 0 ] !compiler::Value)
    for var i in 0..insn.value.extract_value.index.size {
        let ind = insn.value.extract_value.index(i)
        index(i + 1) = ([ kind = compiler::ValueKind::INT, i = ind ] !compiler::Value)
    }
    offset += get_address(insn.value.extract_value.value.tpe, index, null, null)

    if offset > 0 {
        block.push_insn([ op = Opcode::ADD64 ] !Instruction)
        block.push_insn([ op = Opcode::PUSH64, value = int_to_mem(offset, 8) ] !Instruction)
    }
    block.push_insn([ op = Opcode::ADDROFSTACK, arg1 = (size / 8) - 1 ] !Instruction)
    expect_value(cfg, block, insn.value.extract_value.value)

    // We temporarily might go over the stack limit here
    // this includes the address and the offset value, which is why we add 2
    if block.stack.length + 2 > cfg.max_stack_size {
        cfg.max_stack_size = block.stack.length + 2
    }
}

def load_value(cfg: *Cfg, block: &Block, tpe: typechecking::TypeId) {
    let size = round_up(tpe.resolve().size, 8)
    if size == 8 {
        block.push_insn([ op = Opcode::LOAD64 ] !Instruction)
    } else {
        block.push_insn([ op = Opcode::LOAD, arg1 = size ] !Instruction)
    }
}

def store_value(cfg: *Cfg, block: &Block, value: compiler::Value) {
    let tpe = value.tpe.resolve()
    let size = round_up(tpe.size, 8)

    if value.kind == compiler::ValueKind::LOCAL or 
        value.kind == compiler::ValueKind::GLOBAL {
        
        if size == 8 {
            block.push_insn([ op = Opcode::STORE64 ] !Instruction)
        } else {
            block.push_insn([ op = Opcode::STORE, arg1 = size ] !Instruction)
        }
        expect_value(cfg, block, value)
    } else {
        let vsize = tpe.size
        let mem = allocate_ref(uint8, vsize)
        serialize(mem.value, tpe, value)
        if vsize == 8 {
            block.push_insn([ op = Opcode::STOREI64, value = mem ] !Instruction)
        } else if vsize == 4 {
            block.push_insn([ op = Opcode::STOREI32, value = mem ] !Instruction)
        } else if vsize == 2 {
            block.push_insn([ op = Opcode::STOREI16, value = mem ] !Instruction)
        } else if vsize == 1 {
            block.push_insn([ op = Opcode::STOREI8, value = mem ] !Instruction)
        } else {
            var is_zero = true
            for var i in 0..vsize {
                if mem(i) != 0 { is_zero = false; break }
            }
            if is_zero {
                block.push_insn([ op = Opcode::STOREIZ, arg1 = vsize ] !Instruction)
            } else {
                block.push_insn([ op = Opcode::STOREI, arg1 = vsize, value = mem ] !Instruction)
            }
        } 
    }
}

def to_bytecode(cfg: *Cfg, block: &Block, queue: &Set(&Block), visited: &Set(&Block)) {
    queue.remove(block)
    if visited.contains(block) { return }
    visited.add(block)
    //print("Generating bytecode for block: " + block.cblock.label_ + "\n")

    // Process the current block
    let len = block.cblock.insn.length
    for var i in 0..len {
        print("Stack after: ")
        print_stack(block.stack)
        print("\n")

        let insn = block.cblock.insn(len - 1 - i)
        switch insn.kind {
        case compiler::InsnKind::STORE
            let value = insn.value.store.value
            let loc = insn.value.store.loc
            store_value(cfg, block, value)
            expect_value(cfg, block, loc)
        case compiler::InsnKind::LOAD
            let value = insn.value.load.value
            let loc = insn.value.load.loc
            push_stack_value(block, value)
            load_value(cfg, block, value.tpe)
            expect_value(cfg, block, loc)
        case compiler::InsnKind::GETELEMENTPTR
            getelementptr(cfg, block, insn)
        case compiler::InsnKind::INSERTVALUE
            insert_value(cfg, block, insn)
        case compiler::InsnKind::EXTRACTVALUE
            extract_value(cfg, block, insn)
        case compiler::InsnKind::ICMP
            push_stack_value(block, insn.value.icmp.ret)
            var op: Opcode
            switch insn.value.icmp.op {
                case compiler::CompareInt::eq;  op = Opcode::ICMP_EQ
                case compiler::CompareInt::ne;  op = Opcode::ICMP_NE
                case compiler::CompareInt::ugt; op = Opcode::ICMP_UGT
                case compiler::CompareInt::uge; op = Opcode::ICMP_UGE
                case compiler::CompareInt::ult; op = Opcode::ICMP_ULT
                case compiler::CompareInt::ule; op = Opcode::ICMP_ULE
                case compiler::CompareInt::sgt; op = Opcode::ICMP_SGT
                case compiler::CompareInt::sge; op = Opcode::ICMP_SGE
                case compiler::CompareInt::slt; op = Opcode::ICMP_SLT
                case compiler::CompareInt::sle; op = Opcode::ICMP_SLE
            }
            let sz = insn.value.icmp.left.tpe.resolve().size
            block.push_insn([ op = op, arg1 = sz ] !Instruction)
            expect_value(cfg, block, insn.value.icmp.right)
            expect_value(cfg, block, insn.value.icmp.left)

        case compiler::InsnKind::BR
            expect_value(cfg, block, insn.value.br.cond)
            block.push_insn([ 
                op = Opcode::BR, 
                arg1 = get_label(cfg, insn.value.br.if_true.name),
                arg2 = get_label(cfg, insn.value.br.if_false.name)
            ] !Instruction)
        case compiler::InsnKind::BR_UNC
            block.push_insn([ 
                op = Opcode::GOTO, 
                arg1 = get_label(cfg, insn.value.br_unc.label_.name)
            ] !Instruction)
        case compiler::InsnKind::CALL
            if insn.value.call.ret.tpe != 0 {
                push_stack_value(block, insn.value.call.ret)
            }
            if insn.value.call.name.kind == compiler::ValueKind::LOCAL {
                expect_value(cfg, block, insn.value.call.name)
                block.push_insn([ op = Opcode::CALL ] !Instruction)
            } else if insn.value.call.name.kind == compiler::ValueKind::GLOBAL {
                block.push_insn([ 
                    op = Opcode::CALLG, 
                    arg1 = add_global(cfg, insn.value.call.name.name),
                    arg2 = insn.value.call.args.size
                ] !Instruction)
            }
            
            let size = insn.value.call.args.size 
            for var i in 0..size {
                let arg = insn.value.call.args(size - 1 - i)
                expect_value(cfg, block, arg)
            }
        case compiler::InsnKind::ADD, compiler::InsnKind::SUB, compiler::InsnKind::MUL, 
            compiler::InsnKind::SDIV, compiler::InsnKind::UDIV, compiler::InsnKind::SREM, 
            compiler::InsnKind::UREM
            
            push_stack_value(block, insn.value.arith.ret)

            let sz = insn.value.arith.ret.tpe.resolve().size
            var op: Opcode
            switch insn.kind {
                case compiler::InsnKind::ADD;  op = (Opcode::ADD  if sz > 8  else Opcode::ADD64)
                case compiler::InsnKind::SUB;  op = (Opcode::SUB  if sz > 8  else Opcode::SUB64)
                case compiler::InsnKind::MUL;  op = (Opcode::MUL  if sz > 8  else Opcode::MUL64)
                case compiler::InsnKind::SDIV; op = (Opcode::SDIV if sz != 8 else Opcode::SDIV64)
                case compiler::InsnKind::UDIV; op = (Opcode::UDIV if sz != 8 else Opcode::UDIV64)
                case compiler::InsnKind::SREM; op = (Opcode::SREM if sz != 8 else Opcode::SREM64)
                case compiler::InsnKind::UREM; op = (Opcode::UREM if sz != 8 else Opcode::UREM64)
            }
            block.push_insn([ op = op, arg1 = sz ] !Instruction)

            expect_value(cfg, block, insn.value.arith.right)
            expect_value(cfg, block, insn.value.arith.left)

        case compiler::InsnKind::PTRTOINT
            push_stack_value(block, insn.value.convert.ret)
            expect_value(cfg, block, insn.value.convert.value)

        case compiler::InsnKind::RET
            if insn.value.ret.value.tpe != 0 {
                expect_value(cfg, block, insn.value.ret.value)
                block.push_insn([ op = Opcode::RET ] !Instruction)
            } else {
                block.push_insn([ op = Opcode::RETVOID ] !Instruction)
            }
        case compiler::InsnKind::ALLOCA
            // Alloca instructions are handled in the CFG creation phase
            continue
        case
            error(insn.kind, "\n") 
            assert
        }

        if block.stack.length > cfg.max_stack_size {
            cfg.max_stack_size = block.stack.length
        }

        //print("Stack before: ")
        //print_stack(block.stack)
        //print("\n")
    }

    for var pred in block.pred {
        queue.add(pred)
    }

    //for var insn in block.insn {
    //    print("\t", insn.op, " ", insn.arg1, " ", insn.arg2, "\n")
    //}
}

def add_temporary_branch(cfg: *Cfg, block: &Block, stack: &Vector(StackValue), true_suc: int32) -> &Block {
    let succt = cfg.blocks_by_index(true_suc)
    let branch1 = [
        label_ = cfg.blocks_by_index.length !int32,
        pred = vector::make(type weak &Block),
        succ = vector::make(type weak &Block),
        insn = vector::make(type Instruction)
    ] !&Block
    branch1.pred.push(block)
    branch1.succ.push(succt)
    cfg.blocks_by_index.push(branch1)

    branch1.insn.push([
        op = Opcode::GOTO,
        arg1 = true_suc
    ] !Instruction)

    equalize_stacks(branch1, stack, succt.stack)
    return branch1
}

export def to_bytecode(block: &compiler::Block) -> &Program {
    let cfg = create_cfg(block)

    var queue = set::make(type &Block)
    var visited = set::make(type &Block)

    for var end in cfg.ends {
        to_bytecode(*cfg, end, queue, visited)
    }

    while queue.size > 0 {
        for var block in @queue.keys() {
            var all_succ_visited = true
            for var succ in block.succ {
                if not visited.contains(succ) {
                    all_succ_visited = false
                    break
                }
            }
            if all_succ_visited {
                var stack = vector::make(StackValue)
                var existing = set::make(StackValue)
                for var succ in block.succ {
                    for var i in 0..succ.stack.length {
                        let v = succ.stack(i)
                        if not existing.contains(v) {
                            existing.add(v)
                            stack.push(v)
                        }
                    }
                }

                block.stack = stack.copy()
                block.succ_stack = stack.copy()
                if block.stack.length > cfg.max_stack_size {
                    cfg.max_stack_size = block.stack.length
                }

                to_bytecode(*cfg, block, queue, visited)
                block.pred_stack = block.stack.copy()

                if block.succ.length == 2 {

                    let true_suc = block.insn(0).arg1 !int
                    let false_suc = block.insn(0).arg2 !int

                    // If there are two successors we must branch
                    // and set up the stack for both branches

                    let succt = add_temporary_branch(*cfg, block, stack, true_suc)
                    let succf = add_temporary_branch(*cfg, block, stack, false_suc)
                    block.succ(0) = succt
                    block.succ(1) = succf

                    block.insn.get(0).arg1 = succt.label_
                    block.insn.get(0).arg2 = succf.label_
                } else if block.succ.length == 1 {
                    let succt = block.succ(0)
                    let succ = add_temporary_branch(*cfg, block, stack, succt.label_)

                    block.insn.get(0).arg1 = succ.label_
                    block.succ(0) = succ
                }
            }
        }
    }

    print("===========OUTPUT==========\n")
    visited.clear()
    queue.clear()
    queue.add(cfg.start)

    while queue.size > 0 {
        for var block in @queue.keys() {
            queue.remove(block)
            visited.add(block)
            
            print("Block: ", block.label_, "\n")
            print("Stack: ")
            print_stack(block.pred_stack)
            print(" -> ")
            print_stack(block.succ_stack)
            print("\n")
            print("Pred: ")
            for var pred in block.pred {
                print(pred.label_, " ")
            }
            print("Succ: ")
            for var succ in block.succ {
                print(succ.label_, " ")
            }
            print("\n")
            for var i in 0..block.insn.length {
                let insn = block.insn(block.insn.length - 1 - i)
                print("\t", insn.op, " ", insn.arg1, " ", insn.arg2)
                if insn.value != null {
                    print(" ", insn.value)
                }
                print("\n")
            }
            for var succ in block.succ {
                if not visited.contains(succ) {
                    queue.add(succ)
                }
            }
        }
    }

    let code = vector::make(uint8)
    // This contains the label positions in the code vector
    // which have to be patched after the code generation is complete
    let label_map = map::make(uint64, uint32)

    let globals_inverse = map::make(uint64, Str)
    for var e in cfg.globals {
        globals_inverse(e.value) = e.key
    }

    let program = [
        globals = globals_inverse,
        max_stack_size = cfg.max_stack_size,
        code = code,
        locals_size = cfg.local_offset
    ] !Program

    for var block in cfg.blocks_by_index {
        if block.label_ == 0 {
            program.start_offset = code.length
        }

        block.offset = code.length
        for var i in 0..block.insn.length {
            let insn = block.insn(block.insn.length - 1 - i)

            code.push(insn.op !uint8)
            switch insn.op {
            case Opcode::NOP..=Opcode::SEXT32
                // Do nothing
            case Opcode::ADD..=Opcode::ICMP_SLE // These opcodes have a size argumnent
                assert insn.arg1 <= 0xFFFF
                code.resize(code.length + 2)
                @(code.get(code.length - 2) !*uint16) = insn.arg1 !uint16
            case Opcode::GOTO
                assert insn.arg1 <= 0xFFFFFFFF
                code.resize(code.length + 4) // reserve 2 bytes for label
                label_map(code.length - 4) = insn.arg1 !uint32
            case Opcode::BR
                assert insn.arg1 <= 0xFFFFFFFF
                assert insn.arg2 <= 0xFFFFFFFF
                code.resize(code.length + 8) // reserve 8 bytes for labels
                label_map(code.length - 8) = insn.arg1 !uint32
                label_map(code.length - 4) = insn.arg2 !uint32
            case Opcode::CALLG
                assert insn.arg1 <= 0xFFFF
                assert insn.arg2 <= 0xFFFF
                code.resize(code.length + 4)
                @(code.get(code.length - 4) !*uint16) = insn.arg1 !uint16
                @(code.get(code.length - 2) !*uint16) = insn.arg2 !uint16
            case Opcode::PUSH8, Opcode::STOREI8
                code.push(insn.value(0) !uint8)
            case Opcode::PUSH16, Opcode::STOREI16
                code.resize(code.length + 2)
                @(code.get(code.length - 2) !*int16) = @(*insn.value(0) !*int16)
            case Opcode::PUSH32, Opcode::STOREI32
                code.resize(code.length + 4)
                @(code.get(code.length - 4) !*int32) = @(*insn.value(0) !*int32)
            case Opcode::PUSH64, Opcode::STOREI64
                code.resize(code.length + 8)
                @(code.get(code.length - 8) !*int64) = @(*insn.value(0) !*int64)
            case Opcode::PUSH, Opcode::STOREI
                assert insn.arg1 <= 0xFFFF
                code.resize(code.length + 2 + insn.arg1)
                @(code.get(code.length - 2) !*int16) = insn.arg1 !int16
                memcopy(insn.value.value, code.get(code.length - insn.arg1), insn.arg1)
            case Opcode::SWAP
                assert insn.arg1 <= 0xFFFF
                assert insn.arg2 <= 0xFFFF
                code.resize(code.length + 4)
                @(code.get(code.length - 4) !*uint16) = insn.arg1 !uint16
                @(code.get(code.length - 2) !*uint16) = insn.arg2 !uint16
            case Opcode::ADDROFLOCAL
                assert insn.arg1 <= 0xFFFFFFFF
                code.resize(code.length + 4)
                @(code.get(code.length - 4) !*uint32) = insn.arg1 !uint32
            case 
                error(insn.op, "\n")
                assert
            }
        }
    }
    
    for var e in label_map {
        let pos = e.key
        let label_ = e.value
        let block = cfg.blocks_by_index(label_)
        let offset = block.offset
        assert offset <= 0xFFFFFFFF
        @(code.get(pos) !*uint32) = offset !uint32
    }

    print(code.to_array(), "\n")

    return program
}

let src = """
    def main {
        var x: &int = 10
        var y: weak &int = x
        var z: &int = y
    }
"""

toolchain::no_incremental = true
toolchain::no_stdlib = true

toolchain::prepare_preload()
toolchain::runtime_.stage = Stage::PREPROCESS
consteval::consteval(toolchain::runtime_)

let lines = util::split_lines(src)
let tokens = lexer::lex(src)
let node = parser::parse(tokens, lines, "main.pr", "main")
let sc = scope::enter_function_scope(builtins::builtins, null, true)
let module = toolchain::make_module("main.pr", "main", node, sc, src, lines)
consteval::consteval(module)
typechecking::typecheck(module)
compiler::compile(module.compiler_state, is_main = false, no_cleanup = true)

let main_function = module.result.functions("main::main::()")

let program = to_bytecode(main_function.block)

evalbc::eval(program)

delete(tokens)
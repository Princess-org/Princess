import vector
import util
import toolchain
import debug
import builtins
import compiler
import errors
import consteval

// This is used to uniquely identify a value
export type Ident = struct {
    name: Str
    signature: Str
    _hash: uint64
    _contents_hash: uint64
    module: weak &toolchain::Module
}

export type ImportedModule = struct {
    module: weak &toolchain::Module
    alias: &parser::Node
}

export def make_ident(
    name: Str, module: &toolchain::Module = null, 
    hash: uint64 = 0, contents_hash: uint64 = 0, signature: String = null
) -> Ident {
    
    if not signature { signature = name }
    return [
        name = name,
        signature = signature,
        module = module,
        _hash = hash,
        _contents_hash = contents_hash
    ] !Ident
}

export def hash(ident: Ident) -> uint64 {
    return combine_hashes(hash(ident.signature), hash(ident.module.module) if ident.module else 0)
}
export def == (this: Ident, other: Ident) -> bool {
    if not other.module {
        return this.signature == other.signature
    } else {
        return this.signature == other.signature and 
            this.module == other.module
    }
}
export def != (this: Ident, other: Ident) -> bool {
    return not (this == other)
}
export def fuzzy_equals(this: Ident, other: Ident) -> bool {
    if not other.module {
        return this.name == other.name
    } else {
        return this.name == other.name and
            this.module == other.module
    }
}

export def find(ident: Ident) -> &Value {
    if not ident.module { return null }

    let scope = ident.module.scope
    let values = scope.all_values()
    for var fun in values {
        if fun.ident == ident {
            return fun
        }
    }
    return null
}

export type ValueKind = enum {
    VALUE
    NAMESPACE
    FUNCTION
    TYPE
}

export type Value = struct {
    kind: ValueKind

    // This is needed to store the location
    name_node: weak &parser::Node
    share: parser::ShareMarker
    modifier: parser::VarDecl
    // Name used by the source code
    name: Str
    // Name used by the assembly, might be suffixed with a number
    // in case of shadowed variables
    _assembly_name: Str
    offset: size_t

    tpe: &typechecking::TypeRef
    fdef: typechecking::FunctionDef
    value: &compiler::Value

    _scope: &Scope
    _module: weak &Scope // This is needed for modules referencing each other
    // In case multiple values share one name (overloaded functions)
    next: &Value
    phase: Phase
    // True if the value is a global value
    global: bool
    // No mangling if extern
    extern: bool
    impl: bool
    dllimport: bool
    dllexport: bool
    // Definition of the value
    node: weak &parser::Node
    // state: &typechecking::State
    // For imported scopes, this checks if a value is exported before accessing it
    // Also used by serialize to signal that a function is imported (ffi)
    imported: bool
    previous_underscore: &Value

    ident: Ident
    dependencies: &Set(Ident)
    // This belongs to functions that aren't found
    unresolved: &Set(Ident)
    dependants: &Set(Ident)
    is_capture: bool
    // TODO This is a strong reference to the identifier
    // It's needed because of compiler::create_type
    identifier: &parser::Node
    // So that the value doesn't come up in auto completion
    is_internal: bool
    // This is true if we have a polymorphic instance
    polymorph: bool
    // Keep a reference to the original function for dependency tracking
    polymorph_original: weak &Value

    // References to this value
    references: &Vector(parser::SourceLoc)
    // Don't serialize these
    is_generated: bool
    // This is true for compiler generated functions that are used for dynamic dispatch
    is_dyn_dispatch: bool
    module: weak &toolchain::Module
    current_function: weak &compiler::Function

    // This is for types, if you're defining something that is merely an alias we
    // don't need to register a new type for it when serialising/deserialising
    is_alias: bool
    // This is set to true if the value was loaded from a cached file
    is_cached: bool
}

export def get_type(value: &Value) -> typechecking::TypeId {
    if not value { return 0 }
    assert value.module
    return value.tpe.resolve(value.module.scope)
}

export def assembly_name(value: &Value, state: &compiler::State) -> Str {
    if not value or not value.tpe { return [] !Str }
    if value.extern or value.global or value.kind == ValueKind::FUNCTION { 
        return value._assembly_name 
    }
    return value._assembly_name + state.prefix + "." + value.offset
}

export def index_of(values: &Vector(&Value), value: &Value) -> int64 {
    for var i in 0..values.length {
        if values(i) == value {
            return i
        }
    }
    return -1
}


def ambigous_reference(node: &parser::Node) {
    errors::errorn(node, "Ambiguous reference")
}

export def loc(value: &Value) -> parser::SourceLoc {
    if not value.name_node { 
        if value.kind == ValueKind::NAMESPACE {
            let module = value._module.module
            return [
                filename = module.filename,
                display_name = module.filename,
                module = module.module
            ] !parser::SourceLoc
        }
        return parser::invalid_loc
    }

    let loc = value.name_node.loc
    if not loc.filename {
        return parser::invalid_loc
    }
    return loc
}

export def get_scope(value: &Value) -> &Scope {
    if value._scope {
        return value._scope
    } else if value._module {
        return value._module
    } else if value.kind == ValueKind::TYPE and value.tpe.tpe and
        typechecking::is_enum(value.tpe.tpe) {
        return value.tpe.tpe.resolve().scope
    }

    return null
}

export def add_reference(value: &Value, reference: &parser::Node) {
    if not value or not value.references { return }
    value.references.push(reference.loc)
}

// This also clears out references that aren't valid anymore.
// TODO The process to do this is rather expensive, maybe there's a better way to speed this up
export def find_references_to(value: &Value) -> &Vector(parser::SourceLoc) {
    let res = vector::make(parser::SourceLoc)
    if not value.references { return res }
    for var i in 0..value.references.length {
        var loc = value.references(i)
        let module = toolchain::modules.get_or_default(loc.filename, null)
        if not module { continue }
        let node = parser::find(module.node, loc.line, loc.column)
        if node and node.svalue == value {
            res.push(loc)
        }
    }
    value.references = res
    return res
}

export type Impl = struct {
    share: parser::ShareMarker
    module: weak &toolchain::Module
    left: &typechecking::TypeRef
    right: &typechecking::TypeRef
    node: weak &parser::Node
}

export type ReExport = struct {
    module: weak &toolchain::Module
    pattern: &parser::Node
}

export type Scope = struct {
    module: weak &toolchain::Module
    is_function: bool
    is_global: bool
    // Counter for local scopes (shadowing)
    scope_count: int
    parents: &Vector(weak &Scope)
    fields: &SMap(&Value)
    // It is way cheaper to clear out temporaries by just clearing 
    // the map instead of removing each temporary one by one
    temporaries: &SMap(&Value)
    implicits: &Vector(&Value)
    // This is a list of imported scopes,
    // for resolving names from other modules without
    // specifying the full path
    // Vector of toolchain::Module
    imports: &Vector(ImportedModule)
    // Current underscore
    underscore: &Value
    underscore_count: int
    re_exports: &Vector(ReExport)
    // Polymorphic instances
    polymorphics: &SMap(&Scope)
    impls: &Vector(&Impl)
}

export def print_scope(scope: &Scope) {
    print_scope(scope, "", set::make(uint64))
}

def print_scope(scope: &Scope, indent: Str, visited: &Set(uint64)) {
    if not scope { return }
    if visited.contains(scope !* !uint64) {
        return
    }
    visited.add(scope !* !uint64)

    print(indent, "Scope (module=", scope.module.module if scope.module else to_str("<null>"), "):\n")
    let keys = scope.fields.keys()
    for var i in 0..keys.size {
        let key = keys(i)
        let value = scope.fields(key)
        print(indent, "  ", key, " -> ", typechecking::generic_to_string(value.tpe), " (", to_string(value.kind), ", ", to_string(value.phase), ")\n")
    }
    if scope.parents {
        for var parent in scope.parents {
            print(indent, "Parent:\n")
            print_scope(parent, indent + "  ", visited)
        }
    }
    if scope.imports {
        print(indent, "Imports:\n")
        for var imprt in scope.imports {
            print(indent, "  ", imprt.module.module, ": \n")
            print_scope(imprt.module.scope, indent + "    ", visited)
        }
    }
}

export def parent(scope: &Scope) -> &Scope {
    if scope.parents and scope.parents.length > 0 {
        return scope.parents(0)
    }
    return null
}

export def clear_temporaries(scope: &Scope) {
    if not scope { return }
    //print("Clearing ", scope.temporaries.size, " temporaries in scope: ", scope !*, "\n")
    scope.temporaries.clear()
}

export type Phase = enum {
    // INDETERMIANTE means there's currently a value set (to prevent infinite recursion)
    // CACHED means the value has been read from a cache file
    DECLARED; DEFINED; COMPILED; CACHED; INDETERMINATE
}

export def create_dependency(this: &Value, other: &parser::Node, contents: bool = false) {
    if other.svalue {
        create_dependency(this, other.svalue, contents)
    } else {
        var ident = other
        if other.kind == parser::NodeKind::TYPE_CONSTRUCTOR {
            ident = other.value.type_constructor.name
        }
        if ident and ident.kind == parser::NodeKind::IDENTIFIER {
            create_dependency(this, make_ident(parser::identifier_to_str(ident)))
        }
    }
}

export def create_dependency_on_type(this: &Value, node: &parser::Node) {
    if not node { return }
    if node.kind == parser::NodeKind::IDENTIFIER {
        let value = node.svalue
        /*if node.tpe and node.tpe.kind == typechecking::TypeKind::STUB and node.tpe.is_type_argument {
            create_dependency(this, make_ident(node.tpe.name))
            errors::errorn(node, "Unknown type")
        } else */
        if value { create_dependency(this, value) 
        } else { create_dependency(this, make_ident(parser::identifier_to_str(node))) }
    } else if node.kind == parser::NodeKind::PTR_T or 
        node.kind == parser::NodeKind::REF_T or
        node.kind == parser::NodeKind::WEAK_REF_T or
        node.kind == parser::NodeKind::ARRAY_T {
        create_dependency_on_type(this, node.value.t_parr.tpe)
    } else if node.kind == parser::NodeKind::STRUCT_T or
        node.kind == parser::NodeKind::UNION_T {
        for var i in 0..node.value.body.length {
            let iddecl = node.value.body(i)
            if iddecl and iddecl.kind == parser::NodeKind::ID_DECL_STRUCT {
                create_dependency_on_type(this, iddecl.value.id_decl_struct.tpe)
            } else {
                create_dependency_on_type(this, iddecl)
            }
        }
    } else if node.kind == parser::NodeKind::ARRAY_STATIC_T {
        create_dependency_on_type(this, node.value.t_arrs.tpe)
    } else if node.kind == parser::NodeKind::FUNCTION_T or 
        node.kind == parser::NodeKind::CLOSURE_T {
        for var i in 0..node.value.t_func.args.length {
            let arg = node.value.t_func.args(i)
            create_dependency_on_type(this, arg)
        }
        for var i in 0..node.value.t_func.ret.length {
            let ret = node.value.t_func.ret(i)
            create_dependency_on_type(this, ret)
        }
    } else if node.kind == parser::NodeKind::TYPE_CONSTRUCTOR {
        for var i in 0..node.value.type_constructor.args.length {
            let arg = node.value.type_constructor.args(i)
            create_dependency_on_type(this, arg)
        }
    }
    // TODO Structural types
}

export def create_dependency(this: &Value, other: &Value, contents: bool = false) {
    if toolchain::no_dependency_tracking { return }
    if not this or not other { return }
    if this.ident == other.ident { return }

    var oi = other.ident
    if not contents {
        // We ignore the contents
        oi._contents_hash = 0
    }

    if this.dependencies {
        this.dependencies.add(oi)
    }
    if other.dependants {
        other.dependants.add(this.ident)
    }
}

export def create_dependency(this: &Value, other: Ident) {
    if toolchain::no_dependency_tracking { return }
    if not this { return }
    if not this.dependencies or not this.unresolved { return }
    if this.ident == other { return }
    this.unresolved.add(other)
    this.ident.module.unresolved(this.ident) = this
}

def get_scope_count(scope: &Scope) -> int {
    if not scope { return 0 }
    if scope.is_function { return 0 }
    return scope.scope_count
}

export def get_function_parent(scope: &Scope) -> &Scope {
    if scope.is_function { return scope }
    if scope.parent { return get_function_parent(scope.parent) }
    return null
}

export def enter_scope -> &Scope {
    return enter_scope(null !&Scope, null)
}

export def enter_scope(scope: &Scope, module: &toolchain::Module, is_global: bool = false) -> &Scope {
    let parents = vector::make(type weak &Scope)
    parents.push(scope)
    return enter_scope(parents, module, is_global)
}

export def enter_scope(parents: &Vector(weak &Scope), module: &toolchain::Module, is_global: bool = false) -> &Scope {
    let s = [
        module = module,
        parents = parents,
        fields = map::make(type &Value),
        temporaries = map::make(type &Value),
        implicits = vector::make(type &Value),
        underscore_count = 0,
        is_global = is_global,
        impls = vector::make(type &Impl)
    ] !&Scope
    let function_parent = get_function_parent(s)
    if function_parent {
        function_parent.scope_count += 1
        s.scope_count = function_parent.scope_count
    }
    return s
}

export def enter_scope(scope: &Scope) -> &Scope {
    assert scope != null
    return enter_scope(scope, scope.module)
}

export def enter_function_scope(scope: &Scope, module: &toolchain::Module, is_global: bool = false) -> &Scope {
    let parents = vector::make(type weak &Scope)
    parents.push(scope)

    return [
        module = module,
        parents = parents,
        fields = map::make(type &Value),
        temporaries = map::make(type &Value),
        implicits = vector::make(type &Value),
        is_function = true,
        is_global = is_global,
        scope_count = 0,
        impls = vector::make(type &Impl)
    ] !&Scope
}

export def enter_function_scope(scope: &Scope) -> &Scope {
    assert scope != null
    return enter_function_scope(scope, scope.module)
}

export def exit_scope(scope: &Scope) -> &Scope {
    let parent = scope.parent
    return parent
}

export def all_functions(scope: &Scope) -> &Value {
    let keys = scope.fields.keys()
    for var i in 0..keys.size {
        let key = keys(i)
        var value = scope.fields(key)
        if value.kind == ValueKind::FUNCTION {
            while value {
                yield value
                value = value.next
            }
        }
    }
}

export def all_values(scope: &Scope) -> &Value {
    let keys = scope.fields.keys()
    for var i in 0..keys.size {
        let key = keys(i)
        var value = scope.fields(key)
        while value {
            yield value
            value = value.next
        }
    }
}

def find_functions(value: &Value, resolved: &SMap(&Vector(typechecking::FunctionDef)), result: &Vector(typechecking::FunctionDef), template: &typechecking::Type) {
    if not value { return }

    let ftpe = value.get_type().resolve()
    let new_resolved = map::make(typechecking::TypeId)
    if vector::length(ftpe.parameter_t) == vector::length(template.parameter_t) and
        vector::length(ftpe.return_t) == vector::length(template.return_t) {
        var equal = true
        // TODO What about varargs functions?
        for var i in 0..vector::length(ftpe.parameter_t) {
            let left = ftpe.parameter_t(i)
            let right = template.parameter_t(i)
            if not typechecking::equals(left.tpe, right.tpe) {
                equal = false
                break
            }
        }
        if equal {
            for var i in 0..vector::length(ftpe.return_t) {
                let left = ftpe.return_t(i)
                let right = template.return_t(i)
                if not typechecking::equals(left, right) {
                    equal = false
                    break
                }
            }
        }
        if equal {
            result.push(value.fdef)
        }
    }
}

def find_functions(scope: &Scope, name: Str, ret: &Vector(&Value), params: &Vector(typechecking::TypeId) = null, check_export: bool = false) {
    for var key in @scope.fields.keys() {
        var value = scope.fields(key)
        if key == name and value.kind == ValueKind::FUNCTION {
            let value_def = value.fdef
            while value {
                if params {
                    if value_def.parameter_t.length < params.length {
                        continue
                    }
                    var parameter_mismatch = false
                    for var i in 0..params.length {
                        let param = params(i)
                        if not typechecking::is_assignable(value_def.parameter_t(i).tpe.resolve(scope), param, scope) {
                            parameter_mismatch = true
                            break
                        }
                    }
                    if parameter_mismatch { continue }
                }
                ret.push(value)
                value = value.next
            }
        }
    }
    if scope.parents {
        for var parent in scope.parents {
            find_functions(parent, name, ret, params, check_export)
        }
    }
    if scope.imports and not check_export {
        for var i in 0..scope.imports.length {
            let imprt = scope.imports(i)
            find_functions(imprt.module.scope, name, ret, params, check_export = true)

            let scope2 = imprt.module.scope
            if scope2.re_exports {
                for var i in 0..scope2.re_exports.length {
                    let re_export = scope2.re_exports(i)
                    
                    let new_values = vector::make(type &Value)
                    find_functions(re_export.module.scope, name, new_values, params, check_export = true)

                    for var i in 0..new_values.length {
                        let value2 = new_values(i)
                        if pattern_matches(scope, value2.name_node, re_export.pattern) {
                            ret.push(value2)
                        }
                    }
                }
            }
        }
    }
}

export def find_functions(scope: &Scope, name: Str, params: &Vector(typechecking::TypeId) = null) -> &Vector(&Value) {
    let ret = vector::make(type &Value)
    find_functions(scope, name, ret, params)
    return ret
}

// TODO Duplicate code, we want a filter function
def find_functions(scope: &Scope, tpe: &typechecking::Type, ret: &Vector(&Value), found: &SSet, check_export: bool = false) {
    if not scope { return }
    for var key in @scope.fields.keys() {
        var value = scope.fields(key)
        if check_export and not (value.share !int & parser::ShareMarker::EXPORT !int) { continue }
        if value.kind == ValueKind::FUNCTION {
            let value_def = value.fdef
            while value {
                if value_def.parameter_t.length > 0 and
                    typechecking::is_assignable(value_def.parameter_t(0).tpe.resolve(scope), tpe, scope) {
                    if not set::contains(found, value_def.name) {
                        set::add(found, value_def.name)
                        ret.push(value)
                    }
                }
                value = value.next
            }
        }
    }
    if scope.parents {
        for var parent in scope.parents {
            find_functions(parent, tpe, ret, found, check_export)
        }
    }
    if scope.imports and not check_export {
        for var i in 0..scope.imports.length {
            let imprt = scope.imports(i)
            find_functions(imprt.module.scope, tpe, ret, found, check_export = true)

            let scope2 = imprt.module.scope
            if scope2.re_exports {
                for var i in 0..scope2.re_exports.length {
                    let re_export = scope2.re_exports(i)
                    
                    let new_values = vector::make(type &Value)
                    find_functions(re_export.module.scope, tpe, new_values, found, check_export = true)

                    for var i in 0..new_values.length {
                        let value2 = new_values(i)
                        if pattern_matches(scope, value2.name_node, re_export.pattern) {
                            ret.push(value2)
                        }
                    }
                }
            }
        }
    }
}

export def find_functions(scope: &Scope, tpe: &typechecking::Type) -> &Vector(&Value) {
    let ret = vector::make(type &Value)
    let found = set::make()
    find_functions(scope, tpe, ret, found)
    return ret
}

def find_all(scope: &Scope, ret: &Vector(&Value), found: &SSet, check_export: bool = false) {
    if not scope { return }
    for var key in @scope.fields.keys() {
        var value = scope.fields(key)
        if check_export and not (value.share !int & parser::ShareMarker::EXPORT !int) { continue }

        if value.modifier == parser::VarDecl::CONST and value.tpe and
            value.tpe.kind == typechecking::TypeKind::FUNCTION {
            while value {
                if not set::contains(found, value.fdef.name) {
                    set::add(found, value.fdef.name)
                    ret.push(value)
                }
                value = value.next
            }
        } else if not set::contains(found, value.name) {
            set::add(found, value.name)
            ret.push(value)
        }
    }
    if scope.parents {
        for var parent in scope.parents {
            find_all(parent, ret, found, check_export)
        }
    }
    if scope.imports and not check_export {
        for var i in 0..scope.imports.length {
            let imprt = scope.imports(i)
            find_all(imprt.module.scope, ret, found, check_export = true)

            let scope2 = imprt.module.scope
            if scope2.re_exports {
                for var i in 0..scope2.re_exports.length {
                    let re_export = scope2.re_exports(i)
                    
                    let new_values = vector::make(type &Value)
                    find_all(re_export.module.scope, new_values, found, check_export = true)

                    for var i in 0..new_values.length {
                        let value2 = new_values(i)
                        if pattern_matches(scope, value2.name_node, re_export.pattern) {
                            ret.push(value2)
                        }
                    }
                }
            }
        }
    }
}

export def find_all(scope: &Scope, check_export: bool = false) -> &Vector(&Value) {
    let ret = vector::make(type &Value)
    let found = set::make()
    find_all(scope, ret, found, check_export)
    return ret
}

export def find_functions(scope: &Scope, node: &parser::Node, template: &typechecking::Type) -> &Vector(typechecking::FunctionDef), &SMap(&Vector(typechecking::FunctionDef)) {
    assert template.kind == typechecking::TypeKind::FUNCTION

    var resolved = map::make(type &Vector(typechecking::FunctionDef))
    var result = vector::make(typechecking::FunctionDef)
    
    var first_value = get_function(scope, node, template.parameter_t, true)
    find_functions(first_value, resolved, result, template)

    var value = get(scope, node)
    if not value or value.kind != ValueKind::FUNCTION {
        return result, resolved
    }
    while value != null {
        if value != first_value {
            find_functions(value, resolved, result, template)
        }
        value = value.next
    }

    return result, resolved
}

type ValueAndScope = struct {
    value: &Value
    scope: &Scope
}

def find_function(scope: &Scope, node: &parser::Node, v: &Value, parameter_t: &Vector(typechecking::NamedParameter), score: *int, dry_run: bool, context: &Scope) -> bool, &ValueAndScope {
    for var i in 0..vector::length(parameter_t) {
        let np = parameter_t(i)
        if not np.tpe { return false, null }
    }
    
    var generated = false
    if node.value.identifier.types {
        // We disregard the parameters and only look at the identifier
        // The calling function must check the overload score manually
        if not v {
            let generated = generate_function(scope, node, node.value.identifier.types, true)
            if generated != null {
                return true, [ value = generated, scope = scope ] !&ValueAndScope
            }
            return false, null
        }

        if v.kind != ValueKind::FUNCTION { return false, null }

        loop {
            if not v { break }
            

            // Create temporary scope for type lookup
            // TODO Maybe cache it somewhere instead of creating a new one when creating a polymorphic instance
            let parents = vector::make(type weak &Scope)
            parents.push(scope)
            if context.module != scope.module {
                parents.push(context)
            }
            let new_scope = enter_scope(parents, scope.module)
            let s = typechecking::overload_score(v.fdef, node.value.identifier.types, new_scope, true)
            if s == 0 {
                @score = 0
                return true, [ value = v, scope = new_scope ] !&ValueAndScope
            }
            v = v.next
            if not v {
                if generated {
                    break
                } else {
                    if @score != 0 {
                        v = generate_function(scope, node, node.value.identifier.types, true)
                    }
                    generated = true
                }
            }
        }
        return false, null
    }

    if not v {
        let generated = generate_function(scope, node, parameter_t, dry_run)
        if generated != null {
            return true, [ value = generated, scope = context ] !&ValueAndScope
        }
        return false, null
    }

    if v.kind != ValueKind::FUNCTION { return false, null }
    
    var found: &Value = null
    var found_scope: &Scope = null
    var d = false
    loop {
        if not v { break }
        /*if v.node and v.state {
            v.tpe = typechecking::lookup_parameters(v.node, v.state)
        }*/

        // Create temporary scope for type lookup
        // TODO Maybe cache it somewhere instead of creating a new one when creating a polymorphic instance
        let parents = vector::make(type weak &Scope)
        parents.push(scope)
        if context.module != scope.module {
            parents.push(context)
        }
        var new_scope = enter_scope(parents, context.module)
        let s = typechecking::overload_score(v.fdef, parameter_t, new_scope, false)
        /*print("Parameters: ")
        for var i in 0..parameter_t.length {
            let np = parameter_t(i)
            print( np.name, ": ", debug::type_to_str(np.tpe), " ")
        }
        print("\n")
        print_fdef(v.fdef)
        print("\tscore: ", s, "\n")*/
        if s >= 0 {
            if s < @score {
                @score = s
                found = v
                found_scope = new_scope
                d = false
            } else if s == @score {
                d = true
            }
        }
        v = v.next
        if not v {
            if generated {
                break
            } else {
                if @score != 0 {
                    v = generate_function(scope, node, parameter_t, dry_run)
                }
                generated = true
            }
        }   
    }
    //print("\n")
    if d {
        if not dry_run { ambigous_reference(node) }
        return true, null
    }

    if found != null {
        return true, [ value = found, scope = found_scope ] !&ValueAndScope
    }
    return false, null
}

export def find_implicit_function(scope: &Scope, parameter_t: &Vector(typechecking::NamedParameter), ret: &typechecking::Type, force_compile: bool = true, context: &Scope = null) -> &Value {
    if not scope { return null }
    if not context { context = scope }
    assert parameter_t.length == 1

    let first_param = parameter_t(0).tpe.resolve()
    if first_param.kind == typechecking::TypeKind::NULL { return null }
    if first_param.kind == typechecking::TypeKind::REFERENCE and 
        typechecking::equals(first_param.tpe, typechecking::null_) { return null }

    let r = ret // TODO Capture parameters
    def find(scope: &Scope, score: *int, check_export: bool) -> &Value {
        var value: &Value = null
        var d = false
        for var i in 0..scope.implicits.length {
            let v = scope.implicits(i)
            /*if v.node and v.state {
                v.tpe = typechecking::lookup_parameters(v.node, v.state)
            }*/
            assert v.kind == ValueKind::FUNCTION
            let fdef = v.fdef

            if not typechecking::equals(fdef.return_t(0).resolve(scope), r) { continue }
            let s = typechecking::convert_type_score(fdef.parameter_t(0).tpe, first_param, context, impl = false)
            if s == @score {
                d = true
            } else if s >= 0 and s < @score {
                @score = s
                d = false
                value = v
            }
        }
        if d { return null }
        if check_export and value and not (value.share !int & parser::ShareMarker::EXPORT !int) {
            return null
        }
        return value
    }

    var score = MAX_INT32
    var value = find(scope, *score, false)

    if not value and scope.imports {
        for var i in 0..scope.imports.length {
            let imprt = scope.imports(i)
            let scope2 = imprt.module.scope
            let value2 = find(scope2, *score, true)
            if value2 { value = value2 }

            if scope2.re_exports {
                for var i in 0..scope2.re_exports.length {
                    let re_export = scope2.re_exports(i)
                    let value2 = find(re_export.module.scope, *score, false)
                    if value2 and pattern_matches(scope, value2.name_node, re_export.pattern) {
                        if value and value2 !* != value !* {
                            return null
                        } else {
                            value = value2
                        }
                    }
                }
            }
        }
    }

    if not value and scope.parents {
        for var parent in scope.parents {
            value = find_implicit_function(parent, parameter_t, ret, force_compile, context)
            if value { break }
        }
    }

    /*if value {
        print("Found implicit for type ", debug::type_to_str(first_param), ": ", value.fdef.name, "\n")
        print_fdef(value.fdef)
    }*/
    if value and (value.phase == Phase::DEFINED or (consteval::is_static and value.phase == Phase::CACHED)) and value.node and force_compile {
        return typecheck_function(value, parameter_t, context)
    }
    return value
}

export def has_function(scope: &Scope, fdef: typechecking::FunctionDef) -> &Value {
    var value = get(scope, parser::make_identifier(fdef.unmangled), false, false, true)
    if value and value.kind == ValueKind::FUNCTION {
        while value {
            if value.fdef == fdef {
                return value
            }
            value = value.next
        }
    }
    return null
}

export def remove(scope: &Scope, value: &Value) {
    if not value or not scope { return }

    let keys = scope.fields.keys()
    for var i in 0..keys.size {
        let key = keys(i)
        var v = scope.fields(key)
        if v !* == value !* {
            scope.fields.remove(key)
            if v.next {
                scope.fields(key) = v.next
            }
            break
        } else {
            var prev = v
            v = v.next
            while v {
                if v !* == value !* {
                    prev.next = v.next
                    break
                }
                prev = v
                v = v.next
            }
        }
    }

    let index = scope.implicits.index_of(value)
    if index >= 0 {
        scope.implicits.remove(index)
    }
    value.next = null
}

export def generate_function(scope: &Scope, node: &parser::Node, parameter_t: &Vector(typechecking::NamedParameter), dry_run: bool = false) -> &Value {
    if not scope { return null }
    let module = scope.module
    if not module { return null }
    scope = module.scope
    
    let name = last_path_element(node)
    if vector::length(parameter_t) >= 1 {
        var first_parameter = parameter_t(0)
        if not first_parameter.tpe { return null }

        var ftpe = first_parameter.tpe.resolve()
        if is_ref_or_weak(ftpe) and typechecking::is_interface(ftpe.tpe) {
            if is_weak_ref(ftpe) {
                ftpe = reference(ftpe.tpe).resolve() // Convert weak ref to normal ref
            }
            // FIXME Interface logic here
            
            // Switch to strong reference
            // TODO this removes the reference's canonical name but this is needed to only create one function
            // We should really get rid of the string name creating a hash
            //ftpe = reference(ftpe.tpe).resolve()
            
            //let equals = get(toolchain::runtime_.scope, parser::make_identifier("equals"))
            //consteval::compile_function(equals, scope)

            let parameter_t2 = vector::copy(parameter_t)
            vector::remove(parameter_t2, 0)

            let stpe = ftpe.tpe.resolve()
            let module = stpe.defmodule
            if not module { return null}
            let scope = module.scope

            var duplicate = false
            let least_score = std::MAX_INT32 !int
            var found_member: *typechecking::StructuralTypeMember = null
            for var i in 0..vector::length(stpe.members) {
                let member = stpe.members.get(i)
                if member.name != name { continue }

                let score = typechecking::overload_score(
                    typechecking::to_pre(member.parameter_t), vector::make(type &typechecking::TypeRef), 
                    parameter_t2, scope, false, 
                    impl = false, 
                )

                if score < 0 { continue }
                if score < least_score {
                    found_member = member
                    duplicate = false
                } else if score == least_score {
                    duplicate = true
                }
            }

            if duplicate {
                if not dry_run { ambigous_reference(node) }
                return null
            }
            if not found_member { return null }

            let name_node = parser::make_identifier(name)
            let parameter_t3 = typechecking::to_pre(found_member.parameter_t)

            var return_t = vector::make(type &typechecking::TypeRef)
            for var i in 0..found_member.return_t.length {
                var tpe = found_member.return_t(i)
                return_t.push(typechecking::make_type_ref(tpe))
            }

            typechecking::replace_type_defs(parameter_t3, return_t, parameter_t2, scope, replace = false)

            vector::insert(parameter_t3, 0,  [
                name = "__ref",
                tpe = typechecking::make_type_ref(ftpe.id)
            ] !typechecking::NamedParameterPre)
            let fdef = typechecking::function_def(name, parameter_t3, return_t, module)
            let fun = has_function(scope, fdef)
            if fun { return fun }

            // TODO The share is export for now but maybe we want to make sure that it gets the same share as the first argument
            // The problem is that tpe.share doesn't work when you define it like this:
            // export type X = &interface { ... } and tpe.share is a bit of a hack anyway.
            let value = create_function_without_checking(scope, name_node, parser::ShareMarker::EXPORT, fdef)
            value.identifier = name_node
            value.is_generated = true
            value.is_dyn_dispatch = true
            
            module.dyn_dispatch.push(fdef)
            module.dyn_dispatch_consteval.push(fdef)

            return value
        } else if vector::length(parameter_t) == 1 and is_pointer(ftpe) and 
            name == "__destruct__" and typechecking::has_destructor(ftpe.tpe) {
            
            let args = vector::make(typechecking::NamedParameterPre)
            args.push([
                name = "__ptr",
                tpe = typechecking::make_type_ref(ftpe.id)
            ] !typechecking::NamedParameterPre)

            let name_node = parser::make_identifier("__destruct__")
            let fdef = typechecking::function_def("__destruct__", args, vector::make(type &typechecking::TypeRef), context = builtins::builtins_module)
            let fun = has_function(builtins::builtins, fdef)
            if fun { return fun }

            let value = create_function_without_checking(builtins::builtins, name_node, parser::ShareMarker::EXPORT, fdef)
            if module {
                compiler::predeclare_function(fdef, module)
            }
            compiler::destructors.add(fdef)
            value.identifier = name_node
            value.is_generated = true
            return value
        } else if vector::length(parameter_t) == 2 and ftpe.kind == typechecking::TypeKind::POINTER and
            name == "__construct__" and typechecking::has_copy_constructor(ftpe.tpe) {
            let second_parameter = vector::get(parameter_t, 1) !*NamedParameter
            if equals(second_parameter.tpe, ftpe) {
                
                let args = vector::make(typechecking::NamedParameterPre)
                args.push([
                    name = "__copy",
                    tpe = typechecking::make_type_ref(ftpe.id)
                ] !typechecking::NamedParameterPre)
                args.push([
                    name = "__this",
                    tpe = typechecking::make_type_ref(second_parameter.tpe)
                ] !typechecking::NamedParameterPre)

                let name_node = parser::make_identifier("__construct__")
                let fdef = typechecking::function_def("__construct__", args, vector::make(type &typechecking::TypeRef), context = builtins::builtins_module)
                let fun = has_function(builtins::builtins, fdef)
                if fun { return fun }
                
                let value = create_function_without_checking(builtins::builtins, name_node, parser::ShareMarker::EXPORT, fdef)
                if module {
                    compiler::predeclare_function(fdef, module)
                }
                compiler::constructors.add(fdef)
                value.identifier = name_node
                value.is_generated = true
                return value
            }
        }
    }
    return null
}

export def get_underscore(scope: &Scope) -> &Value {
    if scope.underscore { return scope.underscore }
    if scope.parent { return get_underscore(scope.parent) }
    return null
}

export def create_underscore(scope: &Scope, name_node: &parser::Node, tpe: &typechecking::TypeRef) -> &Value {
    while not scope.is_function {
        scope = scope.parent
    }
    let value = [
        kind = ValueKind::VALUE,
        name_node = name_node,
        share = parser::ShareMarker::NONE,
        modifier = parser::VarDecl::VAR,
        tpe = tpe,
        global = scope.is_global,
        phase = Phase::COMPILED,
        name = "_",
        _assembly_name = "_",
        offset = scope.underscore_count,
        previous_underscore = scope.underscore,
        module = scope.module
    ] !&Value
    scope.underscore_count += 1

    scope.underscore = value

    return value
}

export def typecheck_function(value: &Value, parameter_t: &Vector(typechecking::NamedParameter), context: &Scope) -> &Value {
    assert value.kind == ValueKind::FUNCTION
    //let tpe = typechecking::lookup_parameters(value.node, value.state)
    if typechecking::is_polymorph(value.fdef) {
        let scope = enter_scope(context)
        let node = typechecking::walk_Def_with_type_argument(value.node, parameter_t, scope, typechecking::make_state(value.module))
        let new_value = node.value.def_.function.value
        if new_value { new_value.polymorph_original = value }
        return new_value
    } else if value.node {
        value.phase = Phase::INDETERMINATE
        let state = typechecking::make_state(value.module)
        state.context = value.node.scope
        typechecking::walk_Def(value.node, state)
        value.tpe = typechecking::make_type_ref(value.node.tpe)
    }
    return value
}

export def typecheck(value: &Value) {
    if not value.node { return }
    let state = typechecking::make_state(value.module)
    if value.node.kind == parser::NodeKind::DEF {
        assert value.kind == ValueKind::FUNCTION
        //let tpe = typechecking::lookup_parameters(value.node, value.state)
        let fdef = value.fdef
        if not typechecking::is_polymorph(fdef) {
            state.context = value.node.scope
            typechecking::walk_Def(value.node, state)
            //value.phase = Phase::INDETERMINATE
            value.tpe = typechecking::make_type_ref(value.node.tpe)
        }
    } else {
        //value.phase = Phase::INDETERMINATE
        typechecking::walk(value.node.parent, value.node, state)
    }
}

export def get_function_check(
    scope: &Scope, 
    id: &parser::Node, 
    parameter_t: &Vector(typechecking::NamedParameter), 
    dry_run: bool = false, 
    force_compile: bool = true, 
    only_function: bool = false,
    re_exports: bool = true,
    context: &Scope = null,
    path: &Vector(String) = null
) -> bool, &Value {

    var code, value_and_scope = get_function_check_impl(scope, id, parameter_t, dry_run, force_compile, only_function, re_exports, context, path)
    if value_and_scope {
        var value = value_and_scope.value

        if value and consteval::is_static and scope and value.global and scope.module.stage !int < toolchain::Stage::PREPROCESS !int {
            //scope.module.is_dirty = true
            toolchain::reset_and_consteval(scope.module)
            code, value_and_scope = get_function_check_impl(scope.module.scope, id, parameter_t, dry_run, force_compile, only_function, re_exports, context, path)

            if value_and_scope {
                value = value_and_scope.value
            } else {
                return code, null
            }
        }
        
        if value and force_compile and (value.phase == Phase::DEFINED or (consteval::is_static and value.phase == Phase::CACHED)) {
            return code, typecheck_function(value, parameter_t, value_and_scope.scope)
        }
        return code, value
    }
    return code, null
}

// This function does not perform access checks anymore, this needs to be done by the caller.
def get_function_check_impl(
    scope: &Scope, 
    id: &parser::Node, 
    parameter_t: &Vector(typechecking::NamedParameter), 
    dry_run: bool = false, 
    force_compile: bool = true, 
    only_function: bool = false,
    re_exports: bool = true,
    context: &Scope = null,
    path: &Vector(String) = null
) -> bool, &ValueAndScope {

    if not path {
        path = vector::make(String)
    }
    if not context {
        context = scope
    }

    def check_for_re_exports(scope: &Scope, value: &ValueAndScope) -> &ValueAndScope {
        if not scope.re_exports { return value }
        for var i in 0..scope.re_exports.length {
            let re_export = scope.re_exports(i)
            if pattern_matches(scope, id, re_export.pattern) {
                var _, value2 = get_function_check_impl(re_export.module.scope, id, parameter_t, dry_run, force_compile, only_function, false, context, path)
                if value2 and not pattern_matches(scope, id, re_export.pattern, value2.value.fdef.parameter_t) { continue }
                if value2 and value2.value.share !int & parser::ShareMarker::EXPORT !int {
                    if value and value2 and (value.value !*) != (value2.value !*) {
                        if not dry_run {
                            ambigous_reference(id)
                        }
                        return null
                    }
                    value = value2
                }
            }
        }
        return value
    }

    if not scope { return false, null }
    //if id.svalue { return true, id.svalue }
    
    assert((@id).kind == parser::NodeKind::IDENTIFIER)
    if vector::length((@id).value.identifier.path) == 1 {
        let name = (@id).value.identifier.path(0)
        var score = std::MAX_INT32 !int
        var code = false

        // We need to store this to check later that there's no entry by that name
        let first_value = scope.fields.get_or_default(name, null)
        let (code), first_function = find_function(scope, id, first_value, parameter_t, *score, dry_run, context)
        let first_score = score
        var value = first_function
 
        var d = false
        if (@scope).imports {
            for var i in 0..vector::length((@scope).imports) {
                let imprt = (@scope).imports(i)
                let scope2 = imprt.module.scope
                var new_score = std::MAX_INT32 !int
                let code2, new_value = find_function(scope2, id, scope2.fields.get_or_default(name, null), parameter_t, *new_score, dry_run, context)
                if code2 { code = true }
                if new_value and new_value.value.share !int & parser::ShareMarker::EXPORT !int {
                    if score == new_score {
                        d = true 
                    } else if new_score < score {
                        score = new_score
                        value = new_value
                        d = false
                    }
                }
            }
            if first_function and first_score == score {
                // We always return the declaration in the current file
                // if there are multiple ones with the same score
                value = first_function
            } else if d {
                if not dry_run { ambigous_reference(id) }
                return true, null
            }
        }

        // Check for polymorphic instances
        if scope.is_global and (not first_function or typechecking::is_polymorph(first_function.value.fdef)) {
            var root_scope = context.module.scope
            var new_score = std::MAX_INT32

            if root_scope.polymorphics {
                // We need to check the path we took to get here and then see if
                // there is a module under that path
                var poly_value: &Value
                if path.length > 0 {
                    let module_scope = get(root_scope, parser::make_identifier(@path.to_array()))
                    if module_scope and root_scope.polymorphics.contains(module_scope.module.filename) {
                        // If there is a module we can look into the polymorphic instances of that module
                        let poly_scope = root_scope.polymorphics(module_scope.module.filename)
                        if poly_scope {
                            let val = poly_scope.fields.get_or_default(name, null)
                            let new_code, new_value = find_function(poly_scope, id, val, parameter_t, *new_score, true, context)
                            if new_value and new_score == 0 {
                                return new_code, new_value
                            }
                        }
                    }
                } else if first_function and typechecking::is_polymorph(first_function.value.fdef) {
                    if root_scope.polymorphics.contains(first_function.value.module.filename) {
                        // We found the function and we should only look into the polymorphs from this module
                        let poly_scope = root_scope.polymorphics(first_function.value.module.filename)
                        if poly_scope {
                            let val = poly_scope.fields.get_or_default(name, null)
                            let new_code, new_value = find_function(poly_scope, id, val, parameter_t, *new_score, true, context)
                            if new_value and new_score == 0 {
                                return new_code, new_value
                            }
                        }
                    }
                } else {
                    // Otherwise we have a non qualified call, which means we need to look at ALL modules
                    for var module_name in @root_scope.polymorphics.keys() {
                        let poly_scope = root_scope.polymorphics(module_name)
                        if poly_scope {
                            let val = poly_scope.fields.get_or_default(name, null)
                            let new_code, new_value = find_function(poly_scope, id, val, parameter_t, *new_score, dry_run, context)
                            if new_value and new_score < score {
                                return new_code, new_value
                            }
                        }
                    }
                }
            }
        }

        // TODO We need to really check for the score here
        if not value and re_exports {
            if scope.re_exports {
                value = check_for_re_exports(scope, value)
            }
            if scope.imports {
                for var i in 0..scope.imports.length {
                    let scope2 = scope.imports(i).module.scope
                    value = check_for_re_exports(scope2, value)
                }
            }
        }

        if not value and scope.parents and (not first_value or only_function) {
            for var parent in scope.parents {
                code, value = get_function_check_impl(parent, id, parameter_t, dry_run, force_compile, only_function, re_exports, context, path)
                if value { break }
            }
        }
        var share: parser::ShareMarker
        if value {
            share = value.value.share
        }

        // Try to find function based on the first parameter. This is needed for using functions
        // from another module while not being in that module's context. Without this calls like object.hash()
        // don't work because you don't import object's module directly
        if not value and vector::length(parameter_t) > 0 {
            let first_param = parameter_t(0)
            let module = typechecking::get_module(first_param.tpe)
            if first_param.tpe and module and module != scope.module {
                let scope = module.scope
                var new_score = std::MAX_INT32 !int
                let code2, new_value = find_function(scope, id, scope.fields.get_or_default(name, null), parameter_t, *new_score, dry_run, context)
                if code2 { code = true }
                if new_value {
                    value = new_value
                }
            }
        }
       
        if not value and context.module != scope.module and scope.module != builtins::builtins {
            // Get value from context
            let root_scope = context.module.scope
            let val = root_scope.fields.get_or_default(name, null)
            var new_score = std::MAX_INT32
            let new_code, new_value = find_function(root_scope, id, val, parameter_t, *new_score, dry_run, context)
            if new_value {
                code = new_code
                value = new_value
            }
        }
        
        //if value and value.phase == Phase::DEFINED and force_compile {
        //    value = typecheck_function(value, parameter_t, context)
        //}


        return code, value
    } else {
        let head = vector::head_vec((@id).value.identifier.path)
        let tail = vector::tail((@id).value.identifier.path)

        let id_head = parser::copy_node(id)
        (@id_head).value.identifier.path = head
        let id_tail = parser::copy_node(id)
        (@id_tail).value.identifier.path = tail

        path.push((@id).value.identifier.path(0))

        let s = get(scope, id_head)
        if s {
            if not s.get_scope() {
                if not dry_run { errors::errorn(id, "Use of :: on non namespace") }
                return false, null
            }
            let root_scope = scope.module.scope
            let module = s.get_scope().module

            if root_scope.polymorphics and tail.length == 1 {
                let name = last_path_element(id_tail)
                let poly_scope = root_scope.polymorphics.get_or_default(module.filename, null)
                if poly_scope {
                    var score = std::MAX_INT32 !int
                    let v = poly_scope.fields.get_or_default(name, null)
                    let code, value = find_function(poly_scope, id_tail, v, parameter_t, *score, true, context = context)
                    if value and score == 0 {
                        return code, value
                    }
                }
            }

            // TODO this should be able to go on one line
            let code, value = get_function_check_impl(s.get_scope(), id_tail, parameter_t, dry_run, force_compile, only_function, context = context, path = path)
            return code, value
        }

        return false, null
    }
}

export def get_function(
    scope: &Scope, 
    id: &parser::Node, 
    parameter_t: &Vector(typechecking::NamedParameter), 
    dry_run: bool, 
    force_compile: bool = true, 
    only_function: bool = false,
    context: &Scope = null) -> &Value {

    let _, value = get_function_check(scope, id, parameter_t, dry_run, force_compile, only_function, context = context)
    return value
}

export def get_function(scope: &Scope, id: &parser::Node, parameter_t: &Vector(typechecking::NamedParameter)) -> &Value {
    return get_function(scope, id, parameter_t, false)
}

export def get(
    scope: &Scope, 
    id: &parser::Node, 
    force_compile: bool = true, 
    check_export: bool = false, 
    dry_run: bool = false, 
    same_module: bool = false, 
    re_exports: bool = true, 
    context: &Scope = null,
    no_function: bool = false
) -> &Value {

    var value = get_impl(scope, id, force_compile, check_export, dry_run, same_module, re_exports, context, no_function)
    
    if value and consteval::is_static and value.global and scope.module.stage !int < toolchain::Stage::PREPROCESS !int {
        //scope.module.is_dirty = true
        toolchain::reset_and_consteval(scope.module)
        value = get(scope.module.scope, id, force_compile, check_export, dry_run, same_module, re_exports, context, no_function)
    }

    if value and no_function and value.kind == ValueKind::FUNCTION {
        return null
    }

    if value and force_compile and (value.phase == Phase::DEFINED or (consteval::is_static and value.phase == Phase::CACHED)) {
        typecheck(value)
    }

    return value
}

def get_impl(
    scope: &Scope, 
    id: &parser::Node, 
    force_compile: bool = true, 
    check_export: bool = false, 
    dry_run: bool = false, 
    same_module: bool = false, 
    re_exports: bool = true,
    context: &Scope = null,
    no_function: bool = false
) -> &Value {
    
    if not scope { return null }
    if not context { context = scope }

    assert((@id).kind == parser::NodeKind::IDENTIFIER)
    //TODO This optimization screws with incremental compilation
    //if id.svalue { return id.svalue }

    def check_for_re_exports(id: &parser::Node, scope: &Scope, value: &Value) -> &Value {
        if scope.re_exports {
            for var i in 0..scope.re_exports.length {
                let re_export = scope.re_exports(i)
                if pattern_matches(scope, id, re_export.pattern) {
                    var value2 = get(re_export.module.scope, id, force_compile = force_compile, check_export = true, re_exports = false, no_function = no_function)
                    if value2 and value2.share !int & parser::ShareMarker::EXPORT !int {
                        if value and value !* != value2 !* {
                            if not dry_run {
                                ambigous_reference(id)
                            }
                            return null
                        }
                        value = value2
                    }
                }
            }
        }
        return value
    }

    if vector::length((@id).value.identifier.path) == 1 {
        let name = (@id).value.identifier.path(0)
        if name == "_" { 
            return get_underscore(scope) 
        }
        var value = scope.fields.get_or_default(name, null)
        if value { 
            if id.value.identifier.types {
                var score = 0
                let _, value_and_scope = find_function(scope, id, value, id.value.identifier.types, *score, true, context)

                //if value and force_compile and value.phase == Phase::DEFINED {
                //    value = typecheck_function(value, id.value.identifier.types, context)
                //}
                return value_and_scope.value if value_and_scope else null
            } else if value.kind == ValueKind::FUNCTION and id.parent and id.parent.kind == parser::NodeKind::PTR and value.next {
                if not dry_run { ambigous_reference(id) }
                return null
            }
        } else if scope.imports and not same_module and not check_export and not value {
            for var i in 0..vector::length((@scope).imports) {
                let imprt = (@scope).imports(i)
                let scope2 = imprt.module.scope
                var value2 = scope2.fields.get_or_default(name, null)
                
                if value2 and (@value2).share !int & parser::ShareMarker::EXPORT !int {
                    if value {
                        // TODO save location of values to give better error messages
                        if not dry_run { 
                            ambigous_reference(id)
                        }
                        return null
                    }

                    if id.value.identifier.types {
                        var score = 0
                        let _, value_and_scope = find_function(scope, id, value2, id.value.identifier.types, *score, true, context)
                        //if value2 and force_compile and value2.phase == Phase::DEFINED {
                        //    value2 = typecheck_function(value2, id.value.identifier.types, context)
                        //}
                        value2 = value_and_scope.value if value_and_scope else null
                    }
                    value = value2
                }
            }
        }
        
        if name != "__main__" and re_exports {
            if scope.re_exports {
                value = check_for_re_exports(id, scope, value)
            }
            if scope.imports {
                for var i in 0..scope.imports.length {
                    let scope2 = scope.imports(i).module.scope
                    value = check_for_re_exports(id, scope2, value)
                }
            }
        }
       
        if not value and scope.parents {
            for var parent in scope.parents {
                value = get(parent, id, force_compile, check_export, dry_run, same_module, context = context, no_function = no_function)
                if value { break }
            }
        }

        if not value and id.value.identifier.types {
            value = generate_function(scope, id, id.value.identifier.types, dry_run)
        }
        return value
    } else {
        let head = vector::head_vec((@id).value.identifier.path)
        let tail = vector::tail((@id).value.identifier.path)

        let id_head = parser::copy_node(id)
        (@id_head).value.identifier.path = head
        let id_tail = parser::copy_node(id)
        (@id_tail).value.identifier.path = tail

        let s = get(scope, id_head, force_compile, false, dry_run, context = context, no_function = no_function)
        if s {
            if not s.get_scope() {
                if not dry_run { errors::errorn(id, "Use of :: on non namespace") }
                return null
            }
            let value = get(s.get_scope(), id_tail, force_compile, s.imported, dry_run, context = context, no_function = no_function)
            return value
        }
        return null
    }
}

export def get_const_value(scope: &Scope, id: &parser::Node, error_on_fail: bool = true, force_compile: bool = true) -> &Value {
    let value = get(scope, id, force_compile = force_compile)
    if not value {
        if error_on_fail { 
            errors::errorn(id, "Unknown identifier `", parser::identifier_to_str(id), "`") 
        }
        return null
    }
    if value.modifier != parser::VarDecl::CONST and value.modifier != parser::VarDecl::TYPE {
        return null
    }
    return value
}

export def get_type(scope: &Scope, id: &parser::Node, error_on_fail: bool = true, force_compile: bool = true) -> &typechecking::TypeRef {
    let value = get_const_value(scope, id, error_on_fail, force_compile)
    if not value { return null }
    if value.modifier != parser::VarDecl::TYPE {
        return null
    }
    return value.tpe
}
export def get_type_id(scope: &Scope, id: &parser::Node, error_on_fail: bool = true, force_compile: bool = true) -> typechecking::TypeId {
    let tpe = get_type(scope, id, error_on_fail, force_compile)
    if not tpe { return 0 }
    if tpe.tpe and tpe.tpe.kind == typechecking::TypeKind::STUB {
        // If we resolve here again its going to go into an infinite loop
        return tpe.tpe
    }
    if not force_compile { return tpe.tpe }   
    return tpe.resolve(scope, force_compile = force_compile)
}

// This function creates the namespaces for identifiers like 
// namespace::path::foo
// beware, this function can return null
// TODO This was used to create forward declared scopes but now
// it just creates a path for polymorphic functions to go into -> See if 
// there are any issues with that
export def create_path(scope: &Scope, node: &parser::Node) -> &Scope {
    assert((@node).kind == parser::NodeKind::IDENTIFIER)

    let length = vector::length((@node).value.identifier.path)
    for var i in 0..length - 1 {
        let ident = (@node).value.identifier.path(i)
        let scope_v = scope.fields.get_or_default(ident, null)
        if not scope_v {
            let n = parser::copy_node(node)
            let vec = vector::make(String)
            vec.push(ident)
            (@n).value.identifier.path = vec
            let scope2 = enter_scope(scope)
            enter_namespace(scope, scope2, n)
            scope = scope2
        } else {
            if not (@scope_v).get_scope() {
                errors::errorn(node, "Illegal declaration of `", parser::identifier_to_str(node), "`")
                return null
            } else {
                scope = (@scope_v).get_scope()
            }
        }
    }
    return scope
}

// Returns the last element in a path, eg Element for path::Element
// TODO Move this elsewhere
export def last_path_element(node: &parser::Node) -> String {
    assert(node.kind == parser::NodeKind::IDENTIFIER)
    let length = vector::length(node.value.identifier.path)
    return node.value.identifier.path(length - 1)
}

// TODO I don't like this at all
// This overwrites value with the changes from other,
// while preserving some of the contents
def merge(value: &Value, other: &Value) {
    let dependencies = value.dependencies
    let dependants = value.dependants
    let unresolved = value.unresolved
    let dllimport = value.dllimport
    let dllexport = value.dllexport
    let ident = value.ident

    @value = @other
    value.dependencies = dependencies
    value.dependants = dependants
    value.unresolved = unresolved
    value.dllimport = dllimport
    value.dllexport = dllexport
    value.ident._hash = ident._hash
}

export def create_function_without_checking(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    fdef: typechecking::FunctionDef, 
    impl: bool = false
) -> &Value {

    scope = create_path(scope, name_node)
    if not scope { return null }
    let name = last_path_element(name_node)

    let global = scope.is_global

    let v = [
        kind = ValueKind::FUNCTION,
        name_node = name_node,
        share = share,
        modifier = parser::VarDecl::CONST,
        name = name,
        _assembly_name = name,
        impl = impl,
        fdef = fdef,
        phase = Phase::COMPILED,
        global = global,
        ident = make_ident(name, scope.module, 0, 0, fdef.name),
        polymorph = typechecking::is_polymorph(fdef),
        module = scope.module
    ] !&Value

    if global {
        v.unresolved = set::make(Ident)
        v.dependencies = set::make(Ident)
        v.dependants = set::make(Ident)
    }

    var prev = scope.fields.get_or_default(name, null)
    if prev {
        while prev.next {
            prev = prev.next
        }
        prev.next = v
    } else {
        scope.fields(name) = v
    }

    if impl {
        scope.implicits.push(v)
    }

    return v
}

// TODO These following functions grew organically, they are in need of a rewrite

export def create_function(scope: &Scope, name_node: &parser::Node, v: &Value, impl: bool = false) -> &Value {
    if not v { return null }

    let name = last_path_element(name_node)
    let phase = v.phase
    let fdef = v.fdef

    if scope.fields.contains(name) {
        var val = scope.fields(name)
        if val.kind != ValueKind::FUNCTION {
            errors::errorn(name_node, "Redeclaration of `", name, "`")
            return null 
        }
        var next = val
        loop {
            /*if phase == Phase::COMPILED and next.node and next.state {
                next.tpe = typechecking::lookup_parameters(next.node, next.state)
            }*/
            if typechecking::parameter_equals(next.fdef, fdef.parameter_t, scope) {
                //if phase == Phase::DECLARED { return next }
                if phase == Phase::DEFINED and next.phase != Phase::DECLARED {
                    errors::errorn(name_node, "Function `", name, "` was already declared previously (same arguments)")
                    return null
                } else {
                    // Make sure we keep the chain intact
                    // TODO This is quite dodgy but its apparently needed for some reason
                    next.fdef = v.fdef
                    v.next = next.next
                    merge(next, v)
                }
                return next
            }
            if (@next).next {
                next = (@next).next
            } else {
                break
            }
        }
        (@next).next = v
    } else {
        (@scope).fields(name) = v
    }
    if impl {
        scope.implicits.push(v)
    }
    return v
}

def create_function_value(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    phase: Phase, node: &parser::Node, fdef: typechecking::FunctionDef,
    impl: bool) -> &Value {
        
    let name = last_path_element(name_node)
    let global = scope.is_global

    let v = [
        kind = ValueKind::FUNCTION,
        name_node = name_node,
        share = share,
        modifier = parser::VarDecl::CONST,
        name = name,
        _assembly_name = name,
        impl = impl,
        fdef = fdef,
        phase = phase,
        global = global,
        node = node,
        ident = make_ident(name, scope.module, 
            node.signature_hash if node else 0, node.hash if node else 0, fdef.name),
            
        polymorph = typechecking::is_polymorph(fdef),
        references = vector::make(parser::SourceLoc),
        module = scope.module
    ] !&Value

    if global {
        // Remove unresolved symbols
        v.unresolved = set::make(Ident)
        v.dependencies = set::make(Ident)
        v.dependants = set::make(Ident)
    }

    return v
}


// TODO Give better error messages, where was the function/variable declared previously?
export def create_function(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    fdef: typechecking::FunctionDef, phase: Phase, node: &parser::Node, impl: bool = false) -> &Value {

    scope = create_path(scope, name_node)
    if not scope { return null }
    
    let v = create_function_value(scope, name_node, share, phase, node, fdef, impl)

    return create_function(scope, name_node, v, impl)
}

export def create_function(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    fdef: typechecking::FunctionDef, impl: bool = false) -> &Value {
    return create_function(scope, name_node, share, fdef, Phase::COMPILED, null, impl)
}
 
export def create_polymorph(
    scope: &Scope, context: &Scope, name_node: &parser::Node, fdef: typechecking::FunctionDef, 
    phase: Phase, node: &parser::Node, 
    impl: bool = false) -> &Value {
    
    let module = context.module
    scope = scope.module.scope // Global scope
    let module_name = module.filename

    if not scope.polymorphics {
        scope.polymorphics = map::make(type &Scope)
    }
    var poly_scope = scope.polymorphics.get_or_default(module_name, null)
    if not poly_scope {
        poly_scope = enter_scope()
        scope.polymorphics(module_name) = poly_scope
    }

    let v = create_function_value(scope, name_node, parser::ShareMarker::NONE, Phase::COMPILED, node, fdef, impl)
    return create_function(poly_scope, name_node, v, impl)
}

export def create_temporary(scope: &Scope, name: Str, tpe: &typechecking::TypeRef) -> &Value {
    let v = [
        kind = ValueKind::VALUE,
        share = parser::ShareMarker::NONE,
        modifier = parser::VarDecl::VAR,
        name = name,
        _assembly_name = name,
        tpe = tpe,
        global = false,
        phase = Phase::COMPILED,
        module = scope.module
    ] !&Value

    scope.temporaries(name) = v
    return v
}

export def has_variable(scope: &Scope, name_node: &parser::Node) -> bool {
    let name = last_path_element(name_node)
    return scope.fields.contains(name)
}

export def create_variable(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    modifier: parser::VarDecl, tpe: &typechecking::TypeRef, extern: bool, dllimport: bool, dllexport: bool,
    value: &compiler::Value, phase: Phase, node: &parser::Node, state: &typechecking::State, current_function: &compiler::Function = null) -> &Value {
    
    scope = create_path(scope, name_node)
    if not scope { return null }
    let name = last_path_element(name_node)

    let global = scope.is_global
    let v = [
        kind = ValueKind::VALUE,
        name_node = name_node,
        dllimport = dllimport,
        dllexport = dllexport,
        extern = extern,
        share = share,
        modifier = modifier,
        name = name,
        tpe = tpe,
        value = value,
        global = global,
        phase = phase,
        node = node,
        ident = make_ident(name, scope.module, node._hash if node else 0),
        references = vector::make(parser::SourceLoc),
        module = scope.module,
        current_function = current_function
    ] !&Value

    if global {
        v.unresolved = set::make(Ident)
        v.dependencies = set::make(Ident)
        v.dependants = set::make(Ident)
    }

    if extern {
        v._assembly_name = name
    } else if global {
        v._assembly_name = typechecking::append_module(name, (@name_node).loc.module)
    } else {
        v._assembly_name = name
        v.offset = get_scope_count(scope)
    }

    let val = scope.fields.get_or_default(name, null)
    if val {
        if (phase == Phase::DEFINED and val.phase != Phase::DECLARED) or
            (phase == Phase::COMPILED and val.phase == Phase::COMPILED) or
            val.kind != ValueKind::VALUE {

            errors::errorn(name_node, "Redeclaration of `", name, "`")
        } else {
            let old_node = val.node
            merge(val, v)
            if not val.node {
                val.node = old_node
            }
            return val
        }
    } else {
        scope.fields(name) = v
    }

    return v
}

export def create_variable(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    modifier: parser::VarDecl, tpe: &typechecking::TypeRef, extern: bool, value: &compiler::Value, current_function: &compiler::Function = null) -> &Value {
    return create_variable(scope, name_node, share, modifier, tpe, extern, false, false, value, Phase::COMPILED, null, null, current_function)
}

export def create_variable(
    scope: &Scope, name_node: &parser::Node, share: parser::ShareMarker, 
    modifier: parser::VarDecl, tpe: &typechecking::TypeRef, value: &compiler::Value, current_function: &compiler::Function = null) -> &Value {
    return create_variable(scope, name_node, share, modifier, tpe, false, false, false, value, Phase::COMPILED, null, null, current_function)
}

export def create_type(
    scope: &Scope, name_node: &parser::Node, 
    share: parser::ShareMarker, tpe: &typechecking::TypeRef, 
    phase: Phase, node: &parser::Node
) -> &Value {

    scope = create_path(scope, name_node)
    if not scope { return null }
    let name = last_path_element(name_node)
    
    let value = scope.fields.get_or_default(name, null)
    if value {
        if phase == Phase::DEFINED and value.phase != Phase::DECLARED or
            value.kind != ValueKind::TYPE {
            errors::errorn(node, "Redeclaration of `", name, "`")
        } else {
            value.tpe = tpe
            value.phase = phase
            value.node = node
        }
        return value
    }

    let global = scope.is_global
    let v = [
        kind = ValueKind::TYPE,
        name_node = name_node,
        share = share,
        modifier = parser::VarDecl::TYPE,
        name = name,
        _assembly_name = name,
        tpe = tpe,
        global = global,
        phase = phase,
        node = node,
        ident = make_ident(name, scope.module),
        references = vector::make(parser::SourceLoc),
        module = scope.module
    ] !&Value
    if global {
        v.unresolved = set::make(Ident)
        v.dependencies = set::make(Ident)
        v.dependants = set::make(Ident)
    }
    
    scope.fields(name) = v

    return v
}

export def create_type(
    scope: &Scope, name_node: &parser::Node, 
    share: parser::ShareMarker, tpe: &typechecking::TypeRef) -> &Value {
    return create_type(scope, name_node, share, tpe, Phase::COMPILED, null)
}

export def create_impl(
    scope: &Scope, share: parser::ShareMarker, left: &typechecking::TypeRef, right: &typechecking::TypeRef, node: &parser::Node) {

    let impl = [
        share = share,
        module = scope.module,
        left = left,
        right = right,
        node = node
    ] !&Impl

    // We resolve all types conditionally here to make sure
    // that the equality check doesn't fail. If one of the types
    // is a forward declared type, it will be resolved later
    // and the equality check looks at the patterns

    // TODO Should impls be unique? The problem with looking up types here is
    // that they might recursively resolve other stuff and fail because of
    // types that aren't resolvable yet

    /*if left.resolve(scope, error_on_fail = false) { 
        right.resolve(scope, error_on_fail = false)
    }

    for var impl in scope.impls {
        if impl.left.resolve(scope, error_on_fail = false) { 
            impl.right.resolve(scope, error_on_fail = false) 
        }
        if impl.left == left and impl.right == right {
            errors::errorn(node, "Duplicate impl for `", typechecking::generic_to_string(left), "`")
            return
        }
    }*/

    scope.impls.push(impl)
}

def all_impl(scope: &Scope) -> &Vector(&Impl) {
    let vec = vector::make(&Impl)
    all_impl(scope, scope.module, set::make(), vec)
    return vec
}

def all_impl(scope: &Scope, module: &toolchain::Module, visited: &SSet, all: &Vector(&Impl)) {
    if not scope { return}
    if scope.imports  {
        for var imp in scope.imports {
            if visited.contains(module.module) { continue }
            visited.add(module.module)
            all_impl(imp.module.scope, module, visited, all)
        }
    }
    for var parent in scope.parents {
        all_impl(parent, module, visited, all)
    }
    for var impl in scope.impls {
        // Don't include impls from other modules, unless they are exported
        if module != scope.module and not (impl.share !int & parser::ShareMarker::EXPORT !int) {
            continue
        }
        all.push(impl)
    }
}


// This gets called whenever we create new types to
// generate concrete implementations for polymorphic functions so that
// the interface call is able to find them.
// TODO This does end up calling itself recursively, so we need to write a temporary value into the implements set
// to prevent infinite recursion. The problem is that this can yield to false positives.
// To fix this we need to stop recursing somehow-
export def trigger_impl(scope: &Scope, tpe: &typechecking::Type) {
    if is_type(tpe) { return }
    if not tpe or tpe.kind == typechecking::TypeKind::NULL { return }
    if tpe.kind == typechecking::TypeKind::TYPE_CONSTRUCTOR { return }
    if tpe.kind != typechecking::TypeKind::REFERENCE {
        trigger_impl(scope, typechecking::reference(tpe.id))
    }
    
    
    if not tpe.meta.implements {
        tpe.meta.implements = set::make(typechecking::TypeId)
    }

    let impls = all_impl(scope)
    for var impl in impls {
        let temp_scope = enter_scope(scope)
        
        //print("Checking if type ", typechecking::type_to_str(tpe), " implements `", typechecking::generic_to_string(impl.left), "`\n")
        // TODO score of 1 is hardcoded, we need to check if the resulting type is actually the same
        let score = typechecking::convert_type_score(impl.left, tpe, temp_scope, impl = false)
        //print("Score: ", score, "\n")
        //print(typechecking::generic_to_string(impl.left), " -> ", typechecking::type_to_str(tpe), " score: ", score, "\n")
        if score >= 0 and score <= 1 {
            let functions = vector::make(&Value)

            // The type matches, now get the right hand side
            let right = impl.right.copy().resolve(temp_scope, force_compile = true).resolve()
            // We don't give errors in static context
            if not right {
                if not consteval::is_static { 
                    errors::errorn(impl.node, "Couldn't resolve implemented type `", typechecking::generic_to_string(impl.right), "`")
                }
                continue
            }
            if right.meta.implementors and right.meta.implementors.contains(tpe.id) {
                continue
            }
            // Check if we have an interface on the right hand side
            if not (right.kind == typechecking::TypeKind::INTERFACE or
                (right.kind == typechecking::TypeKind::REFERENCE and
                right.tpe and right.tpe.resolve().kind == typechecking::TypeKind::INTERFACE)) {
                    
                errors::errorn(impl.node, "Right hand side of impl must be an interface, got `", debug::type_to_str(right), "`")
                continue
            }

            // Lookup all functions in interface
            if tpe.meta.implements.contains(right.id) {
                continue
            }

            // Add this here to prevent infinite recursion    
            tpe.meta.implements.add(right.id)
            var cnt = typechecking::implements_interface(
                tpe, right, scope, impl.module, functions, 
                error_on_fail = true, node = impl.node
            )

            if not cnt {
                if not consteval::is_static {
                    if not tpe.meta.not_implements {
                        tpe.meta.not_implements = set::make(TypeId)
                    }
                    if tpe.meta.not_implements.contains(right.id) {
                        continue
                    }                    
                    tpe.meta.not_implements.add(right.id)
                }

                tpe.meta.implements.remove(right.id)
                continue
            }

            if not right.meta.implementors {
                right.meta.implementors = map::make(typechecking::TypeId, type &Vector(&Value))
            }
            right.meta.implementors(tpe.id) = functions

            debug::trace("trigger_impl: ", debug::type_to_str(tpe), " implements ", debug::type_to_str(right))
            tpe.meta.implements.add(right.id)
        }
    }
}


export def enter_namespace(scope: &Scope, scope2: &Scope, node: &parser::Node) -> &Value {
    
    scope = create_path(scope, node)
    if not scope { return null }
    let name = last_path_element(node)
    //let tpe = typechecking::make_type(typechecking::TypeKind::NAMESPACE, node)

    let v = [
        kind = ValueKind::NAMESPACE,
        share = parser::ShareMarker::NONE,
        modifier = parser::VarDecl::CONST,
        name = name,
        _assembly_name = name,
        //tpe = tpe,
        _scope = scope2,
        global = scope.is_global,
        module = scope.module
    ] !&Value

    let value = scope.fields.get_or_default(name, null)
    if value and not value.get_scope() {
        errors::errorn(node, "Redeclaration of `", name, "`")
    } else {
        scope.fields(name) = v
    }
    return v
}

export def insert_module(scope: &Scope, alias: &parser::Node, module: &toolchain::Module) -> &Value {
    // Don't import the same module twice
    if scope.imports {
        for var i in 0..vector::length(scope.imports) {
            let module2 = scope.imports(i)
            if module.filename == module2.module.filename { return null }
        }
    }

    let v = enter_namespace(scope, module.scope, alias)
    v.imported = true
    v._module = module.scope
    v._scope = null

    if not scope.imports {
        scope.imports = vector::make(ImportedModule)
    }
    scope.imports.push([
        module = module,
        alias = alias
    ] !ImportedModule)

    return v
}

export def insert_re_export(scope: &Scope, pattern: &parser::Node, module: &toolchain::Module) {
    assert scope != null
    if not scope.re_exports {
        scope.re_exports = vector::make(ReExport)
    }
    scope.re_exports.push([
        module = module,
        pattern = pattern
    ] !ReExport)
}

// TODO How is this used exactly? We also need tests for this
def pattern_matches(scope: &Scope, this: &parser::Node, other: &parser::Node) -> bool {
    if not other { return true }
    // TODO This is going to fail if we add namespaces
    let thisname = last_path_element(this)
    let othername = last_path_element(other)
    if thisname != othername { return false }

    let this_types = this.value.identifier.types
    let other_types = other.value.identifier.types
    if other_types {
        if not this_types { return true }
        if this_types.length != other_types.length { return false }
        for var i in 0..this_types.length {
            if not typechecking::equals(this_types(i).tpe, other_types(i).tpe) {
                return false
            }
        }
    }
    return true
}

def pattern_matches(scope: &Scope, this: &parser::Node, other: &parser::Node, parameter_t: &Vector(typechecking::NamedParameterPre)) -> bool {
    if not pattern_matches(scope, this, other) { return false }
    if not other { return true }

    let other_types = other.value.identifier.types
    if not other_types { return true }

    if other_types.length != parameter_t.length { return false }
    for var i in 0..other_types.length {
        if not typechecking::equals(other_types(i).tpe, parameter_t(i).tpe.resolve(scope)) {
            return false
        }
    }
    return true
}
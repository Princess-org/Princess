import map
import set
import strings

export type Type = &interface {
    let name: StringSlice
    let module: StringSlice
    let id: uint64
    let size: size_t
    let align: size_t
    let implements: &Set(weak Type)
}

export def implements(a: Type, b: Type) -> bool {
    return a.implements.contains(b)
}

export def assignable(a: Type, b: Type) -> bool {
    return a == b // TODO This isn't correct there are more complicated rules to follow
}

export def contains(a: StructT, b: Type) -> bool {
    return false // TODO
}

export def == (a: Type, b: Type) -> bool {
    return a.id == b.id
}
export def != (a: Type, b: Type) -> bool {
    return not (a == b)
}
export def hash(a: Type) -> uint64 {
    return a.id
}

type BaseType = struct {
    name: StringSlice
    module: StringSlice
    id: uint64
    implements: &Set(weak Type)
}

export type TypeT = &struct {
    BaseType
    const size: size_t = 0
    const align: size_t = 0
}
export type TypeT implements Type

export type OpaqueT = &struct {
    BaseType
    const size: size_t = 1
    const align: size_t = 1
}
export type OpaqueT implements Type

export type BoolT = &struct {
    BaseType
    const size: size_t = size_of bool
    const align: size_t = align_of bool
}
export type BoolT implements Type
export type FloatT = &struct {
    BaseType
    size: size_t
    align: size_t
}
export type FloatT implements Type
export type WordT = &struct {
    BaseType
    signed: bool
    size: size_t
    align: size_t
}
export type WordT implements Type
export type CharT = &struct {
    BaseType
    const size: size_t = size_of char
    const align: size_t = align_of char
}
export type CharT implements Type

export type BoxType = struct {
    BaseType
    tpe: weak Type
}

export type PointerT = &struct {
    BoxType
    const size: size_t = size_of *
    const align: size_t = align_of *
}
export type PointerT implements Type
export type ReferenceT = &struct {
    BoxType
    const size: size_t = size_of &
    const align: size_t = align_of &
}
export type ReferenceT implements Type
export type WeakReferenceT = &struct {
    BoxType
    const size: size_t = size_of weak &
    const align: size_t = align_of weak &
}
export type WeakReferenceT implements Type
export type ArrayT = &struct {
    BoxType
    const size: size_t = size_of [*]
    const align: size_t = align_of [*]
}
export type ArrayT implements Type
export type StaticArrayT = &struct {
    BoxType
    size: size_t
    align: size_t
    length: size_t
}
export type StaticArrayT implements Type

type FunctionBase = struct {
    BaseType
    arguments: &[weak Type]
    returns: &[weak Type]
}
export type FunctionT = &struct {
    FunctionBase
    const size: size_t = size_of def ->
    const align: size_t = align_of def ->
}
export type FunctionT implements Type
export type ClosureT = &struct {
    FunctionBase
    const size: size_t = size_of ->
    const align: size_t = align_of ->
}
export type ClosureT implements Type

export type RecordT = struct {
    BaseType
    size: size_t
    align: size_t
    members: &[Field]
}
export type Field = struct {
    name: StringSlice
    offset: size_t
    tpe: weak Type
}
export type StructT = &struct {
    RecordT
}
export type StructT implements Type
export type UnionT = &struct {
    RecordT
}
export type UnionT implements Type

export type EnumValue = struct {
    name: StringSlice
    value: int64
}
export type EnumT = &struct {
    BaseType
    signed: bool
    size: size_t
    align: size_t
    values: &[EnumValue]
}
export type EnumT implements Type

export type Function = struct {
    name: StringSlice
    exported: bool
    module: StringSlice
    arguments: &[weak Type]
    returns: &[weak Type]
}

export type InterfaceT = &struct {
    BaseType
    const size: size_t = 0
    const align: size_t = 0
    functions: &[Function]
    implementors: &Set(weak Type)
}
export type InterfaceT implements Type

export type VariantT = &struct {
    BaseType
    size: size_t
    align: size_t
    variants: &[weak Type]
}
export type VariantT implements Type

export type TupleT = &struct {
    BaseType
    size: size_t
    align: size_t
    elements: &[weak Type]
}
export type TupleT implements Type

export type TypeConstructorT = &struct {
    BaseType
    const size: size_t = 0
    const align: size_t = 0
}
export type TypeConstructorT implements Type

type TypeKind = enum {
    UNSET
    BOOL
    WORD
    FLOAT
    STRUCT
    UNION
    ARRAY
    STATIC_ARRAY
    POINTER
    REFERENCE
    WEAK_REF
    FUNCTION
    CLOSURE
    ENUM
    CHAR
    INTERFACE
    VARIANT
    TUPLE
    TYPE
    OPAQUE
    TYPE_CONSTRUCTOR
}

import vector
import std
import io

import var #extern __reflection_data: uint8
import var #extern __reflection_data_size: size_t
import var #extern __reflection_num_types: size_t
import var #extern __reflection_strings: char

var types: &Map(uint64, Type)

load_types(*__reflection_data, __reflection_data_size, __reflection_num_types, *__reflection_strings)

// Type registry functions 
def load_types(input: *uint8, size: size_t, num: size_t, strings: *char) {

    //printf("==================RESOLVING===================\n".value)

    var data: [uint8]
    data.value = input
    data.size = size
    let fp = io::open_memory_as_file(data, "r")
    defer close(fp)

    if not types {
        types = map::make(uint64, Type)
    }
    let all_types = vector::make(Type)

    var index = 0
    while index < num {
        let kind = fp.read(TypeKind)
        let name = make_slice(strings, fp.read(int))
        let module = make_slice(strings, fp.read(int))
        let id = fp.read(uint64)

        //printf("%d %.*s %.*s %zu\n".value, kind !int, name.count, name.data ++ name.offset, module.count, module.data ++ module.offset, id)
        //print(kind, " ", name, " ", module, " ", id, "\n")
        
        var restpe: Type
        switch kind {
        case TypeKind::BOOL
            restpe = [ name = name, module = module, id = id ] !BoolT
        case TypeKind::WORD
            let size = fp.read(int)
            let align = fp.read(int)
            let signed = fp.read(bool)
            restpe = [ name = name, module = module, id = id, 
                size = size, align = align, signed = signed ] !WordT
        case TypeKind::FLOAT
            let size = fp.read(int)
            let align = fp.read(int)
            restpe = [ name = name, module = module, id = id, 
                size = size, align = align ] !FloatT
        case TypeKind::STRUCT, TypeKind::UNION
            let size = fp.read(int)
            let align = fp.read(int)
            let members = allocate_ref(Field, fp.read(int))
    
            //printf("\tsize: %zu align: %zu members: %zu\n".value, size, align, members.size)
            //print("\tsize: ", size, " align: ", align, " members: ", members.size, "\n")

            for var i in 0..members.size {
                let field = [ name = make_slice(strings, fp.read(int)), offset = fp.read(int) ] !Field
                members(i) = field
                //printf("\tname: %.*s offset: %d\n".value, field.name.count, field.name.data ++ field.name.offset, field.offset)
                //print("\tname: ", field.name, " offset: ", field.offset, "\n")
            }

            if kind == TypeKind::STRUCT {
                restpe = [ name = name, module = module, id = id, 
                    size = size, align = align, members = members ] !StructT
            } else {
                restpe = [ name = name, module = module, id = id, 
                    size = size, align = align, members = members ] !UnionT
            }

        case TypeKind::ARRAY
            restpe = [ name = name, module = module, id = id ] !ArrayT
        case TypeKind::STATIC_ARRAY
            let size = fp.read(size_t)
            let align = fp.read(size_t)
            let length = fp.read(size_t)

            restpe = [ name = name, module = module, id = id, 
                size = size, align = align, length = length ] !StaticArrayT
        case TypeKind::POINTER
            restpe = [ name = name, module = module, id = id ] !PointerT
        case TypeKind::REFERENCE
            restpe = [ name = name, module = module, id = id ] !ReferenceT
        case TypeKind::WEAK_REF
            restpe = [ name = name, module = module, id = id ] !WeakReferenceT
        case TypeKind::FUNCTION, TypeKind::CLOSURE
            let arg_len = fp.read(int)
            let return_len = fp.read(int)
            restpe = [ name = name, module = module, id = id,
                arguments = allocate_ref(type weak Type, arg_len),
                returns = allocate_ref(type weak Type, return_len) ] !FunctionT
        case TypeKind::ENUM
            let size = fp.read(int)
            let align = fp.read(int)
            let signed = fp.read(bool)

            let values = allocate_ref(type EnumValue, fp.read(int))
            for var i in 0..values.size {
                let name = make_slice(strings, fp.read(int))
                let value = fp.read(int64) 
                values(i) = [ 
                    name = name, 
                    value = value
                ] !EnumValue
            }
            restpe = [ name = name, module = module, id = id, 
                size = size, align = align, values = values ] !EnumT
        case TypeKind::CHAR
            restpe = [ name = name, module = module, id = id ] !CharT
        case TypeKind::INTERFACE
            let functions = allocate_ref(type Function, fp.read(int))
            for var i in 0..functions.size {
                let nameid = fp.read(int)
                let arguments_len = fp.read(int)
                let returns_len = fp.read(int)
                functions(i) = [
                    name = make_slice(strings, nameid),
                    exported = true,
                    arguments = allocate_ref(type weak Type, arguments_len),
                    returns = allocate_ref(type weak Type, returns_len)
                ] !Function
            }
            restpe = [ 
                name = name, 
                module = module, 
                id = id, 
                functions = functions, 
                implementors = set::make(type weak Type) 
            ] !InterfaceT
        case TypeKind::VARIANT
            let size = fp.read(int)
            let align = fp.read(int)
            let num = fp.read(int)
            restpe = [ name = name, module = module, id = id,
                size = size, align = align,
                variants = allocate_ref(type weak Type, num)
            ] !VariantT
        case TypeKind::TUPLE
            let size = fp.read(int)
            let align = fp.read(int)
            let num = fp.read(int)
            restpe = [ name = name, module = module, id = id,
                size = size, align = align,
                elements = allocate_ref(type weak Type, num)
            ] !TupleT
        case TypeKind::TYPE
            restpe = [ name = name, module = module, id = id ] !TypeT
        case TypeKind::OPAQUE
            restpe = [ name = name, module = module, id = id ] !OpaqueT
        case TypeKind::TYPE_CONSTRUCTOR
            restpe = [ name = name, module = module, id = id ] !TypeConstructorT
        }

        types(id) = restpe
        all_types.push(restpe)
        index += 1
    }

    //printf("==================REFERENCES===================\n".value)

    // Resolve type references
    for var i in 0..all_types.length() {
        let tpe = all_types(i)
        //printf("Resolving: %.*s\n".value, tpe.name.count, tpe.name.data ++ tpe.name.offset)

        let base = *(tpe !BaseType)

        let nimplements = fp.read(int)
        base.implements = set::make(type weak Type)
        for var j in 0..nimplements {
            let id = fp.read(uint64)
            if id == 0 { continue }
            base.implements.add(type_id(id))
        }

        if tpe.type == StructT {
            let rec = tpe !StructT
            //printf("STRUCT %.*s size: %zu\n".value, rec.name.count, rec.name.data ++ rec.name.offset, rec.members.size)
            for var i in 0..rec.members.size {
                let f = *rec.members(i)
                let id = fp.read(uint64)
                f.tpe = type_id(id)
                //printf("\tname: %.*s offset: %d type_id: %zu\n".value, f.name.count, f.name.data ++ f.name.offset, f.offset, id)
            }
        } else if tpe.type == UnionT {
            //printf("UNION\n".value)
            let rec = tpe !UnionT
            for var i in 0..rec.members.size {
                let f = *rec.members(i)
                f.tpe = type_id(fp.read(uint64))
            }
        } else if tpe.type == InterfaceT {
            let intf = tpe !InterfaceT
            //printf("INTERFACE size: %zu\n".value, intf.functions.size)
            for var i in 0..intf.functions.size {
                let m = *intf.functions(i)
                //printf("\tmember: %.*s args: ".value, m.name.count, m.name.data ++ m.name.offset)
                for var j in 0..m.arguments.size {
                    let id = fp.read(uint64)
                    //printf("%zu ".value, id)
                    m.arguments(j) = type_id(id)
                }
                //printf(" returns: ".value)
                for var j in 0..m.returns.size {
                    let id = fp.read(uint64)
                    //printf("%zu ".value, id)
                    m.returns(j) = type_id(id)
                }
                //printf("\n".value)
            }
        } else if tpe.type == PointerT {
            //printf("POINTER\n".value)
            (tpe !PointerT).tpe = type_id(fp.read(uint64))
        } else if tpe.type == ReferenceT {
            let id = fp.read(uint64)
            //printf("REFERENCE type_id: %zu\n".value, id)
            let ref_tpe = type_id(id)
            let nimpl = fp.read(int)
            if nimpl > 0 {
                //printf("REFERENCE implementors (%d)\n".value, nimpl)
                for var i in 0..nimpl {
                    let id = fp.read(uint64)
                    //printf("\t%zu\n".value, id)
                    (ref_tpe !InterfaceT).implementors.add(type_id(id))
                }
            }
            (tpe !ReferenceT).tpe = ref_tpe
        } else if tpe.type == WeakReferenceT {
            //printf("WEAK REFERENCE\n".value)
            (tpe !WeakReferenceT).tpe = type_id(fp.read(uint64))
        } else if tpe.type == ArrayT {
            //printf("ARRAY\n".value)
            (tpe !ArrayT).tpe = type_id(fp.read(uint64))
        } else if tpe.type == StaticArrayT {
            //printf("STATIC ARRAY\n".value)
            (tpe !StaticArrayT).tpe = type_id(fp.read(uint64))
        } else if (tpe.type == EnumT) {
            ////printf("ENUM\n".value)
            let id = fp.read(uint64)
            // TODO We don't do anything with this?
        } else if (tpe.type == VariantT) {
            //printf("VARIANT\n".value)
            let vnt = tpe !VariantT
            for var i in 0..vnt.variants.size {
                vnt.variants(i) = type_id(fp.read(uint64))
            }
        } else if (tpe.type == TupleT) {
            //printf("TUPLE\n".value)
            let tuple = tpe !TupleT
            for var i in 0..tuple.elements.size {
                tuple.elements(i) = type_id(fp.read(uint64))
            }
        } else if (tpe.type == FunctionT) {
            //printf("FUNCTION\n".value)
            let fun = tpe !FunctionT
            for var i in 0..fun.arguments.size {
                fun.arguments(i) = type_id(fp.read(uint64))
            }
            for var i in 0..fun.returns.size {
                fun.returns(i) = type_id(fp.read(uint64))
            }
        } else if (tpe.type == ClosureT) {
            //printf("CLOSURE\n".value)
            let fun = tpe !ClosureT
            for var i in 0..fun.arguments.size {
                fun.arguments(i) = type_id(fp.read(uint64))
            }
            for var i in 0..fun.returns.size {
                fun.returns(i) = type_id(fp.read(uint64))
            }
        }
    }
}

export def type_id(id: uint64) -> Type {
    if id < 7 { return null } // Internal IDs
    if not types.contains(id) {
        printf("Unknown type id: %zu\n".value, id)
        abort()
    }
    return types(id)
}